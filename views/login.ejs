<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans">

    <div class="flex-grow flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-xl overflow-hidden">
            
            <!-- Header Sekolah -->
            <div class="bg-blue-900 text-white p-6 text-center border-b-4 border-amber-400">
                <div class="w-16 h-16 bg-white text-blue-900 rounded-full flex items-center justify-center mx-auto mb-3 shadow-md text-2xl font-black">
                    <i class="fa-solid fa-school"></i>
                </div>
                <h1 class="text-base font-extrabold tracking-wide uppercase leading-tight">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                <p class="text-xs text-blue-200 mt-1">Sistem Absensi Digital & Gateway WhatsApp</p>
            </div>

            <div class="p-6">
                <% if (error) { %>
                    <div class="mb-4 bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl text-xs flex items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation text-rose-500"></i>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form action="/login" method="POST" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Username / NIP</label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                            <input type="text" name="username" required placeholder="Masukkan Username" 
                                   class="w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 pl-10 pr-4 text-sm text-slate-800 focus:outline-none focus:border-blue-700 focus:bg-white transition">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Password</label>
                        <div class="relative">
                            <i class="fa-solid fa-lock absolute left-3.5 top-3 text-slate-400 text-sm"></i>
                            <input type="password" name="password" required placeholder="Masukkan Password" 
                                   class="w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 pl-10 pr-4 text-sm text-slate-800 focus:outline-none focus:border-blue-700 focus:bg-white transition">
                        </div>
                    </div>

                    <button type="submit" 
                            class="w-full bg-blue-800 hover:bg-blue-900 text-white font-bold py-3 rounded-xl shadow-md transition duration-200 text-sm flex items-center justify-center gap-2">
                        <span>Masuk ke Dashboard</span>
                        <i class="fa-solid fa-right-to-bracket"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer Developer -->
    <footer class="bg-white border-t border-slate-200 py-3 text-slate-600 text-xs">
        <div class="max-w-4xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
            <p class="font-medium">Dikembangkan oleh <span class="font-bold text-blue-900">Zeeo</span></p>
            <div class="flex items-center gap-4 text-slate-500">
                <a href="mailto:vektorzero0@gmail.com" class="hover:text-blue-700"><i class="fa-regular fa-envelope text-blue-800 mr-1"></i>vektorzero0@gmail.com</a>
                <span>|</span>
                <a href="https://wa.me/6282371729760" target="_blank" class="hover:text-emerald-600"><i class="fa-brands fa-whatsapp text-emerald-600 mr-1"></i>082371729760</a>
            </div>
        </div>
    </footer>

</body>
</html>
