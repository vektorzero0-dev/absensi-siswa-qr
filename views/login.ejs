<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Presensi Terpadu - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
        }

        /* BACKGROUND GRADIENT BERTEKSTUR SANGAT ELEGAN */
        .bg-login-gradient {
            background-color: #0f172a;
            background-image: 
                radial-gradient(at 10% 10%, rgba(30, 58, 138, 0.25) 0px, transparent 50%),
                radial-gradient(at 90% 90%, rgba(16, 185, 129, 0.18) 0px, transparent 50%),
                radial-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px);
            background-size: 100% 100%, 100% 100%, 24px 24px;
        }

        /* KARTU LOGIN GLASSMORPHISM */
        .glass-card {
            background: rgba(255, 255, 255, 0.96);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
        }

        /* ANIMASI KARTU MUNCUL LEMBUT */
        @keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(16px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .animate-card {
            animation: cardEnter 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* TRANSISI FOKUS INPUT FORM */
        .input-pro {
            transition: all 0.2s ease-in-out;
        }
        .input-pro:focus {
            background-color: #ffffff;
            border-color: #1e3a8a;
            box-shadow: 0 0 0 4px rgba(30, 58, 138, 0.12);
        }

        /* TOMBOL MEMBAL HALUS */
        .btn-interactive {
            transition: all 0.2s ease-in-out;
        }
        .btn-interactive:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 25px -5px rgba(30, 58, 138, 0.4);
        }
        .btn-interactive:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body class="bg-login-gradient text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased relative overflow-x-hidden">

    <!-- Header Resmi Sekolah -->
    <header class="bg-slate-900/80 backdrop-blur-md text-white border-b border-slate-700/60 sticky top-0 z-20">
        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-gradient-to-tr from-amber-500 to-amber-300 p-2 rounded-xl text-slate-950 shadow-md">
                    <i class="fa-solid fa-graduation-cap text-xl"></i>
                </div>
                <div>
                    <h1 class="text-xs sm:text-sm font-extrabold tracking-wide uppercase text-slate-100">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                    <p class="text-[10px] text-slate-400 font-medium">Sistem Informasi Manajemen Presensi Terpadu Siswa</p>
                </div>
            </div>
            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs bg-slate-800/80 px-3 py-1.5 rounded-full border border-slate-700 text-amber-400 font-semibold shadow-inner">
                <i class="fa-solid fa-shield-halved"></i> Portal Autentikasi
            </span>
        </div>
    </header>

    <!-- Content Utama -->
    <main class="flex-1 flex items-center justify-center p-4 my-6 z-10">
        <div class="w-full max-w-md glass-card rounded-3xl p-7 animate-card relative overflow-hidden">
            
            <!-- ORNAMEN DEKORASI BOLA CAHAYA HALUS -->
            <div class="absolute -top-10 -right-10 w-28 h-28 bg-blue-600/10 rounded-full blur-2xl pointer-events-none"></div>

            <div class="text-center mb-6">
                <div class="inline-flex bg-gradient-to-tr from-blue-900 to-blue-700 text-amber-400 p-3.5 rounded-2xl shadow-lg mb-2.5">
                    <i class="fa-solid fa-user-lock text-2xl"></i>
                </div>
                <h2 class="text-lg font-black text-slate-900 tracking-tight">Masuk Pengguna</h2>
                <p class="text-xs text-slate-500">Silakan masukkan akun resmi tenaga pendidik / administrator Anda.</p>
            </div>

            <% if (error) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs p-3.5 rounded-2xl mb-4 flex items-center gap-2.5 shadow-sm">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 text-base flex-shrink-0"></i>
                    <span class="font-semibold"><%= error %></span>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Nama Pengguna (Username)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                            <i class="fa-solid fa-user text-xs"></i>
                        </span>
                        <input type="text" name="username" required placeholder="Masukkan username" 
                            class="input-pro w-full bg-slate-50/80 border border-slate-300 rounded-xl py-2.5 pl-10 pr-3 text-xs text-slate-900 placeholder-slate-400 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Kata Sandi (Password)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-400">
                            <i class="fa-solid fa-lock text-xs"></i>
                        </span>
                        <input type="password" id="passwordInput" name="password" required placeholder="Masukkan kata sandi" 
                            class="input-pro w-full bg-slate-50/80 border border-slate-300 rounded-xl py-2.5 pl-10 pr-10 text-xs text-slate-900 placeholder-slate-400 focus:outline-none">
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 flex items-center pr-3.5 text-slate-400 hover:text-slate-600 transition focus:outline-none">
                            <i class="fa-solid fa-eye text-xs" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-interactive w-full bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 hover:from-blue-800 hover:to-indigo-800 text-white font-bold text-xs py-3.5 rounded-xl shadow-lg shadow-blue-950/20 mt-2 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket text-amber-400"></i> Autentikasi Masuk
                </button>
            </form>

        </div>
    </main>

    <script>
        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }
    </script>

    <footer class="bg-slate-950/80 border-t border-slate-800/80 py-3 text-center text-[11px] text-slate-400 z-10 backdrop-blur-md">
        <p>© UPTD SD Negeri 1 Karya Mulya Sari. Seluruh Hak Cipta Dilindungi.</p>
        <p class="mt-0.5 text-slate-500">Pengembang Sistem: <strong class="text-slate-300">Zeeo</strong> | Bantuan Teknis (WhatsApp): <a href="https://wa.me/6282371729760" target="_blank" class="text-amber-400 font-medium hover:underline">0823-7172-9760</a></p>
    </footer>

</body>
</html>
