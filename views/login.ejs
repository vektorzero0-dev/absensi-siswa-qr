<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Presensi Terpadu - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- EFEK ANIMASI HALUS & INTERAKTIF PRO -->
    <style>
        /* Animasi Kartu Login Enter */
        @keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(12px) scale(0.98);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .animate-card {
            animation: cardEnter 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Transisi Elevasi Kartu Login */
        .card-pro {
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .card-pro:hover {
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.07), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
        }

        /* Input Form Focus Transition */
        .input-pro {
            transition: all 0.2s ease-in-out;
        }
        .input-pro:focus {
            background-color: #ffffff;
            border-color: #1e3a8a;
            box-shadow: 0 0 0 4px rgba(30, 58, 138, 0.1);
        }

        /* Tombol Interaktif dengan Membal Halus */
        .btn-interactive {
            transition: all 0.2s ease-in-out;
        }
        .btn-interactive:hover {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px -5px rgba(30, 58, 138, 0.3);
        }
        .btn-interactive:active {
            transform: scale(0.98);
        }
        .btn-interactive i {
            transition: transform 0.2s ease;
        }
        .btn-interactive:hover i {
            transform: translateX(3px);
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

    <!-- Header Resmi Sekolah -->
    <header class="bg-blue-900 text-white shadow-md border-b-4 border-blue-600">
        <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-white/10 p-2 rounded-lg border border-white/20">
                    <i class="fa-solid fa-graduation-cap text-2xl text-amber-400"></i>
                </div>
                <div>
                    <h1 class="text-sm md:text-base font-bold tracking-wide uppercase">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                    <p class="text-[11px] text-blue-200">Sistem Informasi Manajemen Presensi Terpadu Siswa</p>
                </div>
            </div>
            <span class="hidden sm:inline-block text-xs bg-blue-950/60 px-3 py-1.5 rounded-full border border-blue-700 text-blue-200 font-medium">
                <i class="fa-solid fa-shield-halved text-amber-400 mr-1"></i> Portal Autentikasi
            </span>
        </div>
    </header>

    <!-- Content Utama -->
    <main class="flex-1 flex items-center justify-center p-4">
        <div class="w-full max-w-md bg-white border border-slate-200/80 rounded-2xl p-6 shadow-xl animate-card card-pro">
            
            <div class="text-center mb-6">
                <div class="inline-flex bg-blue-50 border border-blue-200 p-3 rounded-2xl text-blue-800 mb-2 shadow-sm">
                    <i class="fa-solid fa-user-lock text-2xl"></i>
                </div>
                <h2 class="text-lg font-bold text-slate-900">Masuk Pengguna</h2>
                <p class="text-xs text-slate-500">Silakan masukkan akun resmi tenaga pendidik / administrator Anda.</p>
            </div>

            <% if (error) { %>
                <div class="bg-rose-50 border border-rose-200 text-rose-700 text-xs p-3 rounded-xl mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-circle-exclamation text-rose-500 text-sm"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/login" method="POST" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Pengguna (Username)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-user text-xs"></i>
                        </span>
                        <input type="text" name="username" required placeholder="Masukkan username" 
                            class="input-pro w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 pl-9 pr-3 text-xs text-slate-900 placeholder-slate-400 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Kata Sandi (Password)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                            <i class="fa-solid fa-lock text-xs"></i>
                        </span>
                        <input type="password" id="passwordInput" name="password" required placeholder="Masukkan kata sandi" 
                            class="input-pro w-full bg-slate-50 border border-slate-300 rounded-xl py-2.5 pl-9 pr-10 text-xs text-slate-900 placeholder-slate-400 focus:outline-none">
                        <button type="button" onclick="togglePasswordVisibility()" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 transition focus:outline-none">
                            <i class="fa-solid fa-eye text-xs" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-interactive w-full bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs py-3 rounded-xl shadow-md mt-2 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-right-to-bracket text-amber-400"></i> Autentikasi Masuk
                </button>
            </form>

        </div>
    </main>

    <script>
        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('eyeIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }
    </script>

    <footer class="bg-white border-t border-slate-200 py-3 text-center text-[11px] text-slate-600">
        <p>© UPTD SD Negeri 1 Karya Mulya Sari. Seluruh Hak Cipta Dilindungi.</p>
        <p class="mt-0.5 text-slate-400">Pengembang Sistem: <strong class="text-slate-600">Zeeo</strong> | Bantuan Teknis (WhatsApp): <a href="https://wa.me/6282371729760" target="_blank" class="text-blue-700 font-medium hover:underline">0823-7172-9760</a></p>
    </footer>

</body>
</html>
