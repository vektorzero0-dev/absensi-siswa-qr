<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masa Uji Coba / Langganan Berakhir</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-amber-500/40 rounded-3xl p-6 sm:p-8 max-w-xl w-full text-center shadow-2xl relative overflow-hidden">
        
        <!-- Efek Cahaya Latar -->
        <div class="absolute -top-24 -right-24 w-48 h-48 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="w-16 h-16 bg-amber-500/10 text-amber-400 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl border border-amber-500/30 shadow-inner">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <h1 class="text-base font-extrabold uppercase tracking-wider text-white mb-2">Masa Uji Coba / Langganan Berakhir</h1>
        <p class="text-xs text-slate-400 mb-5 leading-relaxed">
            Masa aktif penggunaan sistem untuk <strong id="namaSekolahText" class="text-white"><%= typeof namaSekolah !== 'undefined' ? namaSekolah : 'Sekolah Anda' %></strong> telah kedaluwarsa. Silakan pilih kategori akun dan paket langganan Anda di bawah ini:
        </p>

        <!-- PILIHAN KATEGORI AKUN -->
        <div class="mb-4 text-left">
            <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wide">1. Pilih Kategori / Jenis Akun:</label>
            <div class="grid grid-cols-3 gap-2">
                <button type="button" onclick="pilihKategori('Wali Kelas', 30000, 300000)" id="btnKatWali" class="kat-btn border border-amber-500/50 bg-amber-500/10 text-white p-2.5 rounded-xl text-xs font-semibold text-center transition">
                    <div class="font-bold text-amber-400">Wali Kelas</div>
                </button>
                <button type="button" onclick="pilihKategori('Petugas', 80000, 800000)" id="btnKatPetugas" class="kat-btn border border-slate-800 bg-slate-950/60 text-slate-400 p-2.5 rounded-xl text-xs font-semibold text-center transition">
                    <div class="font-bold text-white">Petugas</div>
                </button>
                <button type="button" onclick="pilihKategori('Admin', 150000, 1500000)" id="btnKatAdmin" class="kat-btn border border-slate-800 bg-slate-950/60 text-slate-400 p-2.5 rounded-xl text-xs font-semibold text-center transition">
                    <div class="font-bold text-white">Admin</div>
                </button>
            </div>
        </div>

        <!-- PILIHAN DURASI / PAKET -->
        <div class="mb-5 text-left">
            <label class="block text-xs font-bold text-slate-300 mb-2 uppercase tracking-wide">2. Pilih Durasi Langganan:</label>
            <div class="grid grid-cols-2 gap-2">
                <button type="button" onclick="pilihDurasi('Bulanan (1 Bulan)')" id="btnDurasiBulan" class="durasi-btn border border-amber-500/50 bg-amber-500/10 text-white p-3 rounded-xl text-xs font-semibold text-center transition">
                    <div class="font-bold text-amber-400">Bulanan</div>
                    <div id="hargaBulanText" class="text-[11px] text-slate-300 mt-0.5">Rp 30.000 / bln</div>
                </button>
                <button type="button" onclick="pilihDurasi('Tahunan (1 Tahun)')" id="btnDurasiTahun" class="durasi-btn border border-slate-800 bg-slate-950/60 text-slate-400 p-3 rounded-xl text-xs font-semibold text-center transition">
                    <div class="font-bold text-white">Tahunan</div>
                    <div id="hargaTahunText" class="text-[11px] text-slate-400 mt-0.5">Rp 300.000 / thn</div>
                </button>
            </div>
        </div>

        <!-- INFORMASI REKENING & E-WALLET MANUAL -->
        <div class="bg-slate-950/90 p-4 rounded-2xl border border-slate-800 text-left text-xs mb-6 space-y-3 font-mono">
            <div class="text-amber-400 font-sans font-bold tracking-wide border-b border-slate-800 pb-1.5 flex justify-between items-center">
                <span>TUJUAN TRANSFER MANUAL:</span>
                <span id="labelRingkasanPaket" class="text-[10px] bg-amber-500/20 text-amber-300 px-2 py-0.5 rounded">Wali Kelas - Bulanan</span>
            </div>
            
            <div class="space-y-1.5 pt-1">
                <div class="text-[10px] text-slate-500 font-sans font-bold uppercase">TRANSFER BANK:</div>
                <div class="flex justify-between items-center text-slate-300 pl-2 border-l-2 border-emerald-500/40">
                    <span>BRI: <strong class="text-white">1234-01-005678-50-8</strong></span>
                </div>
                <div class="flex justify-between items-center text-slate-300 pl-2 border-l-2 border-emerald-500/40">
                    <span>BNI: <strong class="text-white">0987654321</strong></span>
                </div>
                <div class="flex justify-between items-center text-slate-300 pl-2 border-l-2 border-emerald-500/40">
                    <span>MANDIRI: <strong class="text-white">112-00-9876543-2</strong></span>
                </div>
                <div class="flex justify-between items-center text-slate-300 pl-2 border-l-2 border-emerald-500/40">
                    <span>BSI: <strong class="text-white">7123456789</strong></span>
                </div>
            </div>

            <div class="space-y-1.5 pt-2 border-t border-slate-800/80">
                <div class="text-[10px] text-slate-500 font-sans font-bold uppercase">E-WALLET:</div>
                <div class="grid grid-cols-2 gap-x-4 gap-y-1 pl-2 text-slate-300">
                    <div>OVO / DANA: <strong class="text-white">0823-7172-9760</strong></div>
                    <div>GOPAY / SHOPEEPAY: <strong class="text-white">0823-7172-9760</strong></div>
                </div>
                <div class="text-[11px] text-slate-400 pt-1">Atas Nama: <strong class="text-emerald-400">AHMAD MISBAHUL MUNIR</strong></div>
            </div>
        </div>

        <!-- TOMBOL KONFIRMASI WHATSAPP -->
        <a id="waLink" href="#" target="_blank" 
           class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-3.5 px-4 rounded-xl transition flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/30 mb-3">
            <i class="fa-brands fa-whatsapp text-base"></i> Konfirmasi Pembayaran via WhatsApp
        </a>

        <a href="/logout" class="text-slate-500 hover:text-slate-300 text-[11px] underline transition">
            Keluar dari Akun (Logout)
        </a>
    </div>

    <script>
        let namaSekolahGlobal = document.getElementById('namaSekolahText').innerText.trim();
        
        let kategoriAktif = 'Wali Kelas';
        let hargaBulanAktif = 30000;
        let hargaTahunAktif = 300000;
        let durasiAktif = 'Bulanan (1 Bulan)';
        let nominalAktif = 'Rp 30.000';

        function formatRupiah(angka) {
            return 'Rp ' + angka.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        }

        function pilihKategori(namaKat, hargaBulan, hargaTahun) {
            kategoriAktif = namaKat;
            hargaBulanAktif = hargaBulan;
            hargaTahunAktif = hargaTahun;

            // Update tombol kategori aktif
            document.querySelectorAll('.kat-btn').forEach(btn => {
                btn.classList.remove('border-amber-500/50', 'bg-amber-500/10', 'text-white');
                btn.classList.add('border-slate-800', 'bg-slate-950/60', 'text-slate-400');
            });

            const targetBtn = namaKat === 'Wali Kelas' ? 'btnKatWali' : (namaKat === 'Petugas' ? 'btnKatPetugas' : 'btnKatAdmin');
            const activeBtn = document.getElementById(targetBtn);
            activeBtn.classList.remove('border-slate-800', 'bg-slate-950/60', 'text-slate-400');
            activeBtn.classList.add('border-amber-500/50', 'bg-amber-500/10', 'text-white');

            // Update teks label harga di tombol durasi
            document.getElementById('hargaBulanText').innerText = formatRupiah(hargaBulan) + ' / bln';
            document.getElementById('hargaTahunText').innerText = formatRupiah(hargaTahun) + ' / thn';

            updateKalkulasi();
        }

        function pilihDurasi(namaDurasi) {
            durasiAktif = namaDurasi;

            // Update tombol durasi aktif
            document.querySelectorAll('.durasi-btn').forEach(btn => {
                btn.classList.remove('border-amber-500/50', 'bg-amber-500/10', 'text-white');
                btn.classList.add('border-slate-800', 'bg-slate-950/60', 'text-slate-400');
            });

            const activeBtn = namaDurasi.includes('Bulanan') ? document.getElementById('btnDurasiBulan') : document.getElementById('btnDurasiTahun');
            activeBtn.classList.remove('border-slate-800', 'bg-slate-950/60', 'text-slate-400');
            activeBtn.classList.add('border-amber-500/50', 'bg-amber-500/10', 'text-white');

            updateKalkulasi();
        }

        function updateKalkulasi() {
            let nominalAngka = durasiAktif.includes('Bulanan') ? hargaBulanAktif : hargaTahunAktif;
            nominalAktif = formatRupiah(nominalAngka);

            // Update ringkasan badge
            document.getElementById('labelRingkasanPaket').innerText = `${kategoriAktif} - ${durasiAktif.split(' ')[0]}`;

            // Format pesan WhatsApp yang bersih dari kode mentah
            const pesanWa = `Halo Admin, saya ingin konfirmasi pembayaran langganan untuk sekolah ${namaSekolahGlobal}.\n\n• Kategori Akun: ${kategoriAktif}\n• Paket: ${durasiAktif}\n• Nominal: ${nominalAktif}\n\nBerikut terlampir bukti transfernya ke AHMAD MISBAHUL MUNIR.`;
            
            const encodedMessage = pesanWa
                .replace(/ /g, '%20')
                .replace(/\n/g, '%0A')
                .replace(/\(/g, '%28')
                .replace(/\)/g, '%29');

            document.getElementById('waLink').href = `https://wa.me/6282371729760?text=${encodedMessage}`;
        }

        // Inisialisasi awal saat halaman dibuka
        pilihKategori('Wali Kelas', 30000, 300000);
    </script>
</body>
</html>
