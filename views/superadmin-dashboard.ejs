                    </div>

                </div>

                <!-- KOLOM KANAN (TABEL MONITORING, KENDALI DATA & LANGGANAN) -->
                <div class="col-lg-8">
                    
                    <!-- Tabel Sekolah & Langganan -->
                    <div class="cyber-card mb-4" id="sec-sekolah">
                        <div class="cyber-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fs-6"><i class="bi bi-buildings"></i> DAFTAR SEKOLAH & STATUS LANGGANAN</h5>
                            <span class="badge badge-cyber-success">SUBSCRIPTION CONTROL</span>
                        </div>
                        <div class="card-body p-0 table-responsive">
                            <table class="table table-cyber align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>NAMA SEKOLAH</th>
                                        <th>PAKET / STATUS</th>
                                        <th>BERAKHIR PADA</th>
                                        <th>PENGIRIM WA</th>
                                        <th>STATUS</th>
                                        <th class="text-center">KENDALI & PERPANJANG</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% (typeof sekolahList !== 'undefined' ? sekolahList : []).forEach(s => { %>
                                        <tr class="<%= s.is_active ? '' : 'tr-danger' %>">
                                            <td><strong class="text-primary">#<%= s.id %></strong></td>
                                            <td>
                                                <strong class="text-dark"><%= s.nama_sekolah %></strong>
                                                <% if (!s.is_active) { %>
                                                    <br><small class="text-danger">[DITANGGUHKAN]</small>
                                                <% } %>
                                            </td>
                                            <td>
                                                <div class="mb-1 text-xs text-amber-600 fw-bold"><%= s.paket || 'Uji Coba' %></div>
                                                <% if (s.status_langganan === 'aktif') { %>
                                                    <span class="badge badge-cyber-success">AKTIF</span>
                                                <% } else if (s.status_langganan === 'spesial') { %>
                                                    <span class="badge badge-cyber-yellow">SPESIAL (SELAMANYA)</span>
                                                <% } else { %>
                                                    <span class="badge badge-cyber-danger">EXPIRED</span>
                                                <% } %>
                                            </td>
                                            <td class="font-mono text-muted text-xs"><%= s.status_langganan === 'spesial' ? 'SELAMANYA (TANPA BATAS)' : (s.expired_date || '-') %></td>
                                            
                                            <td>
                                                <form action="/api/sekolah/wa-mode/<%= s.id %>" method="POST">
                                                    <select name="wa_mode" onchange="this.form.submit()" class="form-select form-select-sm form-select-cyber py-1 px-2 text-xs">
                                                        <option value="WALI_KELAS" <%= s.wa_mode === 'WALI_KELAS' ? 'selected' : '' %>>🏫 Wali Kelas</option>
                                                        <option value="PETUGAS" <%= s.wa_mode === 'PETUGAS' ? 'selected' : '' %>>🧑‍✈️ Petugas Absen</option>
                                                        <option value="ADMIN" <%= s.wa_mode === 'ADMIN' ? 'selected' : '' %>>🛡️ Admin Utama</option>
                                                        <option value="TANPA_WA" <%= s.wa_mode === 'TANPA_WA' ? 'selected' : '' %>>🚫 Tanpa WA (Nonaktif)</option>
                                                    </select>
                                                </form>
                                            </td>

                                            <td>
                                                <% if (s.is_active) { %>
                                                    <span class="badge badge-cyber-success">ACTIVE</span>
                                                <% } else { %>
                                                    <span class="badge badge-cyber-danger">DISABLED</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center">
                                                <!-- TOMBOL KENDALI UJI COBA & LANGGANAN -->
                                                <div class="d-flex justify-content-center gap-1 mb-1">
                                                    <button type="button" onclick="aktifkanLangganan('<%= s.id %>', 14, 'trial_14')" class="btn btn-cyber-warning btn-sm" title="Beri Trial 14 Hari">
                                                        +14 Hari
                                                    </button>
                                                    <button type="button" onclick="aktifkanLangganan('<%= s.id %>', 30, 'trial_30')" class="btn btn-cyber-warning btn-sm" title="Beri Trial 30 Hari">
                                                        +30 Hari
                                                    </button>
                                                    <button type="button" onclick="aktifkanLangganan('<%= s.id %>', 0, 'selesai_trial')" class="btn btn-cyber-danger btn-sm" title="Jadikan Expired (Uji Coba Selesai)">
                                                        Selesai Trial
                                                    </button>
                                                </div>
                                                <div class="d-flex justify-content-center gap-1 mb-1">
                                                    <button type="button" onclick="aktifkanLangganan('<%= s.id %>', 30, 'bulan')" class="btn btn-cyber-success btn-sm" title="Perpanjang 1 Bulan">
                                                        <i class="fa-solid fa-check"></i> +1 Bln
                                                    </button>
                                                    <button type="button" onclick="aktifkanLangganan('<%= s.id %>', 365, 'tahun')" class="btn btn-cyber-blue btn-sm" title="Perpanjang 1 Tahun">
                                                        <i class="fa-solid fa-calendar-days"></i> +1 Thn
                                                    </button>

                                                    <a href="/superadmin/switch-sekolah/<%= s.id %>" class="btn btn-cyber-warning btn-sm" title="Kelola Sekolah Ini">
                                                        <i class="bi bi-door-open-fill"></i>
                                                    </a>
                                                </div>
                                                <!-- TOMBOL BASIC SPESIAL (SELAMANYA) -->
                                                <div class="d-flex justify-content-center gap-1 mb-1">
                                                    <button type="button" onclick="setTanpaLangganan('<%= s.id %>')" class="btn btn-outline-primary btn-sm text-xs" style="font-size: 0.7rem;" title="Beri Akses Selamanya Tanpa Kedaluwarsa">
                                                        <i class="fa-solid fa-infinity"></i> Basic Spesial (Selamanya)
                                                    </button>
                                                </div>

                                                <div class="mt-1">
                                                    <button class="btn btn-cyber-primary btn-sm me-1" onclick="lihatSekolah('<%= s.id %>')" title="Intip Detail">
                                                        <i class="bi bi-eye"></i>
                                                    </button>
                                                    <button class="btn btn-cyber-blue btn-sm me-1" onclick="ujiCronSekolah('<%= s.id %>', '<%= s.nama_sekolah %>')" title="Uji Cron Alpa">
                                                        <i class="bi bi-lightning-charge-fill"></i>
                                                    </button>
                                                    <button class="btn btn-cyber-warning btn-sm me-1" onclick="editSekolah('<%= s.id %>', '<%= s.nama_sekolah %>')" title="Edit Nama">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </button>
                                                    
                                                    <form action="/api/sekolah/hapus/<%= s.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus permanen sekolah ini?')">
                                                        <button type="submit" class="btn btn-cyber-danger btn-sm" title="Hapus">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tabel Admin Sekolah -->
                    <div class="cyber-card" id="sec-kredensial">
                        <div class="cyber-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fs-6"><i class="bi bi-shield-lock"></i> KREDENSIAL OPERATOR SEKOLAH</h5>
                        </div>
                        <div class="card-body p-0 table-responsive">
                            <table class="table table-cyber align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>NAMA OPERATOR</th>
                                        <th>USERNAME</th>
                                        <th>SEKOLAH TERHUBUNG</th>
                                        <th class="text-center">AKSI</th>
