                </div>
            </div>
        </div>
    </div>

    <!-- Modal Lihat Detail Sekolah -->
    <div class="modal fade" id="modalLihatSekolah" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-secondary opacity-75">
                    <h5 class="modal-title text-primary edu-font fs-6" id="lihatJudulSekolah">DATABASE INSPECTOR</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
