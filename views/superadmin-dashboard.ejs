                            <label class="form-label">NAMA SEKOLAH RESMI</label>
                            <input type="text" id="editNamaSekolah" name="nama_sekolah" class="form-control" autocomplete="off" required>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary opacity-75">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">BATAL</button>
                        <button type="submit" class="btn btn-cyber-success">SIMPAN</button>
