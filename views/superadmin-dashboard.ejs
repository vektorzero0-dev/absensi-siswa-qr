<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Super Admin Dashboard - SaaS Presensi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-dark bg-primary mb-4">
        <div class="container">
            <span class="navbar-brand mb-0 h1">👑 Super Admin Center</span>
            <div>
                <span class="text-white me-3">Halo, <%= user.nama %></span>
                <a href="/login" class="btn btn-outline-light btn-sm">Keluar</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="row">
            <!-- Form Tambah Sekolah Baru -->
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="card-title mb-0">➕ Pendaftaran Sekolah Baru</h5>
                    </div>
                    <div class="card-body">
                        <form action="/api/sekolah/tambah" method="POST">
                            <div class="mb-3">
                                <label class="form-label">Nama Sekolah Resmi</label>
                                <input type="text" name="nama_sekolah" class="form-control" placeholder="Contoh: SDN 03 Pagardewa" required>
                            </div>
                            <hr>
                            <h6>Akun Admin Sekolah (Operator)</h6>
                            <div class="mb-3">
                                <label class="form-label">Nama Admin</label>
                                <input type="text" name="admin_nama" class="form-control" placeholder="Contoh: Pak Budi (Admin)">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Username Admin</label>
                                <input type="text" name="admin_username" class="form-control" placeholder="admin_sd3" required>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password Admin</label>
                                <div class="input-group">
                                    <input type="password" id="inputPassTambah" name="admin_password" class="form-control" placeholder="******" required>
                                    <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('inputPassTambah', 'iconPassTambah')">
                                        <i id="iconPassTambah" class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-success w-100">Daftarkan Sekolah & Admin</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Daftar Sekolah & Admin Terdaftar -->
            <div class="col-md-8">
                <!-- Tabel Sekolah -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">🏫 Daftar Sekolah Terdaftar</h5>
                        <span class="badge bg-info">Kendali Penuh Akses</span>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nama Sekolah</th>
                                    <th>Pengguna</th>
                                    <th>Rombel</th>
                                    <th>Siswa</th>
                                    <th>Status Akses</th>
                                    <th class="text-center">Aksi Kendali</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% sekolahList.forEach(s => { %>
                                    <tr class="<%= s.is_active ? '' : 'table-danger' %>">
                                        <td><strong>#<%= s.id %></strong></td>
                                        <td>
                                            <strong><%= s.nama_sekolah %></strong>
                                            <% if (!s.is_active) { %>
                                                <br><small class="text-danger"><i>(Akses Ditangguhkan)</i></small>
                                            <% } %>
                                        </td>
                                        <td><%= s.total_pengguna %> Pengguna</td>
                                        <td><%= s.total_kelas %> Rombel</td>
                                        <td><%= s.total_siswa %> Siswa</td>
                                        <td>
                                            <% if (s.is_active) { %>
                                                <span class="badge bg-success">AKTIF</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">NONAKTIF</span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <!-- Tombol Lihat / Intip Detail Sekolah -->
                                            <button class="btn btn-sm btn-info text-white me-1" onclick="lihatSekolah('<%= s.id %>')">
                                                👁️ Lihat
                                            </button>

                                            <!-- Tombol Sakelar Aktif / Nonaktifkan -->
                                            <form action="/api/sekolah/toggle-status/<%= s.id %>" method="POST" class="d-inline">
                                                <% if (s.is_active) { %>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger me-1" onclick="return confirm('Nonaktifkan sekolah ini? Seluruh admin & guru sekolah ini tidak akan bisa login.')">
                                                        🚫 Nonaktifkan
                                                    </button>
                                                <% } else { %>
                                                    <button type="submit" class="btn btn-sm btn-outline-success me-1">
                                                        ✅ Aktifkan Kembali
                                                    </button>
                                                <% } %>
                                            </form>

                                            <button class="btn btn-sm btn-warning me-1" onclick="editSekolah('<%= s.id %>', '<%= s.nama_sekolah %>')">Edit</button>
                                            
                                            <form action="/api/sekolah/hapus/<%= s.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus permanen sekolah ini beserta seluruh data di dalamnya?')">
                                                <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Tabel Admin Sekolah -->
                <div class="card shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="card-title mb-0">👤 Daftar Akun Admin Sekolah</h5>
                    </div>
                    <div class="card-body p-0 table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nama Admin</th>
                                    <th>Username</th>
                                    <th>Sekolah</th>
                                    <th class="text-center">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% adminList.forEach(a => { %>
                                    <tr>
                                        <td><%= a.nama %></td>
                                        <td><code><%= a.username %></code></td>
                                        <td><%= a.nama_sekolah %></td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-warning me-1" onclick="editAdmin('<%= a.id %>', '<%= a.nama %>', '<%= a.username %>')">Edit</button>
                                            <form action="/api/admin/hapus/<%= a.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus akun admin ini?')">
                                                <button type="submit" class="btn btn-sm btn-danger">Hapus</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Lihat / Detail Sekolah -->
    <div class="modal fade" id="modalLihatSekolah" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title" id="lihatJudulSekolah">Detail Data Sekolah</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3" id="detailTab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="pengguna-tab" data-bs-toggle="tab" data-bs-target="#pengguna-panel">👤 Pengguna / Guru</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="rombel-tab" data-bs-toggle="tab" data-bs-target="#rombel-panel">🏫 Rombel</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="siswa-tab" data-bs-toggle="tab" data-bs-target="#siswa-panel">🎓 Siswa</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="detailTabContent">
                        <div class="tab-pane fade show active" id="pengguna-panel">
                            <ul class="list-group" id="listPengguna"></ul>
                        </div>
                        <div class="tab-pane fade" id="rombel-panel">
                            <ul class="list-group" id="listRombel"></ul>
                        </div>
                        <div class="tab-pane fade" id="siswa-panel">
                            <ul class="list-group" id="listSiswa" style="max-height: 300px; overflow-y: auto;"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Edit Sekolah -->
    <div class="modal fade" id="modalSekolah" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formEditSekolah" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Nama Sekolah</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nama Sekolah Resmi</label>
                            <input type="text" id="editNamaSekolah" name="nama_sekolah" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Edit Admin -->
    <div class="modal fade" id="modalAdmin" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formEditAdmin" method="POST">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Akun Admin Sekolah</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nama Admin</label>
                            <input type="text" id="editNamaAdmin" name="nama" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Username</label>
                            <input type="text" id="editUsernameAdmin" name="username" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password Baru *(kosongkan jika tidak diganti)*</label>
                            <div class="input-group">
                                <input type="password" id="inputPassEdit" name="password" class="form-control" placeholder="Password baru">
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword('inputPassEdit', 'iconPassEdit')">
                                    <i id="iconPassEdit" class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                        <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const modalSekolahBs = new bootstrap.Modal(document.getElementById('modalSekolah'));
        const modalAdminBs = new bootstrap.Modal(document.getElementById('modalAdmin'));
        const modalLihatBs = new bootstrap.Modal(document.getElementById('modalLihatSekolah'));

        // Fungsi intip/lihat detail sekolah
        async function lihatSekolah(id) {
            try {
                const res = await fetch('/api/sekolah/detail/' + id);
                const data = await res.json();
                if (!data.success) return alert(data.message);

                document.getElementById('lihatJudulSekolah').innerText = '🏫 Detail Data: ' + data.namaSekolah;

                // Render Pengguna
                const listP = document.getElementById('listPengguna');
                listP.innerHTML = data.penggunaList.length ? data.penggunaList.map(p => 
                    `<li class="list-group-item d-flex justify-content-between align-items-center">
                        <div><strong>${p.nama}</strong> (${p.username})</div>
                        <span class="badge bg-primary rounded-pill">${p.role} - ${p.nama_kelas}</span>
                    </li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada pengguna</li>';

                // Render Rombel
                const listR = document.getElementById('listRombel');
                listR.innerHTML = data.kelasList.length ? data.kelasList.map(k => 
                    `<li class="list-group-item">📌 Kelas / Rombel: <strong>${k.nama_kelas}</strong></li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada rombel</li>';

                // Render Siswa
                const listS = document.getElementById('listSiswa');
                listS.innerHTML = data.siswaList.length ? data.siswaList.map(s => 
                    `<li class="list-group-item d-flex justify-content-between align-items-center">
                        ${s.nama} <span class="badge bg-secondary">${s.nama_kelas}</span>
                    </li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada siswa</li>';

                modalLihatBs.show();
            } catch (err) {
                alert('Gagal mengambil detail sekolah');
            }
        }

        function editSekolah(id, nama) {
            document.getElementById('editNamaSekolah').value = nama;
            document.getElementById('formEditSekolah').action = '/api/sekolah/edit/' + id;
            modalSekolahBs.show();
        }

        function editAdmin(id, nama, username) {
            document.getElementById('editNamaAdmin').value = nama;
            document.getElementById('editUsernameAdmin').value = username;
            document.getElementById('formEditAdmin').action = '/api/admin/edit/' + id;
            modalAdminBs.show();
        }

        // Fungsi Toggle Intip Password (Lihat / Sembunyikan)
        function togglePassword(inputId, iconId) {
            const passInput = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
