    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle Sidebar Mobile
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        const modalSekolahBs = new bootstrap.Modal(document.getElementById('modalSekolah'));
        const modalAdminBs = new bootstrap.Modal(document.getElementById('modalAdmin'));
        const modalLihatBs = new bootstrap.Modal(document.getElementById('modalLihatSekolah'));

        // FUNGSI AKTIFKAN / ATUR TRIAL & LANGGANAN KLIEN
        function aktifkanLangganan(sekolahId, jumlahHari, actionType) {
            let pesanKonfirmasi = `Atur masa aktif sekolah ini selama ${jumlahHari} hari?`;
            if (actionType === 'selesai_trial') {
                pesanKonfirmasi = `Uji Coba Selesai?\n\nTindakan ini akan langsung menghentikan trial sekolah dan menguncinya ke halaman tagihan pembayaran.`;
            }

            if (!confirm(pesanKonfirmasi)) return;

            fetch('/api/admin/perpanjang-langganan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sekolahId, jumlahHari, actionType })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan sistem'));
                }
            })
            .catch(err => {
                console.error('Error Langganan:', err);
                alert('Gagal terhubung ke server!');
            });
        }

        // FUNGSI ATUR STATUS BASIC SPESIAL (SELAMANYA)
        function setTanpaLangganan(sekolahId) {
            if (!confirm("Ubah status sekolah ini menjadi Basic Spesial (Tanpa Batas Waktu / Selamanya)?")) return;

            fetch('/api/admin/set-spesial', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sekolahId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan sistem'));
                }
            })
            .catch(err => {
                console.error('Error Spesial:', err);
                alert('Gagal terhubung ke server!');
            });
        }

        // Handler Import Rekap Absensi Bulanan Per Sekolah (Menggunakan XHR untuk progress nyata & transparan)
        function handleImportRekap(e) {
            e.preventDefault();
            const sekolahId = document.getElementById('importSekolahId').value;
            const bulanTarget = document.getElementById('importBulanTarget').value;
            const fileInput = document.getElementById('importFileExcel');
            const btnSubmit = document.getElementById('btnSubmitImport');
            
            // Elemen Progres & Terminal
            const container = document.getElementById('importProgressContainer');
            const progressBar = document.getElementById('importProgressBar');
            const percentText = document.getElementById('importPercentText');
            const statusText = document.getElementById('importStatusText');
            const logTerminal = document.getElementById('importLogTerminal');

            if (!sekolahId || !bulanTarget || !fileInput.files.length) {
                return alert('Pilih sekolah, bulan target, dan berkas excel rekap terlebih dahulu!');
            }

            if (!confirm(`Import rekap absensi untuk bulan ${bulanTarget}? Data absensi lama di bulan tersebut untuk sekolah ini akan diperbarui/disesuaikan.`)) return;

            // Tampilkan panel transparan & kunci tombol
            container.classList.remove('d-none');
            btnSubmit.disabled = true;
            
            const fileName = fileInput.files[0].name;
            logTerminal.innerText = `[INFO] Menginisialisasi payload berkas: ${fileName}\n[INFO] Membuka koneksi stream ke server...`;
            progressBar.style.width = '5%';
            percentText.innerText = '5%';
            statusText.innerHTML = '<i class="bi bi-arrow-repeat fa-spin text-warning"></i> MENGIRIM BERKAS...';

            const formData = new FormData();
            formData.append('sekolah_id', sekolahId);
            formData.append('bulan_target', bulanTarget);
            formData.append('file_excel', fileInput.files[0]);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/api/super-admin/import-rekap-sekolah', true);

            // Pantau progres unggah (upload) secara real-time
            xhr.upload.onprogress = function (event) {
                if (event.lengthComputable) {
                    const percentComplete = Math.round((event.loaded / event.total) * 90);
                    progressBar.style.width = percentComplete + '%';
                    percentText.innerText = percentComplete + '%';
                    statusText.innerHTML = `<i class="bi bi-arrow-repeat fa-spin text-warning"></i> MENGIRIM (${percentComplete}%)...`;
                    logTerminal.innerText = `[UPLOAD] Mengirim data: ${event.loaded} dari ${event.total} bytes (${percentComplete}%)`;
                }
            };

            xhr.onloadstart = function () {
                logTerminal.innerText += `\n[SERVER] Berkas diterima, memulai parsing data dan pembaruan database...`;
                progressBar.style.width = '95%';
                percentText.innerText = '95%';
                statusText.innerHTML = '<i class="bi bi-gear-fill fa-spin text-primary"></i> MEMPROSES DI SERVER...';
            };

            xhr.onload = function () {
                btnSubmit.disabled = false;
                try {
                    const data = JSON.parse(xhr.responseText);
                    if (xhr.status >= 200 && xhr.status < 300 && data.success) {
                        progressBar.style.width = '100%';
                        percentText.innerText = '100%';
                        statusText.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> SELESAI';
                        logTerminal.innerText += `\n[SUCCESS] ${data.message}`;
                        setTimeout(() => {
                            alert(data.message);
                            window.location.reload();
                        }, 800);
                    } else {
                        progressBar.classList.remove('bg-success');
                        progressBar.classList.add('bg-danger');
                        statusText.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i> GAGAL';
                        logTerminal.innerText += `\n[ERROR] ${data.message || 'Gagal diproses server'}`;
                        alert('Gagal: ' + (data.message || 'Terjadi kesalahan sistem'));
                    }
                } catch (err) {
                    progressBar.classList.remove('bg-success');
                    progressBar.classList.add('bg-danger');
                    statusText.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i> ERROR';
                    logTerminal.innerText += `\n[PARSER_ERROR] Gagal memparsing respons JSON dari server.`;
                    alert('Terjadi kesalahan format respons dari server.');
                }
            };

            xhr.onerror = function () {
                btnSubmit.disabled = false;
                progressBar.classList.remove('bg-success');
                progressBar.classList.add('bg-danger');
                statusText.innerHTML = '<i class="bi bi-x-circle-fill text-danger"></i> KONEKSI PUTUS';
                logTerminal.innerText += `\n[EXCEPTION] Koneksi jaringan terputus atau server tidak merespons.`;
                alert('Gagal terhubung ke server! Periksa koneksi Anda.');
            };

            xhr.send(formData);
        }

        // Sakelar Maintenance Mode
        function setMaintenance(status) {
            const isEnable = String(status) === 'true';
            const pesan = isEnable 
                ? 'Apakah Anda yakin ingin MENGAKTIFKAN mode maintenance?\n\nSemua pengguna (Admin Sekolah, Petugas, Wali Kelas) akan diblokir dari sistem.' 
                : 'Apakah Anda yakin ingin MEMATIKAN mode maintenance?\n\nAplikasi akan kembali berjalan normal.';

            if (!confirm(pesan)) return;

            const urlParams = new URLSearchParams(window.location.search);
            const userId = urlParams.get('userId') || '<%= currentUserId %>';

            fetch('/api/settings/maintenance' + (userId ? '?userId=' + userId : ''), {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ active: isEnable ? 'true' : 'false' })
            })
            .then(async (res) => {
                const data = await res.json();
                if (res.ok && data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan sistem'));
                }
            })
            .catch(err => {
                console.error('Error Maintenance:', err);
                alert('Gagal terhubung ke server! Periksa koneksi internet Anda.');
            });
        }

        // Handler Restore JSON System Data
        function handleRestore(e) {
            e.preventDefault();
            const fileInput = document.getElementById('fileBackupInput');
            if (!fileInput.files.length) return alert('Pilih berkas JSON backup terlebih dahulu!');

            if (!confirm('Apakah Anda yakin ingin memulihkan data dari berkas backup ini? Data yang cocok akan diperbarui secara otomatis.')) return;

            const formData = new FormData();
            formData.append('file_backup', fileInput.files[0]);
            formData.append('userId', '<%= currentUserId %>');

            fetch('/api/backup/restore', {
                method: 'POST',
                body: formData
            })
            .then(async (res) => {
                const data = await res.json();
                alert(data.message);
                if (data.success) window.location.reload();
            })
            .catch(err => {
                console.error('Error Restore:', err);
                alert('Gagal memproses berkas backup! Pastikan format file sesuai.');
            });
        }

        // Fungsi Uji Cron Alpa Per Sekolah
        async function ujiCronSekolah(sekolahId, namaSekolah) {
            if (!confirm(`Jalankan uji cron alpa untuk sekolah "${namaSekolah}"?`)) return;

            try {
                const res = await fetch(`/api/cron/auto-alpa?sekolah_id=${sekolahId}`);
                const data = await res.json();
                if (res.ok && data.success) {
                    alert(data.message);
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan'));
                }
            } catch (err) {
                console.error('Error Uji Cron:', err);
                alert('Gagal terhubung ke server!');
            }
        }

        async function lihatSekolah(id) {
            try {
                const res = await fetch('/api/sekolah/detail/' + id);
                const data = await res.json();
                if (!data.success) return alert(data.message);

                document.getElementById('lihatJudulSekolah').innerText = 'INSPECTION // ' + data.namaSekolah;

                const listP = document.getElementById('listPengguna');
                listP.innerHTML = data.penggunaList.length ? data.penggunaList.map(p => 
                    `<li class="list-group-item d-flex justify-content-between align-items-center">
                        <div><strong class="text-primary">${p.nama}</strong> (${p.username})</div>
                        <span class="badge badge-cyber-success">${p.role} - ${p.nama_kelas}</span>
                    </li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada pengguna</li>';

                const listR = document.getElementById('listRombel');
                listR.innerHTML = data.kelasList.length ? data.kelasList.map(k => 
                    `<li class="list-group-item text-primary">CLASS NODE: <strong>${k.nama_kelas}</strong></li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada rombel</li>';

                const listS = document.getElementById('listSiswa');
                listS.innerHTML = data.siswaList.length ? data.siswaList.map(s => 
                    `<li class="list-group-item d-flex justify-content-between align-items-center">
                        ${s.nama} <span class="badge badge-cyber-success">${s.nama_kelas}</span>
                    </li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada siswa</li>';

                modalLihatBs.show();
            } catch (err) {
                alert('Gagal mengambil detail data dari server.');
            }
        }

        function editSekolah(id, nama) {
            document.getElementById('editNamaSekolah').value = nama;
            document.getElementById('formEditSekolah').action = '/api/sekolah/edit/' + id;
            modalSekolahBs.show();
        }

        function editAdmin(id, nama, username) {
            document.getElementById('editNamaAdmin').value = nama;
            document.getElementById('editUsernameAdmin').value = username;
            document.getElementById('formEditAdmin').action = '/api/admin/edit/' + id;
            modalAdminBs.show();
        }

        function togglePassword(inputId, iconId) {
            const passInput = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
</body>
</html>
