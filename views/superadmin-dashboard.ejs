                                            <td><code class="text-primary"><%= a.username %></code></td>
                                            <td><%= a.nama_sekolah %></td>
                                            <td class="text-center">
                                                <button class="btn btn-cyber-warning btn-sm me-1" onclick="editAdmin('<%= a.id %>', '<%= a.nama %>', '<%= a.username %>')">
                                                    <i class="bi bi-pencil"></i> EDIT
                                                </button>
                                                <form action="/api/admin/hapus/<%= a.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus akun admin ini?')">
