<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Super Admin Control Center</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts: Orbitron & Share Tech Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">

    <style>
        :root {
            --cyber-bg: #030a0e;
            --cyber-card: rgba(10, 25, 35, 0.85);
            --neon-cyan: #00f3ff;
            --neon-yellow: #ffb700;
            --neon-green: #00ff66;
            --neon-red: #ff0055;
            --neon-blue: #0088ff;
            --border-glow: rgba(0, 243, 255, 0.3);
            --text-glow-cyan: 0 0 8px rgba(0, 243, 255, 0.6);
            --text-glow-yellow: 0 0 8px rgba(255, 183, 0, 0.6);
            --sidebar-width: 250px;
        }

        body {
            background-color: var(--cyber-bg);
            color: #d1f4ff;
            font-family: 'Share Tech Mono', monospace;
            overflow-x: hidden;
            position: relative;
        }

        #matrixCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: -1;
            opacity: 0.18;
            pointer-events: none;
        }

        h1, h2, h3, h4, h5, .cyber-font {
            font-family: 'Orbitron', sans-serif;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        /* ----- SIDEBAR STYLING ----- */
        .sidebar {
            width: var(--sidebar-width);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: rgba(3, 15, 22, 0.95);
            border-right: 2px solid var(--neon-cyan);
            box-shadow: 5px 0 15px rgba(0, 243, 255, 0.2);
            backdrop-filter: blur(10px);
            z-index: 1000;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 20px 15px;
            border-bottom: 1px solid var(--border-glow);
            color: var(--neon-cyan);
            text-shadow: var(--text-glow-cyan);
            font-size: 1.1rem;
        }

        .sidebar-menu {
            padding: 15px 10px;
            flex-grow: 1;
        }

        .sidebar-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            color: #a2d2e2;
            text-decoration: none;
            border-radius: 6px;
            margin-bottom: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            border: 1px solid transparent;
            transition: all 0.2s ease;
        }

        .sidebar-item i {
            font-size: 1.1rem;
            margin-right: 12px;
            color: var(--neon-cyan);
        }

        .sidebar-item:hover, .sidebar-item.active {
            background: rgba(0, 243, 255, 0.1);
            border-color: var(--neon-cyan);
            color: #fff;
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
        }

        .sidebar-footer {
            padding: 15px;
            border-top: 1px solid var(--border-glow);
        }

        /* ----- MAIN CONTENT WRAPPER ----- */
        .main-content {
            margin-left: var(--sidebar-width);
            padding: 20px;
            transition: all 0.3s ease;
        }

        .navbar-cyber {
            background: rgba(3, 15, 22, 0.85);
            border: 1px solid var(--border-glow);
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);
            backdrop-filter: blur(8px);
        }

        .cyber-card {
            background: var(--cyber-card);
            border: 1px solid var(--border-glow);
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.8), inset 0 0 10px rgba(0, 243, 255, 0.05);
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
        }

        .cyber-card:hover {
            border-color: var(--neon-cyan);
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.25);
        }

        .cyber-header {
            background: rgba(0, 243, 255, 0.08);
            border-bottom: 1px solid var(--border-glow);
            padding: 12px 20px;
            color: var(--neon-cyan);
            text-shadow: var(--text-glow-cyan);
        }

        .cyber-header-green {
            background: rgba(0, 255, 102, 0.08);
            border-bottom: 1px solid rgba(0, 255, 102, 0.3);
            color: var(--neon-green);
        }

        .cyber-header-blue {
            background: rgba(0, 136, 255, 0.08);
            border-bottom: 1px solid rgba(0, 136, 255, 0.3);
            color: var(--neon-blue);
        }

        /* ----- FORM INPUT SERAGAM ----- */
        .form-label {
            color: var(--neon-cyan) !important;
            font-size: 0.75rem;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .form-control, .form-select-cyber, .input-group-text {
            background-color: rgba(5, 18, 26, 0.8) !important;
            border: 1px solid var(--border-glow) !important;
            color: var(--neon-cyan) !important;
            font-family: 'Share Tech Mono', monospace;
            font-size: 14px;
            border-radius: 6px;
        }

        /* Sentuhan aksen Kuning Glow saat fokus input */
        .form-control:focus, .form-select-cyber:focus {
            box-shadow: 0 0 12px rgba(255, 183, 0, 0.6) !important;
            border-color: var(--neon-yellow) !important;
            color: #fff8d1 !important;
        }

        .form-control::placeholder {
            color: rgba(0, 243, 255, 0.35);
        }

        /* Buttons Cyber & Aksen Kuning Glow */
        .btn-cyber-primary {
            background: transparent;
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            transition: all 0.2s ease;
        }
        .btn-cyber-primary:hover {
            background: var(--neon-cyan);
            color: #000;
            box-shadow: 0 0 15px var(--neon-cyan);
        }

        .btn-cyber-warning {
            background: transparent;
            border: 1px solid var(--neon-yellow);
            color: var(--neon-yellow);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            transition: all 0.2s ease;
        }
        .btn-cyber-warning:hover {
            background: var(--neon-yellow);
            color: #000;
            box-shadow: 0 0 15px var(--neon-yellow);
        }

        .btn-cyber-blue {
            background: transparent;
            border: 1px solid var(--neon-blue);
            color: var(--neon-blue);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            transition: all 0.2s ease;
        }
        .btn-cyber-blue:hover {
            background: var(--neon-blue);
            color: #fff;
            box-shadow: 0 0 15px var(--neon-blue);
        }

        .btn-cyber-success {
            background: transparent;
            border: 1px solid var(--neon-green);
            color: var(--neon-green);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
        }
        .btn-cyber-success:hover {
            background: var(--neon-green);
            color: #000;
            box-shadow: 0 0 15px var(--neon-green);
        }

        .btn-cyber-danger {
            background: transparent;
            border: 1px solid var(--neon-red);
            color: var(--neon-red);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
        }
        .btn-cyber-danger:hover {
            background: var(--neon-red);
            color: #fff;
            box-shadow: 0 0 15px var(--neon-red);
        }

        /* Tables */
        .table-cyber {
            color: #d1f4ff;
            background: transparent;
        }

        .table-cyber th {
            background: rgba(0, 243, 255, 0.1);
            color: var(--neon-cyan);
            border-bottom: 2px solid var(--neon-cyan);
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            white-space: nowrap;
        }

        .table-cyber td {
            border-bottom: 1px solid rgba(0, 243, 255, 0.1);
            background: transparent !important;
            color: #c0eaef;
            white-space: nowrap;
        }

        .tr-danger td {
            background: rgba(255, 0, 85, 0.1) !important;
            color: #ff99bb !important;
        }

        .badge-cyber-yellow {
            background: rgba(255, 183, 0, 0.15);
            border: 1px solid var(--neon-yellow);
            color: var(--neon-yellow);
            box-shadow: 0 0 5px rgba(255, 183, 0, 0.4);
        }

        .badge-cyber-success {
            background: rgba(0, 255, 102, 0.15);
            border: 1px solid var(--neon-green);
            color: var(--neon-green);
        }

        .badge-cyber-danger {
            background: rgba(255, 0, 85, 0.15);
            border: 1px solid var(--neon-red);
            color: var(--neon-red);
        }

        .modal-content {
            background: var(--cyber-bg);
            border: 1px solid var(--neon-cyan);
            box-shadow: 0 0 25px rgba(0, 243, 255, 0.3);
            color: #d1f4ff;
        }

        .nav-tabs .nav-link {
            color: var(--neon-cyan);
            border: 1px solid transparent;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
        }

        .nav-tabs .nav-link.active {
            background: rgba(0, 243, 255, 0.15);
            border-color: var(--neon-cyan);
            color: #fff;
            box-shadow: 0 0 10px rgba(0, 243, 255, 0.3);
        }

        .list-group-item {
            background: rgba(5, 20, 30, 0.8);
            border: 1px solid rgba(0, 243, 255, 0.15);
            color: #d1f4ff;
        }

        /* RESPONSIVE UNTUK LAYAR MOBIL / ANDROID */
        @media (max-width: 991px) {
            .sidebar {
                left: -100%;
            }

            .sidebar.active {
                left: 0;
            }

            .main-content {
                margin-left: 0;
                padding: 12px;
            }

            .table-responsive {
                border: 0;
                overflow-x: auto;
                -webkit-overflow-scrolling: touch;
            }

            .table-cyber .btn-sm {
                padding: 4px 8px !important;
                font-size: 0.72rem !important;
            }
        }
    </style>
</head>
<body>
    <canvas id="matrixCanvas"></canvas>

    <!-- SIDEBAR NAVIGATION -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand cyber-font">
            <i class="bi bi-cpu text-info me-2"></i> SUPER ADMIN
        </div>
        <div class="sidebar-menu">
            <a href="#sec-maintenance" class="sidebar-item">
                <i class="bi bi-shield-exclamation text-warning"></i> MAINTENANCE
            </a>
            <a href="#sec-sekolah" class="sidebar-item active">
                <i class="bi bi-buildings"></i> DAFTAR SEKOLAH
            </a>
            <a href="#sec-form-sekolah" class="sidebar-item">
                <i class="bi bi-building-add"></i> TAMBAH SEKOLAH
            </a>
            <a href="#sec-form-admin" class="sidebar-item">
                <i class="bi bi-person-plus-fill"></i> TAMBAH ADMIN
            </a>
            <a href="#sec-form-petugas" class="sidebar-item">
                <i class="bi bi-person-badge-fill"></i> AKTIVASI PETUGAS
            </a>
            <a href="#sec-kredensial" class="sidebar-item">
                <i class="bi bi-shield-lock"></i> KREDENSIAL OPERATOR
            </a>
        </div>
        <div class="sidebar-footer">
            <a href="/login" class="btn btn-cyber-danger w-100 py-2">
                <i class="bi bi-power"></i> LOGOUT
            </a>
        </div>
    </aside>

    <!-- MAIN CONTENT AREA -->
    <div class="main-content">
        <!-- TOP NAVBAR -->
        <nav class="navbar navbar-cyber navbar-dark mb-4 px-3">
            <div class="container-fluid p-0 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <button class="btn btn-cyber-primary me-3 d-lg-none" type="button" onclick="toggleSidebar()">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <span class="navbar-brand mb-0 h1 cyber-font text-info fs-6">
                        <i class="bi bi-gear-wide-connected"></i> CONTROL CENTER
                    </span>
                </div>
                <div class="d-flex align-items-center">
                    <span class="text-info text-xs me-2">
                        OPERATOR: <strong class="text-white"><%= user.nama %></strong>
                    </span>
                </div>
            </div>
        </nav>

        <!-- KOTAK KONTROL MODE MAINTENANCE -->
        <div class="cyber-card mb-4" id="sec-maintenance">
            <div class="cyber-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fs-6"><i class="bi bi-shield-exclamation text-warning me-2"></i> MAINTENANCE SYSTEM</h5>
                <% if (typeof isMaintenance !== 'undefined' && isMaintenance) { %>
                    <span class="badge badge-cyber-danger">MAINTENANCE ACTIVE</span>
                <% } else { %>
                    <span class="badge badge-cyber-success">SYSTEM ONLINE</span>
                <% } %>
            </div>
            <div class="card-body p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="fw-bold text-white">STATUS KUNCI AKSES APLIKASI</div>
                    <small class="text-info">
                        Saat diaktifkan, seluruh pengguna (Admin Sekolah, Petugas, Wali Kelas) akan diblokir & dialihkan ke halaman pemeliharaan.
                    </small>
                </div>
                <div>
                    <% if (typeof isMaintenance !== 'undefined' && isMaintenance) { %>
                        <button onclick="setMaintenance('false')" class="btn btn-cyber-success w-100 py-2">
                            <i class="bi bi-unlock-fill me-1"></i> MATIKAN MAINTENANCE
                        </button>
                    <% } else { %>
                        <button onclick="setMaintenance('true')" class="btn btn-cyber-danger w-100 py-2">
                            <i class="bi bi-lock-fill me-1"></i> AKTIFKAN MAINTENANCE
                        </button>
                    <% } %>
                </div>
            </div>
        </div>

        <div class="container-fluid p-0">
            <div class="row">
                <!-- KOLOM KIRI (FORMULIR KONTROL) -->
                <div class="col-lg-4 mb-4">
                    
                    <!-- 1. Form Pendaftaran Sekolah Baru -->
                    <div class="cyber-card mb-4" id="sec-form-sekolah">
                        <div class="cyber-header cyber-header-green d-flex align-items-center">
                            <i class="bi bi-building-add me-2 fs-5"></i>
                            <h5 class="mb-0 fs-6">PENDAFTARAN SEKOLAH</h5>
                        </div>
                        <div class="card-body p-3">
                            <form action="/api/sekolah/tambah" method="POST" autocomplete="off">
                                <div class="mb-3">
                                    <label class="form-label">NAMA SEKOLAH RESMI</label>
                                    <input type="text" name="nama_sekolah" class="form-control" placeholder="Ex: SDN 03 Pagardewa" autocomplete="off" required>
                                </div>
                                <hr class="border-secondary my-3">
                                <h6 class="text-success cyber-font mb-2 fs-6"><i class="bi bi-person-gear"></i> AKUN ADMIN SEKOLAH</h6>
                                <div class="mb-3">
                                    <label class="form-label">NAMA ADMIN</label>
                                    <input type="text" name="admin_nama" class="form-control" placeholder="Ex: Pak Budi (Operator)" autocomplete="off">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">USERNAME ADMIN</label>
                                    <input type="text" name="admin_username" class="form-control" placeholder="admin_sd3" autocomplete="new-password" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">PASSWORD ADMIN</label>
                                    <div class="input-group">
                                        <input type="password" id="inputPassTambah" name="admin_password" class="form-control" placeholder="******" autocomplete="new-password" required>
                                        <button class="btn btn-cyber-primary" type="button" onclick="togglePassword('inputPassTambah', 'iconPassTambah')">
                                            <i id="iconPassTambah" class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-cyber-success w-100 py-2 mt-2">
                                    <i class="bi bi-plus-circle"></i> INISIALISASI SEKOLAH
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- 2. Form Tambah Admin Baru ke Sekolah -->
                    <div class="cyber-card mb-4" id="sec-form-admin">
                        <div class="cyber-header cyber-header-blue d-flex align-items-center">
                            <i class="bi bi-person-plus-fill me-2 fs-5"></i>
                            <h5 class="mb-0 fs-6">TAMBAH ADMIN SEKOLAH</h5>
                        </div>
                        <div class="card-body p-3">
                            <form action="/api/admin/tambah-ke-sekolah" method="POST" autocomplete="off">
                                <div class="mb-3">
                                    <label class="form-label">PILIH SEKOLAH TARGET</label>
                                    <select name="sekolah_id" class="form-select form-select-cyber" required>
                                        <option value="">-- Pilih Sekolah --</option>
                                        <% sekolahList.forEach(s => { %>
                                            <option value="<%= s.id %>">#<%= s.id %> - <%= s.nama_sekolah %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">NAMA LENGKAP ADMIN</label>
                                    <input type="text" name="nama" class="form-control" placeholder="Ex: Pak Budi (Operator)" autocomplete="off" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">USERNAME ADMIN</label>
                                    <input type="text" name="username" class="form-control" placeholder="admin_sekolah2" autocomplete="new-password" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">PASSWORD ADMIN</label>
                                    <div class="input-group">
                                        <input type="password" id="inputPassAdminTarget" name="password" class="form-control" placeholder="******" autocomplete="new-password" required>
                                        <button class="btn btn-cyber-primary" type="button" onclick="togglePassword('inputPassAdminTarget', 'iconPassAdminTarget')">
                                            <i id="iconPassAdminTarget" class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-cyber-blue w-100 py-2">
                                    <i class="bi bi-person-check-fill"></i> BUAT AKUN ADMIN
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- 3. Form Tambah Akun Petugas -->
                    <div class="cyber-card" id="sec-form-petugas">
                        <div class="cyber-header cyber-header-green d-flex align-items-center">
                            <i class="bi bi-person-badge-fill me-2 fs-5"></i>
                            <h5 class="mb-0 fs-6">AKTIVASI AKUN PETUGAS</h5>
                        </div>
                        <div class="card-body p-3">
                            <form action="/api/superadmin/petugas/tambah" method="POST" autocomplete="off">
                                <div class="mb-3">
                                    <label class="form-label">PILIH SEKOLAH TARGET</label>
                                    <select name="sekolah_id" class="form-select form-select-cyber" required>
                                        <option value="">-- Pilih Sekolah --</option>
                                        <% sekolahList.forEach(s => { %>
                                            <option value="<%= s.id %>"><%= s.nama_sekolah %></option>
                                        <% }); %>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">NAMA PETUGAS ABSEN</label>
                                    <input type="text" name="nama" class="form-control" placeholder="Ex: Petugas Absen Utama" autocomplete="off" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">USERNAME LOGIN</label>
                                    <input type="text" name="username" class="form-control" placeholder="petugas_sd1" autocomplete="new-password" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">PASSWORD</label>
                                    <div class="input-group">
                                        <input type="password" id="inputPassPetugas" name="password" class="form-control" placeholder="******" autocomplete="new-password" required>
                                        <button class="btn btn-cyber-primary" type="button" onclick="togglePassword('inputPassPetugas', 'iconPassPetugas')">
                                            <i id="iconPassPetugas" class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-cyber-success w-100 py-2">
                                    <i class="bi bi-shield-check"></i> BUAT AKUN PETUGAS
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

                <!-- KOLOM KANAN (TABEL MONITORING & KENDALI DATA) -->
                <div class="col-lg-8">
                    
                    <!-- Tabel Sekolah -->
                    <div class="cyber-card mb-4" id="sec-sekolah">
                        <div class="cyber-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fs-6"><i class="bi bi-buildings"></i> DAFTAR SEKOLAH</h5>
                            <span class="badge badge-cyber-success">SYSTEM ONLINE</span>
                        </div>
                        <div class="card-body p-0 table-responsive">
                            <table class="table table-cyber align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>NAMA SEKOLAH</th>
                                        <th>PENGGUNA</th>
                                        <th>PENGIRIM WA</th>
                                        <th>STATUS</th>
                                        <th class="text-center">KENDALI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% sekolahList.forEach(s => { %>
                                        <tr class="<%= s.is_active ? '' : 'tr-danger' %>">
                                            <td><strong class="text-info">#<%= s.id %></strong></td>
                                            <td>
                                                <strong class="text-white"><%= s.nama_sekolah %></strong>
                                                <% if (!s.is_active) { %>
                                                    <br><small class="text-danger">[DITANGGUHKAN]</small>
                                                <% } %>
                                            </td>
                                            <td><%= s.total_pengguna %> Acc</td>
                                            
                                            <td>
                                                <form action="/api/sekolah/wa-mode/<%= s.id %>" method="POST">
                                                    <select name="wa_mode" onchange="this.form.submit()" class="form-select form-select-sm form-select-cyber py-1 px-2 text-xs">
                                                        <option value="WALI_KELAS" <%= s.wa_mode === 'WALI_KELAS' ? 'selected' : '' %>>📱 Wali Kelas</option>
                                                        <option value="PETUGAS" <%= s.wa_mode === 'PETUGAS' ? 'selected' : '' %>>🏢 Petugas Absen</option>
                                                    </select>
                                                </form>
                                            </td>

                                            <td>
                                                <% if (s.is_active) { %>
                                                    <span class="badge badge-cyber-success">ACTIVE</span>
                                                <% } else { %>
                                                    <span class="badge badge-cyber-danger">DISABLED</span>
                                                <% } %>
                                            </td>
                                            <td class="text-center">
                                                <!-- Tombol Masuk / Kelola Penuh Sekolah (Aksen Kuning Glow) -->
                                                <a href="/superadmin/switch-sekolah/<%= s.id %>" class="btn btn-cyber-warning btn-sm me-1" title="Masuk & Kelola Penuh Sekolah Ini">
                                                    <i class="bi bi-door-open-fill"></i> KELOLA
                                                </a>

                                                <!-- Button Intip Ringkas -->
                                                <button class="btn btn-cyber-primary btn-sm me-1" onclick="lihatSekolah('<%= s.id %>')" title="Intip Detail Ringkas">
                                                    <i class="bi bi-eye"></i>
                                                </button>

                                                <!-- Form Toggle Status -->
                                                <form action="/api/sekolah/toggle-status/<%= s.id %>" method="POST" class="d-inline">
                                                    <% if (s.is_active) { %>
                                                        <button type="submit" class="btn btn-cyber-danger btn-sm me-1" onclick="return confirm('Nonaktifkan akses sekolah ini?')" title="Nonaktifkan">
                                                            <i class="bi bi-slash-circle"></i>
                                                        </button>
                                                    <% } else { %>
                                                        <button type="submit" class="btn btn-cyber-success btn-sm me-1" title="Aktifkan">
                                                            <i class="bi bi-check-circle"></i>
                                                        </button>
                                                    <% } %>
                                                </form>

                                                <button class="btn btn-cyber-warning btn-sm me-1" onclick="editSekolah('<%= s.id %>', '<%= s.nama_sekolah %>')" title="Edit Nama Sekolah">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                
                                                <form action="/api/sekolah/hapus/<%= s.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus permanen sekolah ini?')">
                                                    <button type="submit" class="btn btn-cyber-danger btn-sm" title="Hapus Sekolah">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Tabel Admin Sekolah -->
                    <div class="cyber-card" id="sec-kredensial">
                        <div class="cyber-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fs-6"><i class="bi bi-shield-lock"></i> KREDENSIAL OPERATOR SEKOLAH</h5>
                        </div>
                        <div class="card-body p-0 table-responsive">
                            <table class="table table-cyber align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>NAMA OPERATOR</th>
                                        <th>USERNAME</th>
                                        <th>SEKOLAH TERHUBUNG</th>
                                        <th class="text-center">AKSI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% adminList.forEach(a => { %>
                                        <tr>
                                            <td class="text-white"><%= a.nama %></td>
                                            <td><code class="text-info"><%= a.username %></code></td>
                                            <td><%= a.nama_sekolah %></td>
                                            <td class="text-center">
                                                <button class="btn btn-cyber-warning btn-sm me-1" onclick="editAdmin('<%= a.id %>', '<%= a.nama %>', '<%= a.username %>')">
                                                    <i class="bi bi-pencil"></i> EDIT
                                                </button>
                                                <form action="/api/admin/hapus/<%= a.id %>" method="POST" class="d-inline" onsubmit="return confirm('Hapus akun admin ini?')">
                                                    <button type="submit" class="btn btn-cyber-danger btn-sm">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Modal Lihat Detail Sekolah -->
    <div class="modal fade" id="modalLihatSekolah" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-info cyber-font fs-6" id="lihatJudulSekolah">DATABASE INSPECTOR</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <ul class="nav nav-tabs mb-3 border-secondary" id="detailTab" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link active" id="pengguna-tab" data-bs-toggle="tab" data-bs-target="#pengguna-panel">PENGGUNA / GURU</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="rombel-tab" data-bs-toggle="tab" data-bs-target="#rombel-panel">ROMBEL</button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link" id="siswa-tab" data-bs-toggle="tab" data-bs-target="#siswa-panel">SISWA</button>
                        </li>
                    </ul>
                    <div class="tab-content" id="detailTabContent">
                        <div class="tab-pane fade show active" id="pengguna-panel">
                            <ul class="list-group" id="listPengguna"></ul>
                        </div>
                        <div class="tab-pane fade" id="rombel-panel">
                            <ul class="list-group" id="listRombel"></ul>
                        </div>
                        <div class="tab-pane fade" id="siswa-panel">
                            <ul class="list-group" id="listSiswa" style="max-height: 300px; overflow-y: auto;"></ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Edit Sekolah -->
    <div class="modal fade" id="modalSekolah" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formEditSekolah" method="POST" autocomplete="off">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-info cyber-font fs-6">EDIT ENTITAS SEKOLAH</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">NAMA SEKOLAH RESMI</label>
                            <input type="text" id="editNamaSekolah" name="nama_sekolah" class="form-control" autocomplete="off" required>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-cyber-danger" data-bs-dismiss="modal">BATAL</button>
                        <button type="submit" class="btn btn-cyber-success">SIMPAN</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Edit Admin -->
    <div class="modal fade" id="modalAdmin" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <form id="formEditAdmin" method="POST" autocomplete="off">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-info cyber-font fs-6">EDIT KREDENSIAL ADMIN</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">NAMA ADMIN</label>
                            <input type="text" id="editNamaAdmin" name="nama" class="form-control" autocomplete="off" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">USERNAME</label>
                            <input type="text" id="editUsernameAdmin" name="username" class="form-control" autocomplete="new-password" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">PASSWORD BARU *(KOSONGKAN JIKA TIDAK DIBUAT BARU)*</label>
                            <div class="input-group">
                                <input type="password" id="inputPassEdit" name="password" class="form-control" placeholder="Password Baru" autocomplete="new-password">
                                <button class="btn btn-cyber-primary" type="button" onclick="togglePassword('inputPassEdit', 'iconPassEdit')">
                                    <i id="iconPassEdit" class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-cyber-danger" data-bs-dismiss="modal">BATAL</button>
                        <button type="submit" class="btn btn-cyber-success">UPDATE DATA</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Matrix Rain Canvas Effect (Cyber Green)
        const canvas = document.getElementById('matrixCanvas');
        const ctx = canvas.getContext('2d');

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);

        const characters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*+-/<>[]{}';
        const fontSize = 14;
        let columns = Math.floor(canvas.width / fontSize);
        let drops = [];

        for (let i = 0; i < columns; i++) {
            drops[i] = Math.floor(Math.random() * -100);
        }

        function drawMatrix() {
            ctx.fillStyle = 'rgba(3, 10, 14, 0.08)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#00ff66';
            ctx.font = fontSize + 'px "Share Tech Mono", monospace';

            for (let i = 0; i < drops.length; i++) {
                const text = characters.charAt(Math.floor(Math.random() * characters.length));
                const x = i * fontSize;
                const y = drops[i] * fontSize;

                ctx.fillText(text, x, y);

                if (y > canvas.height && Math.random() > 0.975) {
                    drops[i] = 0;
                }
                drops[i]++;
            }
        }
        setInterval(drawMatrix, 35);

        // Toggle Sidebar Mobile
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('active');
        }

        const modalSekolahBs = new bootstrap.Modal(document.getElementById('modalSekolah'));
        const modalAdminBs = new bootstrap.Modal(document.getElementById('modalAdmin'));
        const modalLihatBs = new bootstrap.Modal(document.getElementById('modalLihatSekolah'));

        // Fungsi Sakelar Mode Maintenance
        function setMaintenance(status) {
            const pesan = status === 'true' 
                ? 'Apakah Anda yakin ingin MENGAKTIFKAN mode maintenance?\n\nSemua pengguna selain Super Admin akan diblokir dari sistem.' 
                : 'Apakah Anda yakin ingin MEMATIKAN mode maintenance?\n\nAplikasi akan kembali berjalan normal.';

            if (!confirm(pesan)) return;

            fetch('/api/settings/maintenance', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ active: status })
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                location.reload();
            })
            .catch(err => {
                alert('Gagal mengubah status maintenance!');
            });
        }

        async function lihatSekolah(id) {
            try {
                const res = await fetch('/api/sekolah/detail/' + id);
                const data = await res.json();
                if (!data.success) return alert(data.message);

                document.getElementById('lihatJudulSekolah').innerText = 'INSPECTION // ' + data.namaSekolah;

                const listP = document.getElementById('listPengguna');
                listP.innerHTML = data.penggunaList.length ? data.penggunaList.map(p => 
                    `<li class="list-group-item d-flex justify-content-between align-items-center">
                        <div><strong class="text-info">${p.nama}</strong> (${p.username})</div>
                        <span class="badge badge-cyber-success">${p.role} - ${p.nama_kelas}</span>
                    </li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada pengguna</li>';

                const listR = document.getElementById('listRombel');
                listR.innerHTML = data.kelasList.length ? data.kelasList.map(k => 
                    `<li class="list-group-item text-info">CLASS NODE: <strong>${k.nama_kelas}</strong></li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada rombel</li>';

                const listS = document.getElementById('listSiswa');
                listS.innerHTML = data.siswaList.length ? data.siswaList.map(s => 
                    `<li class="list-group-item d-flex justify-content-between align-items-center">
                        ${s.nama} <span class="badge badge-cyber-success">${s.nama_kelas}</span>
                    </li>`
                ).join('') : '<li class="list-group-item text-muted">Belum ada siswa</li>';

                modalLihatBs.show();
            } catch (err) {
                alert('Gagal mengambil detail data dari server.');
            }
        }

        function editSekolah(id, nama) {
            document.getElementById('editNamaSekolah').value = nama;
            document.getElementById('formEditSekolah').action = '/api/sekolah/edit/' + id;
            modalSekolahBs.show();
        }

        function editAdmin(id, nama, username) {
            document.getElementById('editNamaAdmin').value = nama;
            document.getElementById('editUsernameAdmin').value = username;
            document.getElementById('formEditAdmin').action = '/api/admin/edit/' + id;
            modalAdminBs.show();
        }

        function togglePassword(inputId, iconId) {
            const passInput = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    <!-- PASTIKAN BUNGKUS DENGAN TAG <script> DI ATAS DAN </script> DI BAWAH -->
    <script>
        // ==========================================
        // FUNGSI SAKELAR MODE MAINTENANCE (FIXED)
        // ==========================================
        function setMaintenance(status) {
            const isEnable = String(status) === 'true';
            const pesan = isEnable 
                ? 'Apakah Anda yakin ingin MENGAKTIFKAN mode maintenance?\n\nSemua pengguna (Admin Sekolah, Petugas, Wali Kelas) akan diblokir dari sistem.' 
                : 'Apakah Anda yakin ingin MEMATIKAN mode maintenance?\n\nAplikasi akan kembali berjalan normal.';

            if (!confirm(pesan)) return;

            // Mengambil ID User dari URL jika ada
            const urlParams = new URLSearchParams(window.location.search);
            const userId = urlParams.get('userId') || '';

            fetch('/api/settings/maintenance' + (userId ? '?userId=' + userId : ''), {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({ active: isEnable ? 'true' : 'false' })
            })
            .then(async (res) => {
                const data = await res.json();
                if (res.ok && data.success) {
                    alert(data.message);
                    window.location.reload();
                } else {
                    alert('Gagal: ' + (data.message || 'Terjadi kesalahan sistem'));
                }
            })
            .catch(err => {
                console.error('Error Maintenance:', err);
                alert('Gagal terhubung ke server! Periksa koneksi internet Anda.');
            });
        }
    </script>
</body>
</html>
</body>
</html>
