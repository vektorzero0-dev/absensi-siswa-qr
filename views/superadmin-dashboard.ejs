                            <i class="bi bi-person-badge-fill me-2 fs-5"></i>
                            <h5 class="mb-0 fs-6">AKTIVASI AKUN PETUGAS</h5>
                        </div>
                        <div class="card-body p-3">
                            <form action="/api/superadmin/petugas/tambah" method="POST" autocomplete="off">
                                <div class="mb-3">
                                    <label class="form-label">PILIH SEKOLAH TARGET</label>
                                    <select name="sekolah_id" class="form-select form-select-cyber" required>
