                                    <label class="form-label">PASSWORD ADMIN</label>
                                    <div class="input-group">
                                        <input type="password" id="inputPassAdminTarget" name="password" class="form-control" placeholder="******" autocomplete="new-password" required>
                                        <button class="btn btn-cyber-primary" type="button" onclick="togglePassword('inputPassAdminTarget', 'iconPassAdminTarget')">
                                            <i id="iconPassAdminTarget" class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-cyber-blue w-100 py-2">
                                    <i class="bi bi-person-check-fill me-1"></i> BUAT AKUN ADMIN
                                </button>
