<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scanner Presensi - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans">

    <div>
        <nav class="bg-blue-900 text-white border-b-4 border-amber-400 sticky top-0 z-50 shadow-md">
            <div class="max-w-xl mx-auto px-4 py-3 flex justify-between items-center">
                <a href="/wali?userId=<%= userId %>" class="text-xs text-amber-300 font-bold hover:underline flex items-center gap-1">
                    <i class="fa-solid fa-arrow-left"></i> Dashboard
                </a>
                <span class="text-xs font-bold">Kamera Absensi</span>
            </div>
        </nav>

        <div class="max-w-xl mx-auto px-4 mt-6">
            <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-md">
                <div class="text-center mb-4">
                    <h2 class="text-base font-bold text-blue-900">UPTD SD NEGERI 1 KARYA MULYA SARI</h2>
                    <p class="text-xs text-slate-500">Arahkan QR Code Kartu Siswa ke Kamera</p>
                </div>

                <div class="rounded-xl overflow-hidden border-2 border-blue-900 bg-black">
                    <div id="reader" class="w-full"></div>
                </div>

                <div id="result-box" class="mt-4 hidden p-3 rounded-xl border text-xs font-semibold text-center"></div>
            </div>
        </div>
    </div>

    <!-- Footer Developer -->
    <footer class="bg-white border-t border-slate-200 py-3 text-slate-600 text-xs mt-8">
        <div class="max-w-xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
            <p class="font-medium">Dikembangkan oleh <span class="font-bold text-blue-900">Zeeo</span></p>
            <div class="flex items-center gap-3 text-slate-500">
                <a href="mailto:vektorzero0@gmail.com" class="hover:text-blue-700"><i class="fa-regular fa-envelope text-blue-800 mr-1"></i>vektorzero0@gmail.com</a>
                <span>|</span>
                <a href="https://wa.me/6282371729760" target="_blank" class="hover:text-emerald-600"><i class="fa-brands fa-whatsapp text-emerald-600 mr-1"></i>082371729760</a>
            </div>
        </div>
    </footer>

    <script>
        const waliKelasId = "<%= userId %>";
        let isProcessing = false;

        function onScanSuccess(decodedText) {
            if (isProcessing) return;
            isProcessing = true;

            const resultBox = document.getElementById('result-box');
            resultBox.classList.remove('hidden', 'bg-emerald-50', 'border-emerald-300', 'text-emerald-800', 'bg-rose-50', 'border-rose-300', 'text-rose-800');
            resultBox.classList.add('bg-blue-50', 'border-blue-300', 'text-blue-800');
            resultBox.innerHTML = `<i class="fa-solid fa-spinner fa-spin mr-2"></i> Memproses presensi...`;

            fetch('/api/absen', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ siswaId: decodedText, waliKelasId: waliKelasId })
            })
            .then(res => res.json())
            .then(data => {
                resultBox.classList.remove('bg-blue-50', 'border-blue-300', 'text-blue-800');
                if (data.success) {
                    resultBox.classList.add('bg-emerald-50', 'border-emerald-300', 'text-emerald-800');
                    resultBox.innerHTML = `<i class="fa-solid fa-circle-check mr-1"></i> ${data.message}`;
                } else {
                    resultBox.classList.add('bg-rose-50', 'border-rose-300', 'text-rose-800');
                    resultBox.innerHTML = `<i class="fa-solid fa-circle-xmark mr-1"></i> ${data.message}`;
                }

                setTimeout(() => { isProcessing = false; }, 3000);
            })
            .catch(() => { isProcessing = false; });
        }

        const html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: 220 });
        html5QrcodeScanner.render(onScanSuccess);
    </script>
</body>
</html>
