<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scanner QR Code Presensi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
</head>
<body class="bg-slate-100 min-h-screen flex flex-col justify-between items-center p-4">

    <div class="w-full max-w-md bg-white p-4 rounded-2xl shadow-sm flex items-center justify-between mb-4 border border-slate-200">
        <div class="flex items-center gap-3">
            <a href="/wali?userId=<%= userId %>" class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-slate-600 hover:bg-slate-200">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="font-bold text-slate-800 text-sm">Scan QR Code Siswa</h1>
                <p class="text-xs text-slate-500">Arahkan kamera ke QR Code ID Siswa</p>
            </div>
        </div>
    </div>

    <div id="alert-box" class="w-full max-w-md hidden mb-4 p-4 rounded-2xl text-sm font-semibold flex items-center gap-3"></div>

    <div class="w-full max-w-md bg-white p-4 rounded-2xl shadow-md border border-slate-200 flex flex-col items-center">
        <div id="reader" class="w-full rounded-xl overflow-hidden bg-black min-h-[300px] flex items-center justify-center text-white">
            <span class="text-xs text-slate-400">Menyiapkan Kamera...</span>
        </div>
    </div>

    <div class="w-full max-w-md mt-4 text-center">
        <p class="text-xs text-slate-400">UPTD SD Negeri 1 Karya Mulya Sari</p>
    </div>

    <script>
        const userId = "<%= userId %>";
        let isProcessing = false;

        function showAlert(message, type = 'success') {
            const alertBox = document.getElementById('alert-box');
            alertBox.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-700', 'border-emerald-300', 'bg-rose-100', 'text-rose-700', 'border-rose-300');
            
            if (type === 'success') {
                alertBox.classList.add('bg-emerald-100', 'text-emerald-700', 'border', 'border-emerald-300');
                alertBox.innerHTML = `<i class="fa-solid fa-circle-check text-lg"></i> <span>${message}</span>`;
            } else {
                alertBox.classList.add('bg-rose-100', 'text-rose-700', 'border', 'border-rose-300');
                alertBox.innerHTML = `<i class="fa-solid fa-circle-xmark text-lg"></i> <span>${message}</span>`;
            }

            setTimeout(() => { alertBox.classList.add('hidden'); }, 4000);
        }

        async function onScanSuccess(decodedText) {
            if (isProcessing) return;
            isProcessing = true;

            try {
                const response = await fetch('/api/scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ siswa_id: decodedText, scanned_by: userId })
                });

                const result = await response.json();

                if (result.success) {
                    showAlert(`✅ Presensi Berhasil: ${result.siswa.nama} (${result.siswa.nama_kelas})`, 'success');
                } else {
                    showAlert(`❌ Gagal: ${result.message}`, 'error');
                }
            } catch (err) {
                showAlert('❌ Error Jaringan / Server!', 'error');
            }

            setTimeout(() => { isProcessing = false; }, 3000);
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (typeof Html5QrcodeScanner !== 'undefined') {
                const html5QrcodeScanner = new Html5QrcodeScanner(
                    "reader", { fps: 10, qrbox: { width: 250, height: 250 } }, false
                );
                html5QrcodeScanner.render(onScanSuccess, () => {});
            } else {
                document.getElementById('reader').innerHTML = `
                    <div class="p-4 text-center text-rose-400 text-xs">
                        Gagal memuat modul kamera. Periksa koneksi internet Anda.
                    </div>
                `;
            }
        });
    </script>
</body>
</html>
