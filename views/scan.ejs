<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scanner QR Absensi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-900 text-white min-h-screen flex flex-col">
    <!-- Header -->
    <div class="p-4 flex justify-between items-center bg-slate-800 border-b border-slate-700">
        <h1 class="font-bold flex items-center gap-2">
            <i class="fa-solid fa-camera text-blue-400"></i> Scanner Absensi
        </h1>
        <a href="/wali?userId=<%= userId %>" class="text-xs bg-slate-700 hover:bg-slate-600 px-3 py-2 rounded-lg font-semibold transition">
            Kembali
        </a>
    </div>

    <!-- Scanner Area -->
    <div class="flex-1 flex flex-col items-center justify-center p-4">
        <div class="w-full max-w-sm bg-slate-800 rounded-2xl overflow-hidden border border-slate-700 p-3 shadow-2xl">
            <div id="reader" class="w-full rounded-xl overflow-hidden"></div>
        </div>

        <!-- Pop-up Status Result -->
        <div id="result-box" class="hidden mt-6 w-full max-w-sm p-4 rounded-xl text-center font-bold text-sm shadow-lg transition"></div>
    </div>

    <script>
        const userId = "<%= userId %>";
        let isProcessing = false;

        function onScanSuccess(decodedText) {
            if (isProcessing) return;
            isProcessing = true;

            const resultBox = document.getElementById('result-box');
            resultBox.className = "mt-6 w-full max-w-sm p-4 rounded-xl text-center font-bold text-sm shadow-lg bg-blue-600 text-white block animate-pulse";
            resultBox.innerText = "Memproses Absensi...";

            fetch('/api/absen', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ siswaId: decodedText, waliKelasId: userId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    resultBox.className = "mt-6 w-full max-w-sm p-4 rounded-xl text-center font-bold text-sm shadow-lg bg-emerald-600 text-white block";
                    resultBox.innerText = `✅ ${data.message}`;
                } else {
                    resultBox.className = "mt-6 w-full max-w-sm p-4 rounded-xl text-center font-bold text-sm shadow-lg bg-rose-600 text-white block";
                    resultBox.innerText = `❌ ${data.message}`;
                }
                setTimeout(() => {
                    resultBox.className = "hidden";
                    isProcessing = false;
                }, 3000);
            })
            .catch(() => {
                resultBox.className = "mt-6 w-full max-w-sm p-4 rounded-xl text-center font-bold text-sm shadow-lg bg-rose-600 text-white block";
                resultBox.innerText = "❌ Gagal koneksi server!";
                setTimeout(() => {
                    resultBox.className = "hidden";
                    isProcessing = false;
                }, 3000);
            });
        }

        const html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: 220 });
        html5QrcodeScanner.render(onScanSuccess);
    </script>
</body>
</html>
