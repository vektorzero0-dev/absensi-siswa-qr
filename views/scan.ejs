<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scanner Presensi - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/html5-qrcode"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-blue-950 text-white min-h-screen flex flex-col justify-between p-4">

    <div>
        <div class="max-w-md mx-auto flex justify-between items-center mb-6 pt-2">
            <div>
                <h1 class="text-sm font-bold flex items-center gap-2 text-white">
                    <i class="fa-solid fa-qrcode text-emerald-400"></i> SCANNER PRESENSI
                </h1>
                <p class="text-[10px] text-blue-300">UPTD SD NEGERI 1 KARYA MULYA SARI</p>
            </div>
            <a href="javascript:history.back()" class="bg-blue-900 border border-blue-800 text-xs px-3 py-1.5 rounded-lg text-blue-200 hover:bg-slate-800">Kembali</a>
        </div>

        <div class="max-w-md mx-auto bg-slate-900 rounded-2xl p-4 shadow-2xl border border-slate-800">
            <div id="reader" class="overflow-hidden rounded-xl border border-slate-800 bg-black"></div>

            <div id="result-box" class="hidden mt-4 p-4 rounded-xl text-center font-medium text-xs"></div>

            <div class="mt-6 pt-4 border-t border-slate-800">
                <label class="block text-slate-400 text-xs mb-2">Input Manual ID Siswa (Jika Tanpa Kamera):</label>
                <div class="flex gap-2">
                    <input type="number" id="manual_id" placeholder="Masukkan ID Siswa (Contoh: 1)" class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs focus:outline-none focus:border-emerald-500 text-white">
                    <button onclick="kirimManual()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl text-xs font-semibold">Proses</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Developer Credit Footer -->
    <footer class="mt-8 text-center text-[11px] text-blue-300">
        Developer: <strong>Zeeo</strong> | <a href="mailto:vektorzero0@gmail.com" class="underline">vektorzero0@gmail.com</a> | WA: <a href="https://wa.me/6282371729760" class="underline">082371729760</a>
    </footer>

    <script>
        const scannedBy = <%= userId %>;
        let isProcessing = false;

        async function prosesScan(siswaId) {
            if (isProcessing) return;
            isProcessing = true;

            const box = document.getElementById('result-box');
            box.classList.remove('hidden', 'bg-emerald-950', 'text-emerald-300', 'bg-rose-950', 'text-rose-300');
            box.classList.add('bg-slate-800', 'text-white');
            box.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses Presensi...';

            try {
                const response = await fetch('/api/scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ siswa_id: siswaId, scanned_by: scannedBy })
                });

                const data = await response.json();

                if (data.success) {
                    box.classList.remove('bg-slate-800');
                    box.classList.add('bg-emerald-950', 'text-emerald-300');
                    box.innerHTML = `✅ <strong>${data.siswa.nama}</strong> (${data.siswa.nama_kelas}) - PRESENSI BERHASIL!`;
                } else {
                    box.classList.remove('bg-slate-800');
                    box.classList.add('bg-rose-950', 'text-rose-300');
                    box.innerHTML = `❌ ${data.message}`;
                }
            } catch (err) {
                box.classList.remove('bg-slate-800');
                box.classList.add('bg-rose-950', 'text-rose-300');
                box.innerHTML = '❌ Terjadi Kesalahan Server.';
            }

            setTimeout(() => { isProcessing = false; }, 3000);
        }

        function kirimManual() {
            const val = document.getElementById('manual_id').value;
            if (val) prosesScan(val);
        }

        const html5QrcodeScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: 250 });
        html5QrcodeScanner.render((decodedText) => {
            prosesScan(decodedText);
        });
    </script>
</body>
</html>
