<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scanner Presensi Pro</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between items-center p-4">

    <!-- Navbar Container -->
    <div class="w-full max-w-md bg-slate-900/80 backdrop-blur-md border border-slate-800 p-4 rounded-3xl flex items-center justify-between shadow-xl">
        <div class="flex items-center gap-3">
            <a href="/wali?userId=<%= userId %>" class="w-10 h-10 bg-slate-800 hover:bg-slate-700 rounded-2xl flex items-center justify-center text-slate-300 transition">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
            <div>
                <h1 class="font-bold text-sm text-white">Scanner QR Presensi</h1>
                <p class="text-[11px] text-slate-400">Presensi Otomatis & Notifikasi WA</p>
            </div>
        </div>
        <div class="w-3 h-3 bg-emerald-500 rounded-full animate-ping"></div>
    </div>

    <!-- Alert Box -->
    <div id="alert-box" class="w-full max-w-md hidden my-2 p-4 rounded-2xl text-xs font-semibold backdrop-blur-md transition-all duration-300"></div>

    <!-- Frame Kamera Scanner -->
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 p-3 rounded-3xl shadow-2xl relative overflow-hidden">
        <div id="reader" class="w-full rounded-2xl overflow-hidden bg-black min-h-[320px] flex items-center justify-center">
            <span class="text-xs text-slate-500">Memuat modul kamera...</span>
        </div>
    </div>

    <!-- Footer Meta -->
    <div class="w-full max-w-md text-center py-2">
        <p class="text-[11px] text-slate-500">System Integrated • Real-time DB Sync</p>
    </div>

    <script>
        const userId = "<%= userId %>";
        let isProcessing = false;

        function showAlert(msg, type = 'success') {
            const el = document.getElementById('alert-box');
            el.classList.remove('hidden', 'bg-emerald-500/10', 'text-emerald-400', 'border-emerald-500/30', 'bg-rose-500/10', 'text-rose-400', 'border-rose-500/30');
            
            if (type === 'success') {
                el.classList.add('bg-emerald-500/10', 'text-emerald-400', 'border', 'border-emerald-500/30');
                el.innerHTML = `<i class="fa-solid fa-circle-check text-base"></i> <span>${msg}</span>`;
            } else {
                el.classList.add('bg-rose-500/10', 'text-rose-400', 'border', 'border-rose-500/30');
                el.innerHTML = `<i class="fa-solid fa-circle-xmark text-base"></i> <span>${msg}</span>`;
            }

            setTimeout(() => { el.classList.add('hidden'); }, 3500);
        }

        async function onScanSuccess(decodedText) {
            if (isProcessing) return;
            isProcessing = true;

            try {
                const res = await fetch('/api/scan', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ siswa_id: decodedText, scanned_by: userId })
                });

                const data = await res.json();
                if (data.success) {
                    showAlert(`✅ Presensi Berhasil: ${data.siswa.nama} (${data.siswa.nama_kelas})`, 'success');
                } else {
                    showAlert(`❌ Gagal: ${data.message}`, 'error');
                }
            } catch (err) {
                showAlert('❌ Error Jaringan / Server!', 'error');
            }

            setTimeout(() => { isProcessing = false; }, 2500);
        }

        document.addEventListener("DOMContentLoaded", () => {
            if (typeof Html5QrcodeScanner !== 'undefined') {
                const scanner = new Html5QrcodeScanner("reader", { fps: 15, qrbox: { width: 220, height: 220 } }, false);
                scanner.render(onScanSuccess, () => {});
            }
        });
    </script>
</body>
</html>
