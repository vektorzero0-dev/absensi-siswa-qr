<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Lagi Konser Roket 🚀</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome & Font Google -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Gradasi Warna Warni Bergerak Halus (Gokil & Estetik) */
        .bg-neon-animated {
            background: linear-gradient(-45deg, #0f172a, #3b0764, #1e1b4b, #022c22);
            background-size: 400% 400%;
            animation: gradientNeon 10s ease infinite;
        }

        @keyframes gradientNeon {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Animasi Ikon Goyang Kocak (Anti-Geser Layout Utama) */
        @keyframes goyangKocak {
            0%, 100% { transform: rotate(0deg); }
            20% { transform: rotate(-15deg) scale(1.1); }
            40% { transform: rotate(15deg) scale(1.1); }
            60% { transform: rotate(-10deg); }
            80% { transform: rotate(10deg); }
        }
        .animate-goyang { animation: goyangKocak 1.2s ease-in-out infinite; }

        /* Efek Glow Halus */
        .glow-box {
            box-shadow: 0 0 40px -10px rgba(168, 85, 247, 0.25);
        }
    </style>
</head>
<body class="bg-neon-animated text-slate-100 min-h-screen flex items-center justify-center p-4 relative overflow-hidden select-none">
    
    <!-- Ornamen Lingkaran Glow Neon di Latar Belakang -->
    <div class="absolute -top-32 -left-32 w-[30rem] h-[30rem] bg-purple-600/20 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-[30rem] h-[30rem] bg-cyan-500/20 rounded-full blur-[120px] pointer-events-none"></div>

    <!-- Kartu Utamanya (Anteng di Tengah, Anti-Geser, Tampilan Keren) -->
    <div class="max-w-md w-full text-center bg-slate-900/85 p-8 sm:p-10 rounded-3xl border border-purple-500/30 glow-box backdrop-blur-2xl relative z-10">
        
        <!-- Badge Status Gokil -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-purple-500/20 border border-purple-500/40 text-purple-300 text-xs font-extrabold tracking-wider uppercase mb-6 shadow-inner">
            <i class="fa-solid fa-bolt text-yellow-400 animate-bounce"></i> Mode Perbaikan Kilat
        </div>

        <!-- Ikon Animasi Lucu & Menarik -->
        <div class="relative w-24 h-24 mx-auto mb-6 flex items-center justify-center">
            <div class="w-full h-full bg-gradient-to-tr from-purple-600/30 to-pink-600/30 text-purple-300 rounded-3xl flex items-center justify-center border border-purple-400/40 shadow-xl shadow-purple-950/50">
                <i class="fa-solid fa-mug-hot text-4xl animate-goyang"></i>
            </div>
            <span class="absolute -top-1 -right-1 flex h-5 w-5">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-pink-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-5 w-5 bg-pink-500 items-center justify-center text-[10px]">✨</span>
            </span>
        </div>
        
        <!-- Judul Dinamis -->
        <h1 id="maintenance-title" class="text-xl sm:text-2xl font-extrabold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-pink-400 to-cyan-300 mb-3 uppercase">
            Sistem Lagi Minum Kopi ☕
        </h1>
        
        <!-- Pesan Penjelasan -->
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 px-1">
            Tenang kawan, data presensi aman sentosa! Server-nya cuma lagi diajak ngobrol sama tim IT biar makin ngebut pas kamu absen nanti.
        </p>

        <!-- Kotak Kata-Kata Otomatis Berubah (Bisa Diklik Buat Ganti Manual) -->
        <div onclick="randomizeMaintenanceText()" class="bg-slate-800/80 rounded-2xl p-4 border border-purple-500/20 mb-6 shadow-inner cursor-pointer hover:bg-slate-800 transition group" title="Klik buat ganti kata-kata!">
            <p id="quote-text" class="text-xs sm:text-sm text-yellow-300 font-semibold leading-relaxed">
                💡 Memuat kata-kata hari ini...
            </p>
            <span class="text-[10px] text-slate-400 mt-2 block group-hover:text-purple-300 transition italic">👆 (Klik kotak ini buat ganti alasan halu admin)</span>
        </div>

        <!-- Tombol Aksi -->
        <div class="pt-2 flex flex-col gap-3">
            <button onclick="location.reload()" class="w-full bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-extrabold text-xs sm:text-sm px-5 py-3 rounded-2xl transition duration-200 flex items-center justify-center gap-2 shadow-lg shadow-purple-900/40 cursor-pointer">
                <i class="fa-solid fa-arrows-rotate"></i> Coba Bangunin Server-nya Lagi!
            </button>
            <a href="/login" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs px-5 py-2.5 rounded-xl transition duration-200 border border-slate-700 flex items-center justify-center gap-2">
                <i class="fa-solid fa-user-shield text-pink-400"></i> Nyelonong Masuk Login Admin
            </a>
        </div>

        <!-- Catatan Kaki Kecil -->
        <div class="mt-6 pt-4 border-t border-slate-800 flex flex-col items-center gap-1 text-[10px] text-slate-400">
            <p class="font-medium">Sistem Presensi Digital Paling Santuy Se-Indonesia</p>
            <p>© <%= new Date().getFullYear() %> • Dibikin pake ❤️ dan kerokan angin</p>
        </div>
    </div>

    <!-- SKRIP OTOMATISASI KATA-KATA RANDOM -->
    <script>
        const quotes = [
            '☕ "Admin lagi nyari kabel LAN yang diputus kucing tetangga. Mohon bersabar."',
            '🤖 "Kecerdasan buatan sistem lagi cuti, diganti sama kecerdasan buatan warung kopi."',
            '🚀 "Lagi nambahin fitur jet pribadi buat siswa yang sering kesiangan kesekolah."',
            '💾 "Database-nya lagi masuk angin, dikerok dulu pake koin 500-an."',
            '🎯 "Sabar ya ges ya, nge-fix bug itu mirip nyari jarum di tumpukan jerami tapi jeraminya dibakar."',
            '🍕 "Tukang kodingnya lagi disogok pakai pizza dulu biar servernya mau nyala lagi."'
        ];

        const titles = [
            "Sistem Lagi 'Masuk Angin'!",
            "Server-nya Lagi Ngopi Dulu Bro!",
            "Lagi Renovasi Warung Kopi Digital!",
            "Sistem Istirahat Sejenak, Jangan Panik!"
        ];

        function randomizeMaintenanceText() {
            const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            const randomTitle = titles[Math.floor(Math.random() * titles.length)];

            document.getElementById('quote-text').innerHTML = `<i class="fa-solid fa-face-laugh-wink mr-1 text-yellow-400"></i> ${randomQuote}`;
            document.getElementById('maintenance-title').innerText = randomTitle;
        }

        // Jalankan saat halaman dimuat
        window.addEventListener('DOMContentLoaded', randomizeMaintenanceText);
    </script>
</body>
</html>
