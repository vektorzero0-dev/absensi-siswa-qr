<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pemeliharaan Sistem - Sistem Presensi Digital Sekolah</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome & Font Google -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        /* Animasi Latar Belakang Gradasi Halus */
        .bg-light-animated {
            background: linear-gradient(-45deg, #0f172a, #1e1b4b, #022c22, #09090b);
            background-size: 400% 400%;
            animation: gradientBG 12s ease infinite;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Efek Denyut Kilau Elegan */
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(1.15); }
        }
        .animate-glow { animation: pulseGlow 6s infinite ease-in-out; }

        /* Floating Icon Animasi */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-8px); }
        }
        .animate-float { animation: floatSlow 4s ease-in-out infinite; }
    </style>
</head>
<body class="bg-light-animated text-slate-100 min-h-screen flex items-center justify-center p-4 relative overflow-hidden select-none">
    
    <!-- Ornamen Lingkaran Glow Elegan di Latar Belakang -->
    <div class="absolute -top-32 -left-32 w-[30rem] h-[30rem] bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none animate-glow"></div>
    <div class="absolute -bottom-32 -right-32 w-[30rem] h-[30rem] bg-blue-500/10 rounded-full blur-[120px] pointer-events-none animate-glow" style="animation-delay: 3s;"></div>

    <!-- Kartu Konten Utama -->
    <div class="max-w-lg w-full text-center bg-slate-900/85 p-8 sm:p-10 rounded-3xl border border-slate-800/80 shadow-2xl backdrop-blur-2xl relative z-10 transition-all duration-300">
        
        <!-- Header Instansi / Sistem -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-[11px] font-bold tracking-wider uppercase mb-6">
            <i class="fa-solid fa-shield-halved"></i> Pemeliharaan Terjadwal
        </div>

        <!-- Ikon Animasi Utama (Gaya Profesional Pendidikan) -->
        <div class="relative w-24 h-24 mx-auto mb-6 animate-float">
            <div class="w-full h-full bg-gradient-to-tr from-emerald-600/20 to-blue-600/20 text-emerald-400 rounded-3xl flex items-center justify-center border border-emerald-500/30 shadow-xl shadow-emerald-950/50">
                <i class="fa-solid fa-screwdriver-wrench text-4xl"></i>
            </div>
            <!-- Titik Notifikasi Berdenyut -->
            <span class="absolute -top-1 -right-1 flex h-4 w-4">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500"></span>
            </span>
        </div>
        
        <!-- Judul Formal & Informatif -->
        <h1 id="maintenance-title" class="text-lg sm:text-xl font-extrabold tracking-wide text-slate-100 mb-3 uppercase">
            Pembaruan & Optimalisasi Sistem Presensi
        </h1>
        
        <!-- Pesan Penjelasan Ramah & Profesional -->
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 px-1">
            Mohon maaf atas ketidaknyamanannya. Saat ini tim pengembang sedang melakukan peningkatan performa infrastruktur server dan basis data demi kenyamanan layanan presensi warga satuan pendidikan.
        </p>

        <!-- Kotak Informasi Dinamis / Pesan Motivasi Akademik -->
        <div class="bg-slate-800/70 rounded-2xl p-3.5 border border-slate-700/60 mb-8 shadow-inner">
            <p id="quote-text" class="text-[11px] sm:text-xs text-emerald-300/90 font-medium leading-relaxed">
                <i class="fa-solid fa-circle-info mr-1"></i> Memuat informasi pemeliharaan...
            </p>
        </div>

        <!-- Tombol Aksi Navigasi -->
        <div class="pt-4 border-t border-slate-800/80 flex flex-col sm:flex-row justify-center gap-3">
            <button onclick="location.reload()" class="w-full sm:w-flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-5 py-3 rounded-xl transition-all duration-200 transform active:scale-95 flex items-center justify-center gap-2 shadow-lg shadow-emerald-900/30">
                <i class="fa-solid fa-rotate-right"></i> Periksa Status Sistem
            </button>
            <a href="/login" class="w-full sm:w-flex-1 bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-xs px-5 py-3 rounded-xl transition-all duration-200 border border-slate-700 flex items-center justify-center gap-2">
                <i class="fa-solid fa-user-shield text-slate-400"></i> Portal Masuk Admin
            </a>
        </div>

        <!-- Catatan Kaki Profesional -->
        <div class="mt-8 pt-4 border-t border-slate-800/50 flex flex-col items-center gap-1 text-[10px] text-slate-400">
            <p class="font-medium text-slate-400">Sistem Presensi Digital & Manajemen Rombel Terpadu</p>
            <p>© <%= new Date().getFullYear() %> Satuan Pendidikan • Layanan Berjalan Normal Segera</p>
        </div>
    </div>

    <!-- SKRIP KATA-KATA DINAMIS & PROFESIONAL -->
    <script>
        // Koleksi Informasi Pemeliharaan & Kutipan Akademik yang Elegan
        const quotes = [
            '💡 "Optimalisasi server berkala ini dilakukan untuk memastikan akurasi data kehadiran real-time."',
            '💡 "Peningkatan sistem keamanan data siswa & rekapitulasi bulanan sedang diproses."',
            '💡 "Terima kasih atas kesabaran Bapak/Ibu Guru serta Wali Murid selama proses pemeliharaan berlangsung."',
            '💡 "Pembaruan modul enkripsi presensi QR Code guna mempercepat proses pemindaian harian."',
            '💡 "Sistem akan segera kembali aktif dengan performa terbaiknya. Silakan muat ulang halaman secara berkala."'
        ];

        // Koleksi Judul Alternatif Formal & Menarik
        const titles = [
            "Pembaruan & Optimalisasi Sistem Presensi",
            "Pemeliharaan Infrastruktur Server Sekolah",
            "Peningkatan Performa Layanan Digital",
            "Pemeliharaan Terjadwal Basis Data"
        ];

        // Fungsi Memilih Teks Secara Acak Saat Dimuat
        function randomizeMaintenanceText() {
            const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            const randomTitle = titles[Math.floor(Math.random() * titles.length)];

            document.getElementById('quote-text').innerHTML = `<i class="fa-solid fa-circle-info mr-1 text-emerald-400"></i> ${randomQuote}`;
            document.getElementById('maintenance-title').innerText = randomTitle;
        }

        // Jalankan saat halaman dirender
        window.addEventListener('DOMContentLoaded', randomizeMaintenanceText);
    </script>
</body>
</html>
