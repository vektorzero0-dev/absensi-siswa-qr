<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lagi Modifikasi Mesin Waktu - Sistem Presensi</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome & Font Google -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Animasi Latar Belakang Gokil Berubah Warna */
        .bg-light-animated {
            background: linear-gradient(-45deg, #ff007f, #7928ca, #4f46e5, #06b6d4);
            background-size: 400% 400%;
            animation: gradientBG 8s ease infinite;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Efek Denyut Lebay di Background */
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.4; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.25); }
        }
        .animate-glow { animation: pulseGlow 3s infinite ease-in-out; }

        /* Animasi Khusus Ikon Doang (Kotak Luar Diam Total) */
        @keyframes shakeIcon {
            0%, 100% { transform: rotate(0deg); }
            20% { transform: rotate(-8deg) scale(1.05); }
            40% { transform: rotate(8deg) scale(1.05); }
            60% { transform: rotate(-5deg); }
            80% { transform: rotate(5deg); }
        }
        .animate-panik { animation: shakeIcon 0.8s ease-in-out infinite; }
    </style>
</head>
<body class="bg-light-animated text-white min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden select-none">
    
    <!-- Ornamen Lingkaran Glow Warnanya Asyik -->
    <div class="absolute -top-32 -left-32 w-[25rem] h-[25rem] bg-pink-500/30 rounded-full blur-[100px] pointer-events-none animate-glow"></div>
    <div class="absolute -bottom-32 -right-32 w-[25rem] h-[25rem] bg-yellow-400/30 rounded-full blur-[100px] pointer-events-none animate-glow" style="animation-delay: 1.5s;"></div>

    <!-- Kartu Konten Utama (Dikunci Posisinya Supaya Anti-Geser) -->
    <div class="max-w-md w-full text-center bg-slate-900/90 p-8 sm:p-10 rounded-3xl border border-white/20 shadow-2xl backdrop-blur-xl relative z-10 mx-auto my-auto" style="transform: translate3d(0,0,0);">
        
        <!-- Badge Status Kocak -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-pink-500/20 border border-pink-500/40 text-pink-300 text-xs font-extrabold tracking-wider uppercase mb-6 shadow-inner">
            <i class="fa-solid fa-mug-hot animate-bounce"></i> Admin Lagi Ngopi & Ngoding
        </div>

        <!-- Ikon Panik Goyang (Kotak Luar Diam, Ikon Dalam yang Panik) -->
        <div class="relative w-24 h-24 mx-auto mb-6 flex items-center justify-center">
            <div class="w-full h-full bg-gradient-to-tr from-yellow-500 to-pink-500 text-slate-950 rounded-3xl flex items-center justify-center border-2 border-white/40 shadow-2xl">
                <i class="fa-solid fa-laptop-code text-4xl animate-panik"></i>
            </div>
            <!-- Bintang Kejut Berdenyut -->
            <span class="absolute -top-2 -right-2 flex h-6 w-6">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-6 w-6 bg-yellow-500 items-center justify-center text-[10px] font-bold text-slate-950">⚠️</span>
            </span>
        </div>
        
        <!-- Judul Gokil -->
        <h1 id="maintenance-title" class="text-xl sm:text-2xl font-extrabold tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-pink-400 to-cyan-400 mb-3 uppercase">
            Sistem Lagi 'Masuk Angin'!
        </h1>
        
        <!-- Pesan Penjelasan Lucu -->
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 px-1">
            Tenang cuy, data siswa aman sentosa kok! Server-nya lagi diajak kompromi sama tim pengembang biar gak ngadat pas, silakan tarik napas sebentar ya.
        </p>

        <!-- Kotak Alasan Absurd (Bisa diganti-ganti lewat tombol) -->
        <div class="bg-slate-800/80 rounded-2xl p-4 border border-white/10 mb-6 shadow-inner cursor-pointer hover:bg-slate-800 transition" onclick="randomizeMaintenanceText()" title="Klik buat ganti alasan!">
            <p id="quote-text" class="text-xs sm:text-sm text-yellow-300 font-semibold leading-relaxed">
                <i class="fa-solid fa-face-laugh-wink mr-1"></i> Memuat alasan ngeles...
            </p>
            <span class="text-[10px] text-slate-400 mt-2 block italic">👆 (Klik kotak ini buat ganti alasan halu admin)</span>
        </div>

        <!-- Tombol Aksi Interaktif (Tanpa Efek Geser/Scale yang Merusak Layout) -->
        <div class="pt-2 flex flex-col gap-3">
            <button onclick="location.reload()" class="w-full bg-gradient-to-r from-emerald-500 to-cyan-500 hover:from-emerald-400 hover:to-cyan-400 text-slate-950 font-extrabold text-xs sm:text-sm px-5 py-3 rounded-2xl transition duration-200 flex items-center justify-center gap-2 shadow-lg shadow-cyan-500/30 cursor-pointer">
                <i class="fa-solid fa-arrows-rotate"></i> Coba Bangunin Server-nya Lagi!
            </button>
            <a href="/login" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs px-5 py-2.5 rounded-xl transition duration-200 border border-slate-700 flex items-center justify-center gap-2">
                <i class="fa-solid fa-key text-pink-400"></i> Nyelonong Masuk Login Admin
            </a>
        </div>

        <!-- Footer Santai -->
        <div class="mt-6 pt-4 border-t border-white/10 flex flex-col items-center gap-1 text-[10px] text-slate-400">
            <p class="font-medium">Sistem Presensi Digital Paling Santuy Se-Indonesia</p>
            <p>© <%= new Date().getFullYear() %> • Dibikin pake ❤️ dan kopi saset</p>
        </div>
    </div>

    <!-- SKRIP KATA-KATA KOCAK DINAMIS -->
    <script>
        const quotes = [
            '☕ "Admin lagi nyari kabel LAN yang dimakan kucing tetangga. Mohon bersabar."',
            '🤖 "Kecerdasan buatan sistem lagi cuti, diganti sama kecerdasan buatan warung kopi."',
            '🚀 "Lagi nambahin fitur jet pribadi buat siswa yang sering kesiangan kesekolah."',
            '💾 "Database-nya lagi masuk angin, dikerok dulu pake koin 500-an."',
            '🎯 "Sabar ya ges ya, nge-fix bug itu mirip nyari jarum di tumpukan jerami tapi jeraminya dibakar."',
            '🍕 "Tukang kodingnya lagi disogok pakai pizza dulu biar servernya mau nyala lagi."'
        ];

        const titles = [
            "Sistem Lagi 'Masuk Angin'!",
            "Server-nya Lagi Ngopi Dulu Bro!",
            "Lagi Renovasi Warung Kopi Digital!",
            "Sistem Istirahat Sejenak, Jangan Panik!"
        ];

        function randomizeMaintenanceText() {
            const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            const randomTitle = titles[Math.floor(Math.random() * titles.length)];

            document.getElementById('quote-text').innerHTML = `<i class="fa-solid fa-face-laugh-wink mr-1 text-yellow-400"></i> ${randomQuote}`;
            document.getElementById('maintenance-title').innerText = randomTitle;
        }

        // Jalankan saat pertama kali buka
        window.addEventListener('DOMContentLoaded', randomizeMaintenanceText);
    </script>
</body>
</html>
