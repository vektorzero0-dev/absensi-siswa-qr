<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Sedang Rehat Sejenak ☕</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome & Font Google -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 relative overflow-hidden select-none">
    
    <!-- Ornamen Lingkaran Glow di Latar Belakang -->
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Kartu Utamanya -->
    <div class="max-w-md w-full text-center bg-slate-900/80 p-8 rounded-3xl border border-slate-800 shadow-2xl backdrop-blur-xl relative z-10">
        
        <!-- Ikon Animasi Lucu & Menarik -->
        <div class="relative w-24 h-24 mx-auto mb-6">
            <div class="w-full h-full bg-amber-500/15 text-amber-400 rounded-2xl flex items-center justify-center border border-amber-500/30 shadow-lg shadow-amber-500/10">
                <i class="fa-solid fa-mug-hot text-4xl animate-bounce"></i>
            </div>
            <span class="absolute -top-1 -right-1 flex h-4 w-4">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-4 w-4 bg-amber-500"></span>
            </span>
        </div>
        
        <!-- Judul Dinamis -->
        <h1 id="maintenance-title" class="text-xl font-extrabold tracking-wide text-amber-400 mb-2 uppercase">
            Sistem Lagi Minum Kopi ☕
        </h1>
        
        <!-- Pesan Penjelasan -->
        <p class="text-xs text-slate-300 leading-relaxed mb-4 px-2">
            Tenang, tidak ada yang rusak kok! Aplikasi presensi cuma sedang rehat sejenak untuk pemeliharaan rutin dan servis mesin supaya makin ngebut saat dipakai nanti.
        </p>

        <!-- Kotak Kata-Kata Otomatis Berubah (Random Quote) -->
        <div class="bg-slate-800/60 rounded-2xl p-3 border border-slate-700/50 mb-6 transition-all duration-300">
            <p id="quote-text" class="text-[11px] text-amber-300/90 italic font-medium">
                💡 Memuat kata-kata hari ini...
            </p>
        </div>

        <!-- Tombol Aksi -->
        <div class="pt-2 border-t border-slate-800 flex flex-col sm:flex-row justify-center gap-3">
            <button onclick="location.reload()" class="w-full sm:w-auto bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs px-5 py-3 rounded-xl transition-all duration-200 transform active:scale-95 flex items-center justify-center gap-2 shadow-lg shadow-amber-500/20">
                <i class="fa-solid fa-rotate-right"></i> Coba Cek Lagi
            </button>
            <a href="/login" class="w-full sm:w-auto bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs px-5 py-3 rounded-xl transition-all duration-200 border border-slate-700 flex items-center justify-center gap-2">
                <i class="fa-solid fa-user-shield text-slate-400"></i> Login Admin
            </a>
        </div>

        <!-- Catatan Kaki Kecil -->
        <p class="text-[10px] text-slate-500 mt-6">
            Sistem Presensi Multi-Tenant • Terima kasih sudah bersabar ya! 😊
        </p>
    </div>

    <!-- SKRIP OTOMATISASI KATA-KATA RANDOM -->
    <script>
        // Koleksi Kata-Kata Lucu, Warm, dan Bikin Senyum
        const quotes = [
            '💡 "Sama seperti kita yang butuh teh hangat di pagi hari, sistem juga butuh perawatan sejenak."',
            '💡 "Sedang mengencangkan baut-baut kodenya biar makin cepat pas dipake presensi!"',
            '💡 "Sabar ya! Hal-hal hebat butuh sedikit waktu untuk dipersiapkan."',
            '💡 "Sistemnya lagi stretching dulu nih, biar pas kamu pakai gak kena kram!"',
            '💡 "Aplikasi lagi cuci muka dulu biar tampil lebih fresh dan makin ganteng."',
            '💡 "Jangan lupa minum air putih dan tersenyum hari ini ya! Pemeliharaan takkan lama kok."',
            '💡 "Sedang membersihkan debu-debu server supaya presensi kamu makin lancar jaya!"'
        ];

        // Koleksi Variasi Judul Seru
        const titles = [
            "Sistem Lagi Minum Kopi ☕",
            "Mesin Lagi Di-Servis 🛠️",
            "Sistem Sedang Rehat Sejenak 🧘",
            "Lagi Ganti Oli Server 🏎️",
            "Sedang Bersolek Sejenak ✨"
        ];

        // Fungsi Memilih Kata-Kata Acak
        function randomizeMaintenanceText() {
            const randomQuote = quotes[Math.floor(Math.random() * quotes.length)];
            const randomTitle = titles[Math.floor(Math.random() * titles.length)];

            document.getElementById('quote-text').innerText = randomQuote;
            document.getElementById('maintenance-title').innerText = randomTitle;
        }

        // Jalankan saat halaman dimuat
        window.addEventListener('DOMContentLoaded', randomizeMaintenanceText);
    </script>
</body>
</html>
