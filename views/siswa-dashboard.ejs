<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dasbor Siswa - Sistem Presensi Digital</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

    <!-- Header Dasbor Siswa -->
    <header class="bg-emerald-800 text-white shadow-md border-b-4 border-amber-500">
        <div class="max-w-4xl mx-auto px-4 py-3.5 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="bg-white/10 p-2.5 rounded-xl border border-white/20">
                    <i class="fa-solid fa-user-graduate text-xl text-amber-400"></i>
                </div>
                <div>
                    <h1 class="text-sm font-extrabold uppercase tracking-wide">Portal Siswa</h1>
                    <p class="text-[11px] text-emerald-200">Monitoring Kehadiran & Nilai Akademik Siswa</p>
                </div>
            </div>
            
            <a href="/siswa/logout" class="bg-rose-700 hover:bg-rose-800 text-white text-xs px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm font-semibold">
                <i class="fa-solid fa-right-from-bracket"></i> Keluar
            </a>
        </div>
    </header>

    <main class="max-w-4xl mx-auto w-full p-4 flex-1 space-y-4">

        <!-- PILIH AKUN SISWA (Jika terdeteksi lebih dari satu akun) -->
        <% if (daftarAnak && daftarAnak.length > 1) { %>
            <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <span class="text-xs font-bold text-slate-700">
                    <i class="fa-solid fa-users text-emerald-600 mr-1"></i> Pilih Akun Siswa:
                </span>
                <div class="flex flex-wrap gap-2">
                    <% daftarAnak.forEach(anak => { %>
                        <a href="/siswa/dashboard?siswa_id=<%= anak.id %>&bulan=<%= bulanPilihan %>" 
                           class="text-xs px-3.5 py-2 rounded-xl font-bold transition border <%= anak.id === siswaAktif.id ? 'bg-emerald-700 text-white border-emerald-700 shadow-md' : 'bg-slate-50 text-slate-700 border-slate-300 hover:bg-slate-100' %>">
                            <%= anak.nama %> (<%= anak.nama_kelas %>)
                        </a>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <!-- PROFIL SISWA & FILTER BULAN -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
            <div class="flex items-center gap-3.5">
                <div class="bg-emerald-100 text-emerald-800 p-3.5 rounded-2xl border border-emerald-200">
                    <i class="fa-solid fa-user text-2xl"></i>
                </div>
                <div>
                    <span class="text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded font-bold uppercase">Status: Aktif</span>
                    <h2 class="text-base font-black text-slate-900 mt-0.5"><%= siswaAktif.nama %></h2>
                    <p class="text-xs text-slate-500 font-medium">Kelas: <strong class="text-slate-700"><%= siswaAktif.nama_kelas %></strong> | Sekolah: <strong class="text-slate-700"><%= siswaAktif.nama_sekolah %></strong></p>
                </div>
            </div>

            <!-- Form Pilih Bulan -->
            <form method="GET" action="/siswa/dashboard" class="flex items-center gap-2 w-full md:w-auto">
                <input type="hidden" name="siswa_id" value="<%= siswaAktif.id %>">
                <input type="month" name="bulan" value="<%= bulanPilihan %>" 
                    class="bg-slate-50 border border-slate-300 text-slate-800 text-xs font-semibold rounded-xl px-3 py-2.5 focus:outline-none focus:border-emerald-600">
                <button type="submit" class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow transition">
                    <i class="fa-solid fa-filter mr-1"></i> Filter
                </button>
            </form>
        </div>

        <!-- BANNER PORTAL AKADEMIK TAMBAHAN (MUNCUL LANGSUNG TANPA SYARAT) -->
        <div class="bg-gradient-to-r from-purple-900 via-indigo-900 to-slate-900 text-white rounded-3xl p-6 shadow-xl border border-purple-700 flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="flex items-center gap-4">
                <div class="bg-amber-400 text-slate-900 p-4 rounded-2xl shadow-md text-2xl font-black">
                    <i class="fa-solid fa-rocket"></i>
                </div>
                <div>
                    <span class="bg-amber-400/20 text-amber-300 font-bold text-[10px] uppercase px-3 py-1 rounded-full border border-amber-400/30">
                        <i class="fa-solid fa-bolt mr-1"></i> Portal Tambahan
                    </span>
                    <h3 class="text-lg font-black mt-1">Portal Akademik Pembelajaran</h3>
                    <p class="text-xs text-purple-200">Akses cepat menuju sistem dan portal pembelajaran tambahan.</p>
                </div>
            </div>
            
            <div class="w-full md:w-auto">
                <a href="https://vektorzero.pythonanywhere.com/" target="_blank" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-black text-xs px-6 py-3.5 rounded-2xl shadow-lg transition flex items-center justify-center gap-2">
                    <i class="fa-solid fa-globe text-sm"></i> Buka Portal PythonAnywhere
                </a>
            </div>
        </div>

        <!-- KARTU STATISTIK KEHADIRAN BULAN INI -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 shadow-sm text-center">
                <span class="text-[11px] font-bold text-emerald-800 uppercase block mb-1">Hadir</span>
                <span class="text-2xl font-black text-emerald-700"><%= rekapStat.HADIR %></span>
            </div>
            <div class="bg-blue-50 border border-blue-200 rounded-2xl p-4 shadow-sm text-center">
                <span class="text-[11px] font-bold text-blue-800 uppercase block mb-1">Sakit</span>
                <span class="text-2xl font-black text-blue-700"><%= rekapStat.SAKIT %></span>
            </div>
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 shadow-sm text-center">
                <span class="text-[11px] font-bold text-amber-800 uppercase block mb-1">Izin</span>
                <span class="text-2xl font-black text-amber-700"><%= rekapStat.IZIN %></span>
            </div>
            <div class="bg-rose-50 border border-rose-200 rounded-2xl p-4 shadow-sm text-center">
                <span class="text-[11px] font-bold text-rose-800 uppercase block mb-1">Alpa</span>
                <span class="text-2xl font-black text-rose-700"><%= rekapStat.ALPA %></span>
            </div>
        </div>

        <!-- TABEL RIWAYAT KEHADIRAN -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wide">
                    <i class="fa-solid fa-clock-rotate-left text-emerald-600 mr-1.5"></i> Riwayat Absensi Bulan: <%= bulanPilihan %>
                </h3>
                <span class="text-[11px] text-slate-500 font-medium">Total Log: <%= absensiList.length %> catatan</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-100 text-slate-600 uppercase font-bold text-[10px] tracking-wider">
                        <tr>
                            <th class="p-3">Tanggal</th>
                            <th class="p-3">Jam</th>
                            <th class="p-3">Sesi / Tipe</th>
                            <th class="p-3">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (absensiList.length === 0) { %>
                            <tr>
                                <td colspan="4" class="p-6 text-center text-slate-500 italic">
                                    Belum ada catatan riwayat presensi pada bulan ini.
                                </td>
                            </tr>
                        <% } else { %>
                            <% absensiList.forEach(item => { %>
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="p-3 font-mono font-medium text-slate-700"><%= item.tanggal_formatted %></td>
                                    <td class="p-3 font-mono text-slate-600"><%= item.jam_formatted %></td>
                                    <td class="p-3 font-semibold text-slate-700"><%= item.tipe || 'MASUK' %></td>
                                    <td class="p-3">
                                        <% 
                                            let badgeClass = 'bg-slate-100 text-slate-700 border-slate-200';
                                            if (item.status.toUpperCase() === 'HADIR') badgeClass = 'bg-emerald-100 text-emerald-800 border-emerald-200';
                                            else if (item.status.toUpperCase() === 'SAKIT') badgeClass = 'bg-blue-100 text-blue-800 border-blue-200';
                                            else if (item.status.toUpperCase() === 'IZIN') badgeClass = 'bg-amber-100 text-amber-800 border-amber-200';
                                            else if (item.status.toUpperCase() === 'ALPA') badgeClass = 'bg-rose-100 text-rose-800 border-rose-200';
                                        %>
                                        <span class="px-2.5 py-1 rounded-lg border text-[10px] font-bold uppercase <%= badgeClass %>">
                                            <%= item.status %>
                                        </span>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TABEL NILAI MATA PELAJARAN DARI GURU MAPEL -->
        <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden mt-6">
            <div class="p-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wide">
                    <i class="fa-solid fa-book-open text-emerald-600 mr-1.5"></i> Daftar Nilai Mata Pelajaran
                </h3>
                <span class="text-[11px] text-slate-500 font-medium">Total: <%= nilaiList ? nilaiList.length : 0 %> Mapel</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-100 text-slate-600 uppercase font-bold text-[10px] tracking-wider">
                        <tr>
                            <th class="p-3">Mata Pelajaran</th>
                            <th class="p-3">Jenjang</th>
                            <th class="p-3">Semester</th>
                            <th class="p-3 text-center">Nilai Angka</th>
                            <th class="p-3 text-center">Predikat</th>
                            <th class="p-3">Catatan Guru</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (!nilaiList || nilaiList.length === 0) { %>
                            <tr>
                                <td colspan="6" class="p-6 text-center text-slate-500 italic">
                                    Belum ada catatan nilai mata pelajaran yang diinput oleh guru.
                                </td>
                            </tr>
                        <% } else { %>
                            <% nilaiList.forEach(item => { %>
                                <tr class="hover:bg-slate-50 transition">
                                    <td class="p-3 font-bold text-slate-800"><%= item.mata_pelajaran %></td>
                                    <td class="p-3 text-slate-600"><%= item.jenjang %></td>
                                    <td class="p-3 text-slate-600"><%= item.semester %></td>
                                    <td class="p-3 text-center font-mono font-black text-emerald-700 text-sm"><%= item.nilai_angka %></td>
                                    <td class="p-3 text-center">
                                        <span class="px-2.5 py-1 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-lg text-[10px] font-bold">
                                            <%= item.predikat || '-' %>
                                        </span>
                                    </td>
                                    <td class="p-3 text-slate-600 italic"><%= item.catatan || 'Tidak ada catatan' %></td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <footer class="bg-white border-t border-slate-200 py-3 text-center text-[11px] text-slate-600 mt-6">
        <p>&copy; <%= new Date().getFullYear() %> Sistem Presensi QR Code.</p>
        <p class="mt-0.5 text-slate-400">Pengembang Sistem: <strong class="text-slate-600">Zeeo</strong> | Bantuan Teknis (WhatsApp): <a href="https://wa.me/6282371729760" target="_blank" class="text-emerald-700 font-medium hover:underline">0823-7172-9760</a></p>
    </footer>

</body>
</html>
