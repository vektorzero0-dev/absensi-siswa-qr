<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Administrator - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    
    <!-- CSS Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <!-- CSS Pendukung -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        body { font-family: 'Plus Jakarta Sans', sans-serif; }

        .offcanvas { z-index: 1055 !important; }
        .offcanvas-backdrop { z-index: 1050 !important; }

        /* LATAR BELAKANG TERANG BERANIMASI DENGAN PATTERN */
        .bg-light-animated {
            background: linear-gradient(-45deg, #e0f2fe, #f0fdf4, #fef3c7, #f1f5f9);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            background-image: 
                radial-gradient(rgba(15, 23, 42, 0.05) 1.2px, transparent 1.2px),
                linear-gradient(-45deg, #e0f2fe, #f0fdf4, #fef3c7, #e2e8f0);
            background-size: 20px 20px, 400% 400%;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Scrollbar Halus */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

        @keyframes pulseGlow {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.2); }
        }
        .animate-glow { animation: pulseGlow 5s infinite ease-in-out; }

        /* KARTU PRO DENGAN TEMA WARNA & HOVER EFFECT */
        .card-pro {
            position: relative;
            overflow: hidden;
            border-radius: 1.25rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .card-pro::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: radial-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px);
            background-size: 14px 14px;
            pointer-events: none;
        }

        .card-pro:hover {
            transform: translateY(-4px) scale(1.005);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.12);
        }

        .card-amber-theme {
            background: linear-gradient(135deg, #ffffff 0%, #fffbeb 100%);
            border: 1px solid #fde68a;
        }
        .card-emerald-theme {
            background: linear-gradient(135deg, #ffffff 0%, #ecfdf5 100%);
            border: 1px solid #a7f3d0;
        }
        .card-blue-theme {
            background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%);
            border: 1px solid #bfdbfe;
        }
        .card-purple-theme {
            background: linear-gradient(135deg, #ffffff 0%, #faf5ff 100%);
            border: 1px solid #e9d5ff;
        }

        @keyframes fadeInSoft {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fadeInSoft 0.4s ease-out forwards; }

        button, .btn-interactive { transition: all 0.2s ease-in-out; }
        button:active, .btn-interactive:active { transform: scale(0.96); }
    </style>
</head>
<body class="bg-light-animated text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

<!-- NAVBAR HEADER ATAS -->
<nav class="bg-slate-900/90 backdrop-blur-md text-white sticky top-0 z-30 shadow-md px-4 py-3 flex items-center justify-between border-b border-amber-500/50">
  <div class="flex items-center gap-3">
    <button type="button" onclick="bukaSidebar()" class="btn-interactive bg-blue-800 hover:bg-blue-700 text-white px-3 py-1.5 rounded-xl border border-blue-600 font-bold text-xs flex items-center gap-2 transition shadow-sm">
      <i class="fa-solid fa-bars text-sm"></i> <span>Menu</span>
    </button>
    
    <span class="font-bold text-xs sm:text-sm tracking-wide text-amber-400 uppercase truncate">
      UPTD SD NEGERI 1 KARYA MULYA SARI
    </span>
  </div>

  <div class="text-xs text-slate-300 hidden sm:block">
    <i class="fa-solid fa-user-shield text-amber-400 mr-1"></i> Admin Panel
  </div>
</nav>

<!-- SIDEBAR SLIDE ADMIN -->
<div id="sidebarMenu" class="fixed top-0 left-0 h-full w-[260px] bg-white text-slate-800 shadow-2xl z-50 transition-all duration-300 -translate-x-full flex flex-col justify-between border-r border-slate-200">
  <div>
    <div class="bg-slate-900 text-white p-4 flex justify-between items-center border-b border-slate-800">
      <h5 class="font-bold text-xs uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid fa-shield-halved text-amber-400"></i> Menu Navigasi
      </h5>
      <button type="button" onclick="tutupSidebar()" class="text-slate-400 hover:text-white text-lg font-bold px-2">
        &times;
      </button>
    </div>
    
    <div class="p-2 space-y-1 text-xs">
      <a href="/admin?userId=<%= userId %>" class="flex items-center gap-3 p-3 font-semibold bg-blue-50 text-blue-900 rounded-xl">
        <i class="fa-solid fa-house text-blue-700"></i> Dashboard Utama
      </a>
      <a href="/scan?userId=<%= userId %>" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-qrcode text-emerald-600"></i> Pemindai QR Presensi
      </a>
      <a href="/admin/cetak-kartu" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-address-card text-purple-600"></i> Cetak Kartu Siswa
      </a>
      <a href="#section-wa-gateway" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-brands fa-whatsapp text-emerald-600"></i> Integrasi WhatsApp
      </a>
      <a href="#section-dapodik" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-file-excel text-emerald-600"></i> Impor Excel Dapodik
      </a>
      <a href="#section-rombel" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-school text-purple-600"></i> Kelola Rombel & Guru
      </a>
      <a href="#section-siswa" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-users text-blue-600"></i> Direktori Siswa
      </a>
      <a href="#section-presensi" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-clipboard-check text-amber-600"></i> Presensi Hari Ini
      </a>
    </div>
  </div>

  <div class="p-4 border-t border-slate-100">
    <a href="/" class="flex items-center justify-center gap-2 w-full bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs py-2.5 rounded-xl transition">
      <i class="fa-solid fa-right-from-bracket"></i> Keluar (Logout)
    </a>
  </div>
</div>

<div id="sidebarOverlay" onclick="tutupSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden transition-opacity backdrop-blur-xs"></div>

    <!-- HEADER RESMI SEKOLAH BERANIMASI -->
    <header class="bg-gradient-to-r from-blue-900 via-slate-900 to-indigo-900 text-white shadow-lg border-b-4 border-amber-500 relative overflow-hidden">
        <div class="absolute -top-12 left-1/4 w-48 h-48 bg-blue-500/20 rounded-full blur-3xl animate-glow pointer-events-none"></div>
        <div class="absolute -bottom-10 right-10 w-36 h-36 bg-amber-400/20 rounded-full blur-3xl animate-glow pointer-events-none" style="animation-delay: 2.5s;"></div>

        <div class="max-w-6xl mx-auto px-4 py-3.5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 relative z-10">
            <div class="flex items-center gap-3">
                <div class="bg-gradient-to-tr from-amber-500 to-amber-300 p-2 rounded-xl text-slate-950 shadow-md">
                    <i class="fa-solid fa-graduation-cap text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-sm md:text-base font-extrabold tracking-wide uppercase text-slate-100">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                    <p class="text-[11px] text-blue-200">Panel Kelola Administrator Sistem Presensi</p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="btn-interactive flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-3.5 py-2 rounded-xl shadow transition flex items-center gap-1.5">
                    <i class="fa-solid fa-qrcode text-sm"></i> Pemindai Presensi (Scanner)
                </a>
                <a href="/" class="btn-interactive bg-slate-800/80 hover:bg-slate-700 text-slate-200 text-xs px-3 py-2 rounded-xl border border-slate-700 transition flex items-center gap-1">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto w-full p-4 md:p-6 flex-1 animate-fade-in">

        <!-- KOTAK BANNER PROFIL (AMBER THEME) -->
        <div class="card-pro card-amber-theme p-4 mb-6 flex items-center justify-between">
            <div class="flex items-center gap-3 relative z-10">
                <div class="bg-amber-600 text-white p-3 rounded-xl shadow-md">
                    <i class="fa-solid fa-user-shield text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 rounded uppercase tracking-wider">Hak Akses: Administrator</span>
                    <h2 class="text-base font-bold text-slate-900 mt-0.5">Dashboard Pengelolaan Data Terpadu</h2>
                </div>
            </div>
        </div>

        <!-- METRIC SUMMARY CARDS WITH INDIVIDUAL COLOR THEMES -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div class="card-pro card-blue-theme p-4 flex items-center justify-between">
                <div class="relative z-10">
                    <p class="text-xs text-slate-600 font-medium">Total Akun Pengguna Guru</p>
                    <h3 class="text-xl font-bold text-slate-900 mt-1"><%= users.length %> <span class="text-xs font-normal text-slate-500">Personel</span></h3>
                </div>
                <div class="bg-blue-600 text-white p-3 rounded-xl relative z-10 shadow-md">
                    <i class="fa-solid fa-users text-lg"></i>
                </div>
            </div>

            <div class="card-pro card-emerald-theme p-4 flex items-center justify-between">
                <div class="relative z-10">
                    <p class="text-xs text-slate-600 font-medium">Total Peserta Didik</p>
                    <h3 class="text-xl font-bold text-emerald-800 mt-1"><%= siswa.length %> <span class="text-xs font-normal text-slate-500">Siswa</span></h3>
                </div>
                <div class="bg-emerald-600 text-white p-3 rounded-xl relative z-10 shadow-md">
                    <i class="fa-solid fa-user-graduate text-lg"></i>
                </div>
            </div>

            <div class="card-pro card-purple-theme p-4 flex items-center justify-between">
                <div class="relative z-10">
                    <p class="text-xs text-slate-600 font-medium">Rombongan Belajar (Rombel)</p>
                    <h3 class="text-xl font-bold text-purple-900 mt-1"><%= kelas.length %> <span class="text-xs font-normal text-slate-500">Kelas</span></h3>
                </div>
                <div class="bg-purple-600 text-white p-3 rounded-xl relative z-10 shadow-md">
                    <i class="fa-solid fa-school text-lg"></i>
                </div>
            </div>
        </div>

        <!-- KOTAK INTEGRASI WA ADMIN (DISESUAIKAN DENGAN STRUKTUR DASHBOARD WALI) -->
        <div id="section-wa-gateway" class="card-pro card-emerald-theme p-5 mb-6 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 relative z-10">
                <div class="p-3 rounded-xl bg-emerald-600 text-white shadow-md">
                    <i class="fa-brands fa-whatsapp text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Status WhatsApp Gateway Admin Utama</h3>
                    <p class="text-xs text-slate-600 mt-0.5" id="waStatusText">
                        Koneksi Layanan: <span class="text-slate-500 font-bold">Memeriksa status...</span>
                    </p>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto relative z-10">
                <!-- KOTAK TAMPILAN QR -->
                <div id="qrContainer" class="hidden bg-white p-1.5 rounded-xl shadow border border-slate-300 flex flex-col items-center">
                    <img id="qrImageWA" src="" alt="Scan QR WA" class="w-28 h-28">
                    <span class="text-[9px] text-slate-500 mt-1 font-mono">Pindai dengan WA</span>
                </div>

                <!-- KOTAK TAMPILAN PAIRING CODE -->
                <div id="pairingContainer" class="hidden bg-blue-50 p-3 rounded-xl border border-blue-200 text-center min-w-[200px]">
                    <span class="text-[10px] text-blue-800 font-medium block">Kode Tautan WhatsApp Anda:</span>
                    <strong id="pairingCodeText" class="text-xl font-mono text-blue-900 tracking-widest my-1 block">-</strong>
                    <span class="text-[9px] text-blue-700 block">Masukkan di WA HP (Tautkan dg nomor)</span>
                </div>

                <!-- TOMBOL-TOMBOL AKSI -->
                <div class="flex flex-wrap gap-2 w-full sm:w-auto justify-end">
                    <button type="button" onclick="mintaQRWA()" id="btnGenerateWA" class="btn-interactive bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3.5 py-2.5 rounded-xl border border-emerald-700 font-semibold transition flex items-center gap-1.5 shadow-md">
                        <i class="fa-solid fa-qrcode"></i> Scan QR
                    </button>

                    <button type="button" onclick="mintaPairingWA()" id="btnPairingWA" class="btn-interactive bg-blue-800 hover:bg-blue-900 text-white text-xs px-3.5 py-2.5 rounded-xl border border-blue-900 font-semibold transition flex items-center gap-1.5 shadow-md">
                        <i class="fa-solid fa-mobile-screen-button"></i> Pakai Nomor WA
                    </button>

                    <button type="button" onclick="resetWA()" id="btnResetWA" class="btn-interactive bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs px-3 py-2.5 rounded-xl border border-rose-200 font-semibold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-trash"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- KOTAK IMPOR DAPODIK (EMERALD THEME) -->
        <div id="section-dapodik" class="card-pro card-emerald-theme p-5 mb-6">
            <div class="flex items-center gap-3 mb-3 border-b border-emerald-200/60 pb-2 relative z-10">
                <div class="bg-emerald-600 text-white p-2.5 rounded-xl shadow-md">
                    <i class="fa-solid fa-file-excel text-lg"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Impor Massal Data Siswa (Format Dapodik/Excel)</h3>
                    <p class="text-[11px] text-slate-600">Unggah berkas rekap Excel (.xlsx / .csv) dari Dapodik untuk menambahkan siswa & rombel secara otomatis.</p>
                </div>
            </div>

            <form id="formImportExcel" onsubmit="prosesImportExcel(event)" class="flex flex-col sm:flex-row items-center gap-3 relative z-10">
                <input type="file" id="fileExcelInput" accept=".xlsx, .xls, .csv" required class="flex-1 text-xs text-slate-700 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-100 file:text-emerald-800 hover:file:bg-emerald-200 border border-emerald-300 rounded-xl p-1 w-full bg-white">
                
                <button type="submit" id="btnImportExcel" class="btn-interactive w-full sm:w-auto bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5 border border-emerald-800 whitespace-nowrap shadow-md">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload & Impor Data
                </button>
            </form>
        </div>

        <!-- KOTAK FORM TAMBAH ROMBEL & GURU -->
        <div id="section-rombel" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            
            <!-- FORM ROMBEL (PURPLE THEME) -->
            <div class="card-pro card-purple-theme p-5">
                <div class="flex justify-between items-center border-b border-purple-200/60 pb-2 mb-4 relative z-10">
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-plus-circle text-purple-700"></i> Rombongan Belajar
                    </h3>
                    
                    <% if (kelas && kelas.length > 0) { %>
                        <form action="/api/kelas/hapus-semua" method="POST" onsubmit="return confirm('HAPUS SELURUH ROMBEL?\n\nSemua rombel ganda akan dibersihkan.');">
                            <button type="submit" class="bg-rose-50 hover:bg-rose-100 text-rose-700 text-[10px] font-bold px-2.5 py-1 rounded-lg border border-rose-200 transition flex items-center gap-1">
                                <i class="fa-solid fa-trash-can text-rose-600"></i> Kosongkan Semua Rombel
                            </button>
                        </form>
                    <% } %>
                </div>

                <form action="/api/kelas/tambah" method="POST" class="flex gap-2 relative z-10">
                    <input type="text" name="nama_kelas" required placeholder="Contoh: Kelas 1A" class="flex-1 bg-white border border-purple-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-600">
                    <button type="submit" class="btn-interactive bg-purple-700 hover:bg-purple-800 text-white font-semibold text-xs px-4 py-2 rounded-xl transition shadow-md">Simpan</button>
                </form>

                <div class="mt-4 flex flex-wrap gap-2 relative z-10">
                    <% if (kelas && kelas.length > 0) { %>
                        <% kelas.forEach(k => { %>
                            <span class="bg-purple-100 text-purple-900 border border-purple-300 text-[10px] font-bold px-2.5 py-1 rounded-lg flex items-center gap-1.5">
                                <%= k.nama_kelas %>
                                <form action="/api/kelas/hapus/<%= k.id %>" method="POST" onsubmit="return confirm('Hapus rombel <%= k.nama_kelas %>?');" class="inline">
                                    <button type="submit" class="text-purple-400 hover:text-rose-600 font-bold ml-1 text-xs">
                                        &times;
                                    </button>
                                </form>
                            </span>
                        <% }); %>
                    <% } else { %>
                        <p class="text-[11px] text-slate-400 italic">Belum ada rombel terdaftar.</p>
                    <% } %>
                </div>
            </div>

            <!-- FORM GURU (BLUE THEME) -->
            <div class="card-pro card-blue-theme p-5">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-blue-200/60 pb-2 relative z-10">
                    <i class="fa-solid fa-user-plus text-blue-700"></i> Registrasi Akun Wali Kelas / Guru
                </h3>
                <form action="/api/guru/tambah" method="POST" class="space-y-3 relative z-10">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" name="nama" required placeholder="Nama Lengkap Tenaga Pendidik" class="bg-white border border-blue-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                        <input type="text" name="username" required placeholder="Nama Pengguna (Username)" class="bg-white border border-blue-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="password" name="password" required placeholder="Kata Sandi" class="bg-white border border-blue-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                        <select name="kelas_id" class="bg-white border border-blue-300 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-600">
                            <option value="">-- Penugasan Rombel --</option>
                            <% kelas.forEach(k => { %>
                                <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" class="btn-interactive w-full bg-blue-900 hover:bg-blue-800 text-white font-semibold text-xs py-2.5 rounded-xl transition shadow-md">
                        Daftarkan Pengguna Baru
                    </button>
                </form>
            </div>
        </div>

        <!-- KOTAK REGISTRASI SISWA MANUAL (AMBER THEME) -->
        <div class="card-pro card-amber-theme p-5 mb-6">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-amber-200/60 pb-2 relative z-10">
                <i class="fa-solid fa-address-card text-amber-700"></i> Registrasi Peserta Didik Baru (Manual)
            </h3>
            <form action="/api/siswa/tambah" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-3 relative z-10">
                <input type="text" name="nama" required placeholder="Nama Lengkap Siswa" class="bg-white border border-amber-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-600">
                <input type="text" name="nomor_wa_ortu" placeholder="No. WhatsApp Orang Tua (Contoh: 082371729760)" class="bg-white border border-amber-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-600">
                <div class="flex gap-2">
                    <select name="kelas_id" required class="flex-1 bg-white border border-amber-300 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-amber-600">
                        <option value="">-- Pilih Rombel Kelas --</option>
                        <% kelas.forEach(k => { %>
                            <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                        <% }); %>
                    </select>
