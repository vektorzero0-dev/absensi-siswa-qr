<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Sistem Absensi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between font-sans selection:bg-cyan-500 selection:text-black">

    <div>
        <nav class="bg-slate-900/80 backdrop-blur-md border-b border-slate-800 sticky top-0 z-50">
            <div class="max-w-6xl mx-auto px-4 py-4 flex justify-between items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-cyan-950 border border-cyan-500/40 text-cyan-400 rounded-xl flex items-center justify-center font-bold">
                        <i class="fa-solid fa-user-gear"></i>
                    </div>
                    <div>
                        <h2 class="font-bold text-white text-base">Dashboard Administrator</h2>
                        <p class="text-xs text-cyan-400 font-mono">Monitoring & Control System</p>
                    </div>
                </div>
                <a href="/" class="text-xs font-semibold text-rose-400 hover:text-white bg-rose-950/40 hover:bg-rose-600 px-4 py-2.5 rounded-xl border border-rose-800/50 transition">
                    <i class="fa-solid fa-power-off mr-1"></i> Logout
                </a>
            </div>
        </nav>

        <div class="max-w-6xl mx-auto px-4 mt-8 space-y-8">
            <!-- Tabel Log Absensi Hari Ini -->
            <div class="bg-slate-900/90 rounded-2xl p-6 border border-slate-800 shadow-2xl">
                <h3 class="font-bold text-lg text-white mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-cyan-400"></i> Log Kehadiran Hari Ini
                </h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs font-mono">
                        <thead class="bg-slate-950 text-cyan-400 uppercase border-b border-slate-800">
                            <tr>
                                <th class="p-3">Waktu</th>
                                <th class="p-3">Nama Siswa</th>
                                <th class="p-3">Kelas</th>
                                <th class="p-3">Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800/60 text-slate-300">
                            <% if (absensi.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="p-4 text-center text-slate-500">Belum ada data absensi hari ini.</td>
                                </tr>
                            <% } else { %>
                                <% absensi.forEach(row => { %>
                                    <tr class="hover:bg-slate-800/40">
                                        <td class="p-3"><%= new Date(row.waktu).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</td>
                                        <td class="p-3 font-semibold text-white"><%= row.nama %></td>
                                        <td class="p-3"><%= row.nama_kelas %></td>
                                        <td class="p-3"><span class="bg-emerald-950 text-emerald-400 border border-emerald-800 px-2.5 py-1 rounded-md">HADIR</span></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer Developer Zeeo -->
    <footer class="mt-16 border-t border-slate-800/80 bg-slate-950/90 py-6">
        <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
            <p>Dikembangkan oleh <span class="text-cyan-400 font-bold">Zeeo</span></p>
            <div class="flex items-center gap-4 text-[11px]">
                <a href="mailto:vektorzero0@gmail.com" class="hover:text-cyan-400"><i class="fa-regular fa-envelope text-cyan-500"></i> vektorzero0@gmail.com</a>
                <span>|</span>
                <a href="https://wa.me/6282371729760" target="_blank" class="hover:text-emerald-400"><i class="fa-brands fa-whatsapp text-emerald-500"></i> 082371729760</a>
            </div>
        </div>
    </footer>

</body>
</html>
