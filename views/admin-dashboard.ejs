<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Administrator - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

    <!-- Header Resmi Sekolah -->
    <header class="bg-blue-900 text-white shadow-md border-b-4 border-amber-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-white/10 p-2 rounded-lg border border-white/20">
                    <i class="fa-solid fa-graduation-cap text-2xl text-amber-400"></i>
                </div>
                <div>
                    <h1 class="text-sm md:text-base font-bold tracking-wide uppercase">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                    <p class="text-[11px] text-blue-200">Panel Kelola Administrator Sistem Presensi</p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-3.5 py-2 rounded-xl shadow transition flex items-center gap-1.5">
                    <i class="fa-solid fa-qrcode text-sm"></i> Pemindai Presensi (Scanner)
                </a>
                <a href="/" class="bg-blue-950 hover:bg-blue-800 text-blue-100 text-xs px-3 py-2 rounded-xl border border-blue-700 transition flex items-center gap-1">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto w-full p-4 md:p-6 flex-1">

        <!-- Banner Profil -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 mb-6 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-amber-100 text-amber-800 p-3 rounded-xl">
                    <i class="fa-solid fa-user-shield text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200 px-2 py-0.5 rounded uppercase tracking-wider">Hak Akses: Administrator</span>
                    <h2 class="text-base font-bold text-slate-900 mt-0.5">Dashboard Pengelolaan Data Terpadu</h2>
                </div>
            </div>
        </div>

        <!-- Metric Summary -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
            <div class="bg-white border border-slate-200 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <p class="text-xs text-slate-500 font-medium">Total Akun Pengguna Guru</p>
                    <h3 class="text-xl font-bold text-slate-900 mt-1"><%= users.length %> <span class="text-xs font-normal text-slate-500">Personel</span></h3>
                </div>
                <div class="bg-blue-50 text-blue-700 border border-blue-100 p-3 rounded-xl">
                    <i class="fa-solid fa-users text-lg"></i>
                </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <p class="text-xs text-slate-500 font-medium">Total Peserta Didik</p>
                    <h3 class="text-xl font-bold text-emerald-700 mt-1"><%= siswa.length %> <span class="text-xs font-normal text-slate-500">Siswa</span></h3>
                </div>
                <div class="bg-emerald-50 text-emerald-700 border border-emerald-100 p-3 rounded-xl">
                    <i class="fa-solid fa-user-graduate text-lg"></i>
                </div>
            </div>

            <div class="bg-white border border-slate-200 rounded-2xl p-4 flex items-center justify-between shadow-sm">
                <div>
                    <p class="text-xs text-slate-500 font-medium">Rombongan Belajar (Rombel)</p>
                    <h3 class="text-xl font-bold text-purple-700 mt-1"><%= kelas.length %> <span class="text-xs font-normal text-slate-500">Kelas</span></h3>
                </div>
                <div class="bg-purple-50 text-purple-700 border border-purple-100 p-3 rounded-xl">
                    <i class="fa-solid fa-school text-lg"></i>
                </div>
            </div>
        </div>

        <!-- Panel Impor Massal Data Siswa Dapodik -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex items-center gap-3 mb-3 border-b border-slate-100 pb-2">
                <div class="bg-emerald-50 text-emerald-700 p-2.5 rounded-xl border border-emerald-200">
                    <i class="fa-solid fa-file-excel text-lg"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-800 text-xs uppercase tracking-wider">Impor Massal Data Siswa (Format Dapodik/Excel)</h3>
                    <p class="text-[11px] text-slate-500">Unggah berkas rekap Excel (.xlsx / .csv) dari Dapodik untuk menambahkan siswa & rombel secara otomatis.</p>
                </div>
            </div>

            <form id="formImportExcel" onsubmit="prosesImportExcel(event)" class="flex flex-col sm:flex-row items-center gap-3">
                <input type="file" id="fileExcelInput" accept=".xlsx, .xls, .csv" required class="flex-1 text-xs text-slate-600 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100 border border-slate-300 rounded-xl p-1 w-full bg-slate-50">
                
                <button type="submit" id="btnImportExcel" class="w-full sm:w-auto bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5 border border-emerald-800 whitespace-nowrap">
                    <i class="fa-solid fa-cloud-arrow-up"></i> Upload & Impor Data
                </button>
            </form>
        </div>

        <!-- Form Tambah Rombel & Guru -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            
            <!-- Form Rombel dengan Tombol Reset/Kosongkan Semua Rombel -->
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <div class="flex justify-between items-center border-b border-slate-100 pb-2 mb-4">
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-plus-circle text-purple-600"></i> Rombongan Belajar
                    </h3>
                    
                    <!-- 🟢 TOMBOL KOSONGKAN/RESET SEMUA ROMBEL -->
                    <% if (kelas && kelas.length > 0) { %>
                        <form action="/api/kelas/hapus-semua" method="POST" onsubmit="return confirm('HAPUS SELURUH ROMBEL?\n\nSemua rombel ganda akan dibersihkan dan nomor ID rombel di-reset ke 1.');">
                            <button type="submit" class="bg-rose-50 hover:bg-rose-100 text-rose-700 text-[10px] font-bold px-2.5 py-1 rounded-lg border border-rose-200 transition flex items-center gap-1">
                                <i class="fa-solid fa-trash-can text-rose-600"></i> Kosongkan Semua Rombel
                            </button>
                        </form>
                    <% } %>
                </div>

                <form action="/api/kelas/tambah" method="POST" class="flex gap-2">
                    <input type="text" name="nama_kelas" required placeholder="Contoh: Kelas 1A" class="flex-1 bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-purple-600">
                    <button type="submit" class="bg-purple-700 hover:bg-purple-800 text-white font-semibold text-xs px-4 py-2 rounded-xl transition">Simpan</button>
                </form>

                <!-- Daftar Rombel dengan Tombol Hapus Satuan -->
                <div class="mt-4 flex flex-wrap gap-2">
                    <% if (kelas && kelas.length > 0) { %>
                        <% kelas.forEach(k => { %>
                            <span class="bg-purple-50 text-purple-700 border border-purple-200 text-[10px] font-semibold px-2.5 py-1 rounded-lg flex items-center gap-1.5">
                                <%= k.nama_kelas %>
                                <form action="/api/kelas/hapus/<%= k.id %>" method="POST" onsubmit="return confirm('Hapus rombel <%= k.nama_kelas %>?');" class="inline">
                                    <button type="submit" class="text-purple-400 hover:text-rose-600 font-bold ml-1 text-xs">
                                        &times;
                                    </button>
                                </form>
                            </span>
                        <% }); %>
                    <% } else { %>
                        <p class="text-[11px] text-slate-400 italic">Belum ada rombel terdaftar.</p>
                    <% } %>
                </div>
            </div>

            <!-- Form Guru -->
            <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-slate-100 pb-2">
                    <i class="fa-solid fa-user-plus text-blue-600"></i> Registrasi Akun Wali Kelas / Guru
                </h3>
                <form action="/api/guru/tambah" method="POST" class="space-y-3">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" name="nama" required placeholder="Nama Lengkap Tenaga Pendidik" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                        <input type="text" name="username" required placeholder="Nama Pengguna (Username)" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="password" name="password" required placeholder="Kata Sandi" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                        <select name="kelas_id" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-600">
                            <option value="">-- Penugasan Rombel --</option>
                            <% kelas.forEach(k => { %>
                                <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" class="w-full bg-blue-900 hover:bg-blue-800 text-white font-semibold text-xs py-2.5 rounded-xl transition">
                        Daftarkan Pengguna Baru
                    </button>
                </form>
            </div>
        </div>

        <!-- Form Tambah Siswa Manual -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-slate-100 pb-2">
                <i class="fa-solid fa-address-card text-emerald-600"></i> Registrasi Peserta Didik Baru (Manual)
            </h3>
            <form action="/api/siswa/tambah" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <input type="text" name="nama" required placeholder="Nama Lengkap Siswa" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                <input type="text" name="nomor_wa_ortu" placeholder="No. WhatsApp Orang Tua (Contoh: 082371729760)" class="bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                <div class="flex gap-2">
                    <select name="kelas_id" required class="flex-1 bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                        <option value="">-- Pilih Rombel Kelas --</option>
                        <% kelas.forEach(k => { %>
                            <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                        <% }); %>
                    </select>
                    <button type="submit" class="bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs px-4 py-2 rounded-xl transition">Simpan Siswa</button>
                </div>
            </form>
        </div>

        <!-- Tabel Akun Pengguna -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-slate-100 pb-2">
                <i class="fa-solid fa-users-gear text-blue-600"></i> Direktori Akun Tenaga Pendidik
            </h3>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-700 border-collapse min-w-[500px]">
                    <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] font-semibold border-b border-slate-200">
                        <tr>
                            <th class="p-3">Nama Pengguna</th>
                            <th class="p-3">Username</th>
                            <th class="p-3">Peran / Hak Akses</th>
                            <th class="p-3">Penugasan Rombel</th>
                            <th class="p-3 text-center">Tindakan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% users.forEach(u => { %>
                            <tr class="hover:bg-slate-50">
                                <td class="p-3 font-semibold text-slate-900"><%= u.nama %></td>
                                <td class="p-3 font-mono text-slate-600"><%= u.username %></td>
                                <td class="p-3">
                                    <span class="bg-slate-100 text-slate-700 text-[10px] px-2 py-0.5 rounded border border-slate-200 font-medium">
                                        <%= u.role %>
                                    </span>
                                </td>
                                <td class="p-3 text-blue-700 font-medium"><%= u.nama_kelas %></td>
                                <td class="p-3 text-center flex justify-center gap-2">
                                    <button type="button" onclick="bukaModalEditGuru('<%= u.id %>', '<%= u.nama %>', '<%= u.username %>', '<%= u.kelas_id || '' %>')" class="text-blue-600 hover:text-blue-800 text-xs font-medium bg-blue-50 border border-blue-200 px-2.5 py-1 rounded-lg transition">
                                        <i class="fa-solid fa-pen-to-square mr-1"></i> Edit / Password
                                    </button>

                                    <% if (u.role !== 'ADMIN') { %>
                                        <form action="/api/guru/hapus/<%= u.id %>" method="POST" onsubmit="return confirm('Hapus pengguna ini?');" class="inline">
                                            <button type="submit" class="text-rose-600 hover:text-rose-800 text-xs font-medium bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-lg transition">
                                                <i class="fa-solid fa-trash mr-1"></i> Hapus
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tabel Siswa & QR Code -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4 border-b border-slate-100 pb-3">
                <div>
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-solid fa-id-card text-emerald-600"></i> Direktori Peserta Didik & Kode QR Kartu
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Daftar kartu identitas digital siswa yang valid untuk presensi kehadiran.</p>
                </div>
                
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <!-- 🟢 TOMBOL RESET TOTAL DATABASE (SISWA + ROMBEL + ID RESET KE 1) -->
                    <form action="/api/siswa/hapus-semua" method="POST" onsubmit="return confirm('RESET TOTAL DATABASE?\n\nSeluruh data siswa, riwayat absensi, dan rombel akan DIHAPUS PERMANEN dari database dan penomoran ID kembali ke #1.');" class="inline">
                        <button type="submit" class="bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs px-3 py-2 rounded-xl border border-rose-200 font-semibold transition flex items-center gap-1.5">
                            <i class="fa-solid fa-rotate-left text-rose-600"></i> Reset Total Database
                        </button>
                    </form>

                    <button onclick="window.print()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3.5 py-2 rounded-xl border border-slate-300 font-medium transition flex items-center gap-1.5">
                        <i class="fa-solid fa-print"></i> Cetak Kartu Identitas
                    </button>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-700 border-collapse min-w-[600px]">
                    <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] font-semibold border-b border-slate-200">
                        <tr>
                            <th class="p-3">ID Siswa</th>
                            <th class="p-3">Kode QR</th>
                            <th class="p-3">Nama Lengkap Siswa</th>
                            <th class="p-3">Rombel Kelas</th>
                            <th class="p-3">No. WhatsApp Orang Tua</th>
                            <th class="p-3 text-center">Tindakan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (siswa && siswa.length > 0) { %>
                            <% siswa.forEach(s => { %>
                                <tr class="hover:bg-slate-50">
                                    <td class="p-3 font-mono font-bold text-emerald-700">#<%= s.id %></td>
                                    <td class="p-3">
                                        <div class="bg-white p-1 rounded-lg inline-block border border-slate-300 shadow-sm">
                                            <img src="<%= s.qrImage %>" alt="QR <%= s.nama %>" class="w-12 h-12">
                                        </div>
                                    </td>
                                    <td class="p-3 font-semibold text-slate-900"><%= s.nama %></td>
                                    <td class="p-3">
                                        <span class="bg-slate-100 text-slate-700 text-[10px] font-medium px-2.5 py-1 rounded border border-slate-200">
                                            <%= s.nama_kelas %>
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono text-slate-700">
                                        <i class="fa-brands fa-whatsapp text-emerald-600 mr-1"></i><%= s.nomor_wa_ortu || '-' %>
                                    </td>
                                    <td class="p-3 text-center flex justify-center gap-1.5">
                                        <button type="button" onclick="bukaModalEditSiswa('<%= s.id %>', '<%= s.nama %>', '<%= s.nomor_wa_ortu || '' %>', '<%= s.kelas_id || '' %>')" class="text-emerald-700 hover:text-emerald-900 text-xs font-medium bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg transition">
                                            <i class="fa-solid fa-pen-to-square mr-1"></i> Edit
                                        </button>

                                        <form action="/api/siswa/hapus/<%= s.id %>" method="POST" onsubmit="return confirm('Hapus data siswa ini?');" class="inline">
                                            <button type="submit" class="text-rose-600 hover:text-rose-800 text-xs font-medium bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-lg transition">
                                                <i class="fa-solid fa-trash mr-1"></i> Hapus
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="p-8 text-center text-slate-400 italic">
                                    <i class="fa-solid fa-folder-open text-2xl mb-1 block text-slate-300"></i>
                                    Belum ada siswa terdaftar. Silakan lakukan impor data Excel Dapodik atau tambah manual.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- MODAL EDIT DATA GURU & UBAH PASSWORD -->
    <div id="modalEditGuru" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200">
            <div class="flex justify-between items-center border-b border-slate-100 pb-3 mb-4">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-user-pen text-blue-600"></i> Edit Profil / Ubah Password Guru
                </h3>
                <button onclick="tutupModalEditGuru()" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="formEditGuru" action="" method="POST" class="space-y-3">
                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Nama Lengkap Guru</label>
                    <input type="text" id="editNamaGuru" name="nama" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Username (Nama Pengguna)</label>
                    <input type="text" id="editUsernameGuru" name="username" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">
                        Password Baru <span class="text-slate-400 font-normal">(Kosongkan jika tidak ingin diubah)</span>
                    </label>
                    <input type="password" id="editPasswordGuru" name="password" placeholder="Masukkan password baru" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Penugasan Rombel</label>
                    <select id="editKelasGuru" name="kelas_id" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-600">
                        <option value="">-- Tanpa Penugasan --</option>
                        <% kelas.forEach(k => { %>
                            <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="flex gap-2 pt-3">
                    <button type="button" onclick="tutupModalEditGuru()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs py-2.5 rounded-xl border border-slate-300 transition">
                        Batal
                    </button>
                    <button type="submit" class="flex-1 bg-blue-800 hover:bg-blue-900 text-white font-semibold text-xs py-2.5 rounded-xl border border-blue-900 transition">
                        Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL EDIT DATA SISWA (NO. WA & ROMBEL) -->
    <div id="modalEditSiswa" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200">
