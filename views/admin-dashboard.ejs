    <!-- SCRIPT JAVASCRIPT BOOTSTRAP -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const currentUserId = "<%= typeof userId !== 'undefined' ? userId : 1 %>";

        function cekStatusWA() {
            fetch(`/api/wa-status?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    const statusText = document.getElementById('waStatusText');
                    const qrContainer = document.getElementById('qrContainer');
                    const qrImage = document.getElementById('qrImageWA');
                    const pairingContainer = document.getElementById('pairingContainer');
                    const pairingCodeText = document.getElementById('pairingCodeText');

                    if (!statusText) return;

                    if (data.statusWA === 'TERHUBUNG') {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-emerald-700 font-bold">Terhubung & Siap Terkirim ✅</span>`;
                        qrContainer.classList.add('hidden');
                        pairingContainer.classList.add('hidden');
                    } else if (data.pairingCode) {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-blue-700 font-bold">Masukkan Kode di WA HP 📲</span>`;
                        pairingCodeText.innerText = data.pairingCode;
                        pairingContainer.classList.remove('hidden');
                        qrContainer.classList.add('hidden');
                    } else if (data.qrCodeWA) {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Pindai Kode QR Di Bawah 📲</span>`;
                        qrImage.src = data.qrCodeWA;
                        qrContainer.classList.remove('hidden');
                        pairingContainer.classList.add('hidden');
                    } else if (data.statusWA === 'MENUNGGU_PAIRING_CODE' || data.statusWA === 'MENUNGGU_SCAN') {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Menyiapkan Tautan... ⏳</span>`;
                    } else {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-rose-600 font-bold">Belum Terhubung ❌</span>`;
                        qrContainer.classList.add('hidden');
                        pairingContainer.classList.add('hidden');
                    }
                })
                .catch(err => console.error("Gagal cek WA status:", err));
        }

        function mintaQRWA() {
            const btn = document.getElementById('btnGenerateWA');
            if (btn) {
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
                btn.disabled = true;
            }

            fetch(`/api/start-wa?userId=${currentUserId}`)
                .then(() => {
                    setTimeout(() => {
                        if (btn) {
                            btn.innerHTML = `<i class="fa-solid fa-qrcode"></i> Scan QR`;
                            btn.disabled = false;
                        }
                        cekStatusWA();
                    }, 2000);
                });
        }

        function mintaPairingWA() {
            const noHp = prompt("Masukkan Nomor WhatsApp Admin (Contoh: 082371729760):");
            if (!noHp) return;

            const btn = document.getElementById('btnPairingWA');
            if (btn) {
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
                btn.disabled = true;
            }

            fetch(`/api/request-pairing?userId=${currentUserId}&phone=${encodeURIComponent(noHp)}`)
                .then(res => res.json())
                .then(data => {
                    alert("Mempersiapkan kode tautan. Silakan tunggu 3-5 detik...");
                    setTimeout(() => {
                        if (btn) {
                            btn.innerHTML = `<i class="fa-solid fa-mobile-screen-button"></i> Pakai Nomor WA`;
                            btn.disabled = false;
                        }
                        cekStatusWA();
                    }, 3000);
                });
        }

        function resetWA() {
            if (!confirm('Apakah Anda yakin ingin mereset sesi WhatsApp Admin?')) return;
            fetch(`/api/reset-wa?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    alert(data.message);
                    cekStatusWA();
                });
        }

        function prosesImportExcel(e) {
            e.preventDefault();
            const fileInput = document.getElementById('fileExcelInput');
            const btn = document.getElementById('btnImportExcel');

            if (!fileInput.files.length) return alert("Pilih berkas Excel terlebih dahulu!");

            const formData = new FormData();
            formData.append('file_excel', fileInput.files[0]);

            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
            btn.disabled = true;

            fetch('/api/siswa/import-excel', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Upload & Impor Data`;
                btn.disabled = false;
                if (data.success) location.reload();
            })
            .catch(err => {
                console.error("Error Import:", err);
                alert("Terjadi kesalahan saat mengunggah berkas.");
                btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Upload & Impor Data`;
                btn.disabled = false;
            });
        }

        // AKUN GURU MODAL & HAPUS
        function bukaModalEditGuru(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));
            const username = decodeURIComponent(btn.getAttribute('data-username'));
            const kelasId = btn.getAttribute('data-kelas');

            document.getElementById('formEditGuru').action = `/api/guru/edit/${id}`;
            document.getElementById('editNamaGuru').value = nama;
            document.getElementById('editUsernameGuru').value = username;
            document.getElementById('editPasswordGuru').value = '';
            document.getElementById('editKelasGuru').value = kelasId;
            document.getElementById('modalEditGuru').classList.remove('hidden');
        }

        function tutupModalEditGuru() {
            document.getElementById('modalEditGuru').classList.add('hidden');
        }

        function hapusGuru(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));

            if (confirm(`Hapus pengguna guru "${nama}"?`)) {
                const formHapus = document.getElementById('formHapusUmum');
                formHapus.action = `/api/guru/hapus/${id}`;
                formHapus.submit();
            }
        }

        // SISWA MODAL & HAPUS
        function bukaModalEditSiswa(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));
            const wa = decodeURIComponent(btn.getAttribute('data-wa'));
            const kelasId = btn.getAttribute('data-kelas');

            document.getElementById('formEditSiswa').action = `/api/siswa/edit/${id}`;
            document.getElementById('editNamaSiswa').value = nama;
            document.getElementById('editWaSiswa').value = wa;
            document.getElementById('editKelasSiswa').value = kelasId;
            document.getElementById('modalEditSiswa').classList.remove('hidden');
        }

        function tutupModalEditSiswa() {
            document.getElementById('modalEditSiswa').classList.add('hidden');
        }

        function hapusSiswa(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));

            if (confirm(`Hapus data siswa "${nama}"?`)) {
                const formHapus = document.getElementById('formHapusUmum');
                formHapus.action = `/api/siswa/hapus/${id}`;
                formHapus.submit();
            }
        }

        function bukaSidebar() {
            document.getElementById('sidebarMenu').classList.remove('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.remove('hidden');
        }

        function tutupSidebar() {
            document.getElementById('sidebarMenu').classList.add('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.add('hidden');
        }

        // Jalankan pengecekan otomatis per 2 detik
        setInterval(cekStatusWA, 2000);
        document.addEventListener("DOMContentLoaded", cekStatusWA);
    </script>

