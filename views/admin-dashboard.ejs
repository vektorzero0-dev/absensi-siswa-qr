<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between p-3 md:p-6 font-sans">

    <div class="max-w-6xl mx-auto w-full">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-4 shadow-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-amber-500/10 border border-amber-500/20 p-2.5 rounded-xl text-amber-400">
                    <i class="fa-solid fa-user-shield text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] text-amber-400 font-bold bg-amber-950/80 border border-amber-800/80 px-2.5 py-0.5 rounded-md uppercase tracking-wider">
                        ADMINISTRATOR
                    </span>
                    <h1 class="text-base font-bold text-white mt-1">DASHBOARD UTAMA SISTEM</h1>
                    <p class="text-xs text-slate-400">UPTD SD NEGERI 1 KARYA MULYA SARI</p>
                </div>
            </div>
            <div class="flex gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2 border border-emerald-500/30 transition">
                    <i class="fa-solid fa-qrcode text-sm"></i> Buka Scanner Kartu
                </a>
                <a href="/" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3.5 py-2.5 rounded-xl border border-slate-700 flex items-center justify-center transition">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center justify-between shadow-lg">
                <div>
                    <p class="text-[11px] text-slate-400 font-medium">Total Akun Pengguna</p>
                    <h3 class="text-xl font-bold text-white mt-0.5"><%= users.length %> <span class="text-xs font-normal text-slate-400">User</span></h3>
                </div>
                <div class="bg-blue-500/10 text-blue-400 border border-blue-500/20 p-3 rounded-xl">
                    <i class="fa-solid fa-users text-lg"></i>
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center justify-between shadow-lg">
                <div>
                    <p class="text-[11px] text-slate-400 font-medium">Total Siswa Terdaftar</p>
                    <h3 class="text-xl font-bold text-emerald-400 mt-0.5"><%= siswa.length %> <span class="text-xs font-normal text-slate-400">Siswa</span></h3>
                </div>
                <div class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 p-3 rounded-xl">
                    <i class="fa-solid fa-graduation-cap text-lg"></i>
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 flex items-center justify-between shadow-lg">
                <div>
                    <p class="text-[11px] text-slate-400 font-medium">Total Rombel Kelas</p>
                    <h3 class="text-xl font-bold text-purple-400 mt-0.5"><%= kelas.length %> <span class="text-xs font-normal text-slate-400">Kelas</span></h3>
                </div>
                <div class="bg-purple-500/10 text-purple-400 border border-purple-500/20 p-3 rounded-xl">
                    <i class="fa-solid fa-school text-lg"></i>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl">
                <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-plus-circle text-purple-400"></i> Tambah Kelas Baru
                </h3>
                <form action="/api/kelas/tambah" method="POST" class="flex gap-2">
                    <input type="text" name="nama_kelas" required placeholder="Contoh: Kelas 1A" class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-purple-500">
                    <button type="submit" class="bg-purple-600 hover:bg-purple-500 text-white font-semibold text-xs px-4 py-2 rounded-xl">Simpan</button>
                </form>

                <div class="mt-4 flex flex-wrap gap-2">
                    <% kelas.forEach(k => { %>
                        <span class="bg-slate-800 text-slate-300 border border-slate-700 text-[10px] font-bold px-2.5 py-1 rounded-lg">
                            <%= k.nama_kelas %>
                        </span>
                    <% }); %>
                </div>
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl">
                <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3 flex items-center gap-2">
                    <i class="fa-solid fa-user-plus text-blue-400"></i> Tambah Pengguna / Wali Kelas
                </h3>
                <form action="/api/guru/tambah" method="POST" class="space-y-2">
                    <div class="grid grid-cols-2 gap-2">
                        <input type="text" name="nama" required placeholder="Nama Guru (Tanpa Gelar)" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white">
                        <input type="text" name="username" required placeholder="Username" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white">
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <input type="password" name="password" required placeholder="Password" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white">
                        <select name="kelas_id" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-300">
                            <option value="">-- Pilih Kelas --</option>
                            <% kelas.forEach(k => { %>
                                <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs py-2 rounded-xl transition">
                        Daftarkan Guru Wali Kelas
                    </button>
                </form>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl mb-6">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3 flex items-center gap-2">
                <i class="fa-solid fa-user-graduate text-emerald-400"></i> Tambah Siswa Baru (Global Admin)
            </h3>
            <form action="/api/siswa/tambah" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <input type="text" name="nama" required placeholder="Nama Siswa" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white">
                <input type="text" name="nomor_wa_ortu" placeholder="No WA Ortu (Contoh: 082371729760)" class="bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white">
                <div class="flex gap-2">
                    <select name="kelas_id" required class="flex-1 bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-300">
                        <option value="">-- Pilih Kelas --</option>
                        <% kelas.forEach(k => { %>
                            <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                        <% }); %>
                    </select>
                    <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-4 py-2 rounded-xl">Simpan</button>
                </div>
            </form>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl mb-6">
            <h2 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                <i class="fa-solid fa-users-gear text-blue-400"></i> Akun Pengguna Guru & Wali Kelas
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-300 min-w-[500px]">
                    <thead class="bg-slate-800 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-3 rounded-l-xl">Nama Guru</th>
                            <th class="p-3">Username</th>
                            <th class="p-3">Role</th>
                            <th class="p-3">Wali Kelas</th>
                            <th class="p-3 rounded-r-xl text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        <% users.forEach(u => { %>
                            <tr class="hover:bg-slate-800/40">
                                <td class="p-3 font-bold text-white"><%= u.nama %></td>
                                <td class="p-3 font-mono text-slate-400"><%= u.username %></td>
                                <td class="p-3">
                                    <span class="bg-slate-800 text-slate-300 text-[10px] px-2 py-0.5 rounded border border-slate-700">
                                        <%= u.role %>
                                    </span>
                                </td>
                                <td class="p-3 text-emerald-400 font-semibold"><%= u.nama_kelas %></td>
                                <td class="p-3 text-center">
                                    <% if (u.role !== 'ADMIN') { %>
                                        <form action="/api/guru/hapus/<%= u.id %>" method="POST" onsubmit="return confirm('Hapus user guru ini?');" class="inline">
                                            <button type="submit" class="text-rose-400 hover:text-rose-300 text-xs">
                                                <i class="fa-solid fa-trash"></i> Hapus
                                            </button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl mb-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4">
                <div>
                    <h2 class="text-sm font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-address-card text-emerald-400"></i> Data Kartu Presensi Siswa & QR Code
                    </h2>
                    <p class="text-xs text-slate-400 mt-0.5">Daftar QR ID kartu siswa yang digunakan untuk scan otomatis notifikasi WA.</p>
                </div>
                <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-2 rounded-xl border border-slate-700 font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-print"></i> Cetak QR Kartu
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-300 min-w-[600px]">
                    <thead class="bg-slate-800 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-3 rounded-l-xl">ID Kartu</th>
                            <th class="p-3">QR Code</th>
                            <th class="p-3">Nama Siswa</th>
                            <th class="p-3">Kelas</th>
                            <th class="p-3">No. WhatsApp Ortu</th>
                            <th class="p-3 rounded-r-xl text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        <% siswa.forEach(s => { %>
                            <tr class="hover:bg-slate-800/40">
                                <td class="p-3 font-mono font-bold text-emerald-400">#<%= s.id %></td>
                                <td class="p-3">
                                    <div class="bg-white p-1 rounded-lg inline-block border border-slate-700">
                                        <img src="<%= s.qrImage %>" alt="QR <%= s.nama %>" class="w-12 h-12">
                                    </div>
                                </td>
                                <td class="p-3 font-bold text-white"><%= s.nama %></td>
                                <td class="p-3">
                                    <span class="bg-slate-800 text-slate-300 text-[10px] font-semibold px-2.5 py-1 rounded-md border border-slate-700">
                                        <%= s.nama_kelas %>
                                    </span>
                                </td>
                                <td class="p-3 font-mono text-slate-300">
                                    <i class="fa-brands fa-whatsapp text-emerald-400 mr-1"></i><%= s.nomor_wa_ortu || '-' %>
                                </td>
                                <td class="p-3 text-center">
                                    <form action="/api/siswa/hapus/<%= s.id %>" method="POST" onsubmit="return confirm('Hapus siswa ini?');" class="inline">
                                        <button type="submit" class="text-rose-400 hover:text-rose-300 text-xs">
                                            <i class="fa-solid fa-trash"></i> Hapus
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <footer class="text-center py-4 text-[11px] text-slate-500 border-t border-slate-900 mt-6">
        <p>Developer: <strong class="text-slate-300">Zeeo</strong> | <a href="mailto:vektorzero0@gmail.com" class="underline hover:text-slate-300">vektorzero0@gmail.com</a></p>
        <p class="mt-0.5">WhatsApp CS: <a href="https://wa.me/6282371729760" target="_blank" class="text-emerald-400 hover:underline"><i class="fa-brands fa-whatsapp"></i> 082371729760</a></p>
    </footer>

</body>
</html>
