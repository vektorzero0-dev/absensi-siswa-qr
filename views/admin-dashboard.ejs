                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Rombongan Belajar (Kelas)</label>
                    <select id="editKelasSiswa" name="kelas_id" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-emerald-600">
