<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cetak Kartu Presensi Siswa - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    
    <!-- CSS Tailwind & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        body { font-family: 'Plus Jakarta Sans', sans-serif; }

        /* LATAR BELAKANG TERANG DENGAN GRADASI BERGERAK & MOTIF */
        .bg-light-animated {
            background: linear-gradient(-45deg, #e0f2fe, #f0fdf4, #fef3c7, #f1f5f9);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            background-image: 
                radial-gradient(rgba(15, 23, 42, 0.05) 1.2px, transparent 1.2px),
                linear-gradient(-45deg, #e0f2fe, #f0fdf4, #fef3c7, #e2e8f0);
            background-size: 20px 20px, 400% 400%;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Scrollbar Halus */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

        /* BOLA CAHAYA ANIMASI HEADER */
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.2); }
        }
        .animate-glow { animation: pulseGlow 5s infinite ease-in-out; }

        /* UKURAN STANDAR FISIK KARTU ID CARD (85.6mm x 54mm) */
        .kartu-size {
            width: 85.6mm;
            height: 54mm;
            page-break-inside: avoid;
            position: relative;
            overflow: hidden;
            border-radius: 14px;
            background: linear-gradient(135deg, #ffffff 0%, #f0fdf4 50%, #e0f2fe 100%);
            border: 2px solid #a7f3d0;
            box-shadow: 0 10px 20px -5px rgba(16, 185, 129, 0.15);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        /* MOTIF PATTERN GEOMETRIS INTERNAL KARTU ID */
        .kartu-size::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: 
                radial-gradient(rgba(16, 185, 129, 0.08) 1.2px, transparent 1.2px),
                linear-gradient(120deg, rgba(30, 58, 138, 0.03) 0%, transparent 60%);
            background-size: 10px 10px, 100% 100%;
            pointer-events: none;
        }

        /* ANIMASI HOVER MELAYANG PADA KARTU ID */
        .kartu-size:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 20px 30px -10px rgba(16, 185, 129, 0.3);
            border-color: #10b981;
        }

        /* CSS KHUSUS SAAT DICETAK KE KERTAS / PDF */
        @media print {
            .no-print { display: none !important; }
            body { 
                background: none !important; 
                background-color: #ffffff !important; 
                padding: 0 !important;
            }
            .kartu-size {
                box-shadow: none !important;
                border: 1px solid #334155 !important;
                transform: none !important;
            }
        }

        @keyframes fadeInSoft {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fadeInSoft 0.4s ease-out forwards; }

        button, .btn-interactive { transition: all 0.2s ease-in-out; }
        button:active, .btn-interactive:active { transform: scale(0.96); }
    </style>
</head>
<body class="bg-light-animated text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

    <!-- NAVBAR HEADER ATAS (NO PRINT) -->
    <nav class="no-print bg-slate-900/90 backdrop-blur-md text-white sticky top-0 z-30 shadow-md px-4 py-3 flex items-center justify-between border-b border-emerald-500/50">
        <div class="flex items-center gap-3">
            <a href="/admin" class="btn-interactive bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-xl border border-emerald-500 font-bold text-xs flex items-center gap-2 transition shadow-sm">
                <i class="fa-solid fa-arrow-left text-sm"></i> <span>Kembali ke Dashboard</span>
            </a>
            
            <span class="font-bold text-xs sm:text-sm tracking-wide text-amber-400 uppercase truncate">
                UPTD SD NEGERI 1 KARYA MULYA SARI
            </span>
        </div>

        <div class="text-xs text-slate-300 hidden sm:block">
            <i class="fa-solid fa-address-card text-emerald-400 mr-1"></i> Cetak Kartu Digital Siswa
        </div>
    </nav>

    <!-- HEADER RESMI SEKOLAH BERANIMASI (NO PRINT) -->
    <header class="no-print bg-gradient-to-r from-blue-900 via-slate-900 to-indigo-900 text-white shadow-lg border-b-4 border-amber-500 relative overflow-hidden">
        <div class="absolute -top-12 left-1/4 w-48 h-48 bg-emerald-500/20 rounded-full blur-3xl animate-glow pointer-events-none"></div>
        <div class="absolute -bottom-10 right-10 w-36 h-36 bg-amber-400/20 rounded-full blur-3xl animate-glow pointer-events-none" style="animation-delay: 2.5s;"></div>

        <div class="max-w-6xl mx-auto px-4 py-3.5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 relative z-10">
            <div class="flex items-center gap-3">
                <div class="bg-gradient-to-tr from-amber-500 to-amber-300 p-2 rounded-xl text-slate-950 shadow-md">
                    <i class="fa-solid fa-graduation-cap text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-sm md:text-base font-extrabold tracking-wide uppercase text-slate-100">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                    <p class="text-[11px] text-blue-200">Cetak Kartu Presensi Lengkap Siap Kertas A4 (Muat 8–10 Kartu)</p>
                </div>
            </div>
            
            <button onclick="window.print()" class="btn-interactive bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-md transition flex items-center gap-2 border border-emerald-500">
                <i class="fa-solid fa-print text-sm"></i> Cetak / Simpan PDF
            </button>
        </div>
    </header>

    <!-- CONTAINER CONTAINER UTAMA -->
    <main class="max-w-6xl mx-auto w-full p-4 md:p-6 flex-1 animate-fade-in">

        <!-- GRID KARTU-KARTU ID SISWA -->
        <div class="flex flex-wrap gap-5 justify-center max-w-5xl mx-auto">
            <% siswa.forEach(s => { %>
                <div class="kartu-size flex flex-col justify-between">
                    
                    <!-- 1. KOP SEKOLAH / HEADER KARTU -->
                    <div class="bg-gradient-to-r from-blue-900 via-emerald-800 to-slate-900 text-white px-2.5 py-1.5 flex items-center gap-2 border-b-2 border-amber-400 relative z-10">
                        <div class="w-6 h-6 bg-white rounded-full flex items-center justify-center shrink-0 shadow-sm">
                            <i class="fa-solid fa-graduation-cap text-emerald-800 text-[10px]"></i>
                        </div>
                        <div class="leading-tight flex-1">
                            <h2 class="font-extrabold text-[8.5px] tracking-wide uppercase text-amber-300">UPTD SD NEGERI 1 KARYA MULYA SARI</h2>
                            <p class="text-[6.5px] text-slate-200 font-medium">KARTU PRESENSI DIGITAL SISWA</p>
                        </div>
                    </div>

                    <!-- 2. ISI KARTU (FOTO, DETAIL & QR CODE) -->
                    <div class="p-2 flex items-center justify-between gap-2 relative z-10 my-auto">
                        
                        <!-- Foto Formal Siswa / Avatar Default -->
                        <div class="w-11 h-14 bg-white border-2 border-emerald-300 rounded-lg overflow-hidden flex items-center justify-center shrink-0 shadow-xs">
                            <% if (s.foto) { %>
                                <img src="<%= s.foto %>" class="w-full h-full object-cover">
                            <% } else { %>
                                <i class="fa-solid fa-user text-slate-400 text-lg"></i>
                            <% } %>
                        </div>

                        <!-- Detail Data Siswa -->
                        <div class="flex-1 min-w-0 leading-tight">
                            <div class="mb-0.5">
                                <span class="text-[6px] text-slate-400 font-extrabold uppercase block">Nama Lengkap</span>
                                <h3 class="text-[10px] font-black text-slate-900 truncate uppercase"><%= s.nama %></h3>
                            </div>

                            <div class="grid grid-cols-2 gap-1 my-0.5">
                                <div>
                                    <span class="text-[6px] text-slate-400 font-extrabold uppercase block">Rombel</span>
                                    <span class="text-[8px] font-extrabold text-emerald-700 bg-emerald-100/80 px-1 py-0.2 rounded border border-emerald-200 inline-block"><%= s.nama_kelas %></span>
                                </div>
                                <div>
                                    <span class="text-[6px] text-slate-400 font-extrabold uppercase block">ID Presensi</span>
                                    <span class="text-[8px] font-mono font-bold text-slate-800">#<%= s.id %></span>
                                </div>
                            </div>

                            <div class="mt-0.5">
                                <span class="text-[6px] text-slate-400 font-extrabold uppercase block">WA Wali Murid</span>
                                <span class="text-[7.5px] font-mono text-slate-700 flex items-center gap-0.5">
                                    <i class="fa-brands fa-whatsapp text-emerald-600 text-[8px]"></i>
                                    <%= s.nomor_wa_ortu || '-' %>
                                </span>
                            </div>
                        </div>

                        <!-- QR Code Presensi -->
                        <div class="text-center shrink-0">
                            <div class="bg-white p-1 border-2 border-emerald-200 rounded-xl shadow-xs">
                                <img src="<%= s.qrImage %>" class="w-13 h-13">
                            </div>
                            <span class="text-[5.5px] text-slate-500 font-mono font-bold uppercase block mt-0.5">SCAN PRESENSI</span>
                        </div>
                    </div>

                    <!-- 3. FOOTER KARTU -->
                    <div class="bg-slate-900 text-slate-300 text-[6.5px] px-2.5 py-0.5 flex justify-between items-center relative z-10 border-t border-emerald-500/40">
                        <span>Tahun Ajaran Aktif</span>
                        <span class="font-bold text-amber-400">Harap dibawa setiap hari sekolah</span>
                    </div>

                </div>
            <% }); %>
        </div>

    </main>

    <footer class="no-print bg-slate-900 text-white border-t border-slate-800 py-3 text-center text-[11px] mt-6">
        <p>© UPTD SD Negeri 1 Karya Mulya Sari. Seluruh Hak Cipta Dilindungi.</p>
        <p class="mt-0.5 text-slate-400">Pengembang Sistem: <strong class="text-slate-200">Zeeo</strong> | Bantuan Teknis (WhatsApp): <a href="https://wa.me/6282371729760" target="_blank" class="text-amber-400 font-medium hover:underline">0823-7172-9760</a></p>
    </footer>

</body>
</html>
