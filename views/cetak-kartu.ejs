<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Cetak ID Card Potret - Presensi Siswa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; }
        }
        /* Ukuran Standar ID Card Potret (54mm x 85.6mm) */
        .kartu-potret {
            width: 54mm;
            height: 85.6mm;
            page-break-inside: avoid;
        }
    </style>
</head>
<body class="bg-slate-100 p-6">

    <!-- Tombol Cetak / Simpan PDF -->
    <div class="no-print mb-6 max-w-4xl mx-auto flex justify-between items-center bg-white p-4 rounded-xl shadow border border-slate-200">
        <div>
            <h1 class="font-bold text-lg text-slate-800">Cetak ID Card Siswa (Versi Potret / Tegak)</h1>
            <p class="text-xs text-slate-500">Desain tegak standar ID card — Siap cetak ke A4 / PVC</p>
        </div>
        <button onclick="window.print()" class="bg-emerald-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-emerald-700 transition flex items-center gap-2">
            <i class="fa-solid fa-print"></i> Cetak / Simpan PDF
        </button>
    </div>

    <!-- Container Grid Kartu -->
    <div class="flex flex-wrap gap-4 justify-center max-w-5xl mx-auto">
        <% if (typeof siswa !== 'undefined' && siswa && siswa.length > 0) { %>
            <% siswa.forEach(s => { %>
                <div class="kartu-potret bg-white border-2 border-slate-800 rounded-xl flex flex-col justify-between shadow-sm relative overflow-hidden text-center">
                    
                    <!-- 1. KOP / HEADER SEKOLAH -->
                    <div class="bg-emerald-800 text-white p-1.5 border-b-2 border-amber-400">
                        <div class="w-6 h-6 bg-white rounded-full flex items-center justify-center mx-auto mb-0.5">
                            <i class="fa-solid fa-graduation-cap text-emerald-800 text-[10px]"></i>
                        </div>
                        <h2 class="font-extrabold text-[7.5px] leading-tight uppercase">UPTD SD NEGERI 1 KARYA MULYA SARI</h2>
                        <p class="text-[5.5px] text-emerald-200 font-medium tracking-wider">KARTU PRESENSI DIGITAL</p>
                    </div>

                    <!-- 2. FOTO & DATA SISWA -->
                    <div class="px-2 py-1 flex flex-col items-center justify-center my-auto">
                        <!-- Frame Foto Siswa -->
                        <div class="w-11 h-14 bg-slate-100 border border-slate-300 rounded overflow-hidden flex items-center justify-center mb-1.5 shadow-inner">
                            <i class="fa-solid fa-user text-slate-300 text-2xl"></i>
                        </div>

                        <!-- Nama Lengkap -->
                        <div class="w-full mb-1">
                            <span class="text-[5.5px] text-slate-400 font-bold uppercase tracking-wider block">Nama Siswa</span>
                            <h3 class="text-[9.5px] font-extrabold text-slate-900 truncate leading-tight"><%= s.nama %></h3>
                        </div>

                        <!-- Detail Kelas & ID -->
                        <div class="grid grid-cols-2 gap-1 w-full border-t border-b border-slate-100 py-1 my-0.5">
                            <div>
                                <span class="text-[5.5px] text-slate-400 font-bold uppercase tracking-wider block">Kelas</span>
                                <span class="text-[8.5px] font-bold text-emerald-700 block"><%= s.nama_kelas %></span>
                            </div>
                            <div>
                                <span class="text-[5.5px] text-slate-400 font-bold uppercase tracking-wider block">ID Siswa</span>
                                <span class="text-[8.5px] font-mono font-bold text-slate-800 block">#<%= s.id %></span>
                            </div>
                        </div>

                        <!-- 3. QR CODE PRESENSI -->
                        <div class="mt-1">
                            <div class="bg-white p-0.5 border border-slate-300 rounded-lg shadow-sm inline-block">
                                <img src="<%= s.qrImage %>" class="w-12 h-12">
                            </div>
                            <span class="text-[5.5px] text-slate-500 font-bold uppercase tracking-wider block mt-0.5">Scan Presensi</span>
                        </div>
                    </div>

                    <!-- 4. FOOTER KARTU -->
                    <div class="bg-slate-900 text-amber-400 text-[6px] font-bold py-1 px-1">
                        Wajib Dibawa Setiap Hari Sekolah
                    </div>

                </div>
            <% }); %>
        <% } %>
    </div>

</body>
</html>
