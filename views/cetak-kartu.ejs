<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Cetak Kartu Presensi Siswa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; }
            .page-break { page-break-after: always; }
        }
        /* Ukuran Standar ID Card (85.6mm x 54mm) */
        .kartu-size {
            width: 85.6mm;
            height: 54mm;
            page-break-inside: avoid;
        }
    </style>
</head>
<body class="bg-slate-100 p-6">

    <!-- Tombol Cetak / Simpan PDF -->
    <div class="no-print mb-6 max-w-4xl mx-auto flex justify-between items-center bg-white p-4 rounded-xl shadow border border-slate-200">
        <div>
            <h1 class="font-bold text-lg text-slate-800">Cetak ID Card Presensi Siswa</h1>
            <p class="text-xs text-slate-500">Desain ringkas tanpa No. WA — Siap cetak ke kertas A4 / Bahan PVC ID Card</p>
        </div>
        <button onclick="window.print()" class="bg-emerald-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-emerald-700 transition flex items-center gap-2">
            <i class="fa-solid fa-print"></i> Cetak / Simpan PDF
        </button>
    </div>

    <!-- Container Grid Kartu -->
    <div class="flex flex-wrap gap-4 justify-center max-w-5xl mx-auto">
        <% if (typeof siswa !== 'undefined' && siswa && siswa.length > 0) { %>
            <% siswa.forEach(s => { %>
                <div class="kartu-size bg-white border-2 border-slate-800 rounded-xl flex flex-col justify-between shadow-sm relative overflow-hidden">
                    
                    <!-- 1. KOP / HEADER ID CARD -->
                    <div class="bg-emerald-800 text-white px-3 py-1.5 flex items-center gap-2 border-b-2 border-amber-400">
                        <div class="w-6 h-6 bg-white rounded-full flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-graduation-cap text-emerald-800 text-[10px]"></i>
                        </div>
                        <div class="leading-tight">
                            <h2 class="font-extrabold text-[8.5px] tracking-wide uppercase">UPTD SD NEGERI 1 KARYA MULYA SARI</h2>
                            <p class="text-[6.5px] text-emerald-200 font-medium tracking-wider">KARTU PRESENSI DIGITAL SISWA</p>
                        </div>
                    </div>

                    <!-- 2. ISI KARTU (FOTO, DETAIL SISWA & QR CODE) -->
                    <div class="px-3 py-2 flex items-center justify-between gap-2.5 my-auto">
                        
                        <!-- Avatar / Frame Foto Formal -->
                        <div class="w-12 h-16 bg-slate-100 border border-slate-300 rounded overflow-hidden flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-user text-slate-300 text-2xl"></i>
                        </div>

                        <!-- Data Diri Siswa -->
                        <div class="flex-1 min-w-0 leading-tight">
                            <div class="mb-1.5">
                                <span class="text-[6.5px] text-slate-400 font-bold uppercase tracking-wider block">Nama Lengkap</span>
                                <h3 class="text-[11px] font-extrabold text-slate-900 truncate leading-snug"><%= s.nama %></h3>
                            </div>

                            <div class="grid grid-cols-2 gap-1.5 border-t border-slate-100 pt-1">
                                <div>
                                    <span class="text-[6.5px] text-slate-400 font-bold uppercase tracking-wider block">Kelas</span>
                                    <span class="text-[9.5px] font-bold text-emerald-700 block"><%= s.nama_kelas %></span>
                                </div>
                                <div>
                                    <span class="text-[6.5px] text-slate-400 font-bold uppercase tracking-wider block">ID Siswa</span>
                                    <span class="text-[9.5px] font-mono font-bold text-slate-800 block">#<%= s.id %></span>
                                </div>
                            </div>
                        </div>

                        <!-- QR Code Presensi -->
                        <div class="text-center shrink-0 border-l border-slate-100 pl-2">
                            <div class="bg-white p-0.5 border border-slate-300 rounded-lg shadow-sm">
                                <img src="<%= s.qrImage %>" class="w-14 h-14">
                            </div>
                            <span class="text-[6px] text-slate-500 font-bold uppercase tracking-wider block mt-0.5">Scan Masuk</span>
                        </div>
                    </div>

                    <!-- 3. FOOTER KARTU -->
                    <div class="bg-slate-900 text-slate-300 text-[6.5px] px-3 py-1 flex justify-between items-center">
                        <span class="font-medium">Kartu Identitas Presensi</span>
                        <span class="font-bold text-amber-400">Wajib Dibawa Setiap Hari</span>
                    </div>

                </div>
            <% }); %>
        <% } %>
    </div>

</body>
</html>
