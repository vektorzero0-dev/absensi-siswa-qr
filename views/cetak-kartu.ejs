<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Cetak Kartu Presensi Siswa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            .no-print { display: none; }
            body { background: white; padding: 0; }
        }
        /* Ukuran Standar Kartu ID Card (85.6mm x 53.98mm) */
        .kartu-size {
            width: 85.6mm;
            height: 54mm;
            page-break-inside: avoid;
        }
    </style>
</head>
<body class="bg-slate-100 p-6">

    <!-- Tombol Aksi -->
    <div class="no-print mb-6 max-w-4xl mx-auto flex justify-between items-center bg-white p-4 rounded-xl shadow border">
        <div>
            <h1 class="font-bold text-lg text-slate-800">Cetak Kartu Presensi Lengkap</h1>
            <p class="text-xs text-slate-500">Siap cetak ke ukuran kertas A4 (Bisa muat 8-10 kartu per lembar)</p>
        </div>
        <button onclick="window.print()" class="bg-emerald-600 text-white px-5 py-2.5 rounded-lg font-bold hover:bg-emerald-700 transition flex items-center gap-2">
            <i class="fa-solid fa-print"></i> Cetak / Simpan PDF
        </button>
    </div>

    <!-- Container Grid Kartu -->
    <div class="flex flex-wrap gap-4 justify-center max-w-5xl mx-auto">
        <% siswa.forEach(s => { %>
            <div class="kartu-size bg-white border-2 border-slate-800 rounded-xl flex flex-col justify-between shadow-md relative overflow-hidden">
                
                <!-- 1. KOP SEKOLAH / HEADER -->
                <div class="bg-emerald-800 text-white px-3 py-1.5 flex items-center gap-2 border-b-2 border-amber-400">
                    <!-- Placeholder Logo Sekolah -->
                    <div class="w-7 h-7 bg-white rounded-full flex items-center justify-center shrink-0">
                        <i class="fa-solid fa-graduation-cap text-emerald-800 text-xs"></i>
                    </div>
                    <div class="leading-tight">
                        <h2 class="font-extrabold text-[9px] tracking-wide uppercase">UPTD SD NEGERI 1 KARYA MULYA SARI</h2>
                        <p class="text-[7px] text-emerald-200 font-medium">KARTU PRESENSI DIGITAL SISWA</p>
                    </div>
                </div>

                <!-- 2. ISI KARTU (FOTO, DETAIL & QR) -->
                <div class="p-2.5 flex items-center justify-between gap-2 my-auto">
                    
                    <!-- Foto Formal Siswa / Avatar Default -->
                    <div class="w-12 h-16 bg-slate-100 border border-slate-300 rounded overflow-hidden flex items-center justify-center shrink-0">
                        <% if (s.foto) { %>
                            <img src="<%= s.foto %>" class="w-full h-full object-cover">
                        <% } else { %>
                            <i class="fa-solid fa-user text-slate-400 text-xl"></i>
                        <% } %>
                    </div>

                    <!-- Detail Data Siswa -->
                    <div class="flex-1 min-w-0 leading-tight">
                        <div class="mb-1">
                            <span class="text-[7px] text-slate-400 font-bold uppercase block">Nama Lengkap</span>
                            <h3 class="text-[11px] font-extrabold text-slate-900 truncate"><%= s.nama %></h3>
                        </div>

                        <div class="grid grid-cols-2 gap-1">
                            <div>
                                <span class="text-[7px] text-slate-400 font-bold uppercase block">Rombel / Kelas</span>
                                <span class="text-[9px] font-bold text-emerald-700"><%= s.nama_kelas %></span>
                            </div>
                            <div>
                                <span class="text-[7px] text-slate-400 font-bold uppercase block">ID Presensi</span>
                                <span class="text-[9px] font-mono font-bold text-slate-800">#<%= s.id %></span>
                            </div>
                        </div>

                        <div class="mt-1">
                            <span class="text-[7px] text-slate-400 font-bold uppercase block">No. WA Wali Murid</span>
                            <span class="text-[8px] font-mono text-slate-700 flex items-center gap-0.5">
                                <i class="fa-brands fa-whatsapp text-emerald-600 text-[9px]"></i>
                                <%= s.nomor_wa_ortu || '-' %>
                            </span>
                        </div>
                    </div>

                    <!-- QR Code Presensi -->
                    <div class="text-center shrink-0">
                        <div class="bg-white p-1 border border-slate-300 rounded-lg shadow-sm">
                            <img src="<%= s.qrImage %>" class="w-14 h-14">
                        </div>
                        <span class="text-[6px] text-slate-400 font-bold uppercase block mt-0.5">Scan Presensi</span>
                    </div>
                </div>

                <!-- 3. FOOTER KARTU -->
                <div class="bg-slate-900 text-slate-300 text-[7px] px-3 py-1 flex justify-between items-center">
                    <span>Tahun Ajaran Aktif</span>
                    <span class="font-semibold text-amber-400">Harap dibawa setiap hari sekolah</span>
                </div>

            </div>
        <% }); %>
    </div>

</body>
</html>
