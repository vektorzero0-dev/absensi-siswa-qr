    <!-- SCRIPT JAVASCRIPT BOOTSTRAP & UTILS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const currentUserId = "<%= typeof userId !== 'undefined' ? userId : 1 %>";

        function prosesRestorePetugas(e) {
            e.preventDefault();
            const fileInput = document.getElementById('inputBackupJsonPetugas');
            const btnSubmit = document.getElementById('btnSubmitRestorePetugas');

            if (!fileInput.files.length) {
                return alert('Silakan pilih berkas JSON cadangan terlebih dahulu!');
            }

            if (!confirm('Apakah Anda yakin ingin memulihkan data ini?')) {
                return;
            }

            btnSubmit.disabled = true;
            btnSubmit.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses...';

            const formData = new FormData();
            formData.append('file_backup', fileInput.files[0]);
            formData.append('userId', '<%= userId %>');

            fetch('/api/backup/restore', {
                method: 'POST',
                body: formData
            })
            .then(async (res) => {
                const data = await res.json();
                alert(data.message);
                if (data.success) {
                    window.location.reload();
                } else {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = '<i class="fa-solid fa-rotate-left"></i> Restore';
                }
            })
            .catch(err => {
                alert('Gagal memproses berkas! Pastikan format file .json valid.');
                btnSubmit.disabled = false;
                btnSubmit.innerHTML = '<i class="fa-solid fa-rotate-left"></i> Restore';
            });
        }

        function cekStatusWA() {
            fetch(`/api/wa-status?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    const statusText = document.getElementById('waStatusText');
                    const qrContainer = document.getElementById('qrContainer');
                    const qrImage = document.getElementById('qrImageWA');
                    const pairingContainer = document.getElementById('pairingContainer');
                    const pairingCodeText = document.getElementById('pairingCodeText');

                    if (!statusText) return;

                    if (data.statusWA === 'TERHUBUNG') {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-emerald-700 font-bold">Terhubung & Siap Terkirim ✅</span>`;
                        if(qrContainer) qrContainer.classList.add('hidden');
                        if(pairingContainer) pairingContainer.classList.add('hidden');
                    } else if (data.pairingCode) {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-blue-700 font-bold">Masukkan Kode di WA HP 📲</span>`;
                        if(pairingCodeText) pairingCodeText.innerText = data.pairingCode;
                        if(pairingContainer) pairingContainer.classList.remove('hidden');
                        if(qrContainer) qrContainer.classList.add('hidden');
                    } else if (data.qrCodeWA) {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Pindai Kode QR Di Bawah 📲</span>`;
                        if(qrImage) qrImage.src = data.qrCodeWA;
                        if(qrContainer) qrContainer.classList.remove('hidden');
                        if(pairingContainer) pairingContainer.classList.add('hidden');
                    } else if (data.statusWA === 'MENUNGGU_PAIRING_CODE' || data.statusWA === 'PROSES_INIT') {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Menyiapkan Tautan WA... ⏳</span>`;
                    } else {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-rose-600 font-bold">Belum Terhubung ❌</span>`;
                        if(qrContainer) qrContainer.classList.add('hidden');
                        if(pairingContainer) pairingContainer.classList.add('hidden');
                    }
                })
                .catch(err => console.error("Gagal cek WA status:", err));
        }

        function mintaQRWA() {
            const btn = document.getElementById('btnGenerateWA');
            const statusText = document.getElementById('waStatusText');
            if (btn) {
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
                btn.disabled = true;
            }
            if (statusText) {
                statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Menyiapkan QR Code... ⏳</span>`;
            }

            fetch(`/api/start-wa?userId=${currentUserId}`)
                .then(() => {
                    setTimeout(() => {
                        if (btn) {
                            btn.innerHTML = `<i class="fa-solid fa-qrcode"></i> Scan QR`;
                            btn.disabled = false;
                        }
                        cekStatusWA();
                    }, 3000);
                });
        }

        function mintaPairingWA() {
            const noHp = prompt("Masukkan Nomor WhatsApp Petugas (Contoh: 082371729760):");
            if (!noHp) return;

            const btn = document.getElementById('btnPairingWA');
            const statusText = document.getElementById('waStatusText');
            
            if (btn) {
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
                btn.disabled = true;
            }
            if (statusText) {
                statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Menyiapkan Tautan WA... ⏳</span>`;
            }

            fetch(`/api/request-pairing?userId=${currentUserId}&phone=${encodeURIComponent(noHp)}`)
                .then(res => res.json())
                .then(data => {
                    setTimeout(() => {
                        if (btn) {
                            btn.innerHTML = `<i class="fa-solid fa-mobile-screen-button"></i> Pakai Nomor WA`;
                            btn.disabled = false;
                        }
                        cekStatusWA();
                    }, 4000);
                })
                .catch(err => {
                    console.error("Error minta pairing:", err);
                    if (btn) {
                        btn.innerHTML = `<i class="fa-solid fa-mobile-screen-button"></i> Pakai Nomor WA`;
                        btn.disabled = false;
                    }
                    cekStatusWA();
                });
        }

        function resetWA() {
            if (!confirm('Apakah Anda yakin ingin mereset sesi WhatsApp Petugas?')) return;
            fetch(`/api/reset-wa?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    alert(data.message);
                    cekStatusWA();
                });
        }

        function prosesImportExcel(e) {
            e.preventDefault();
            const fileInput = document.getElementById('fileExcelInput');
            const btn = document.getElementById('btnImportExcel');

            if (!fileInput.files.length) return alert("Pilih berkas Excel terlebih dahulu!");

            const formData = new FormData();
            formData.append('file_excel', fileInput.files[0]);

            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
            btn.disabled = true;

            fetch('/api/siswa/import-excel', {
                method: 'POST',
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message);
                btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Upload & Impor Data`;
                btn.disabled = false;
                if (data.success) location.reload();
            })
            .catch(err => {
                console.error("Error Import:", err);
                alert("Terjadi kesalahan saat mengunggah berkas.");
                btn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> Upload & Impor Data`;
                btn.disabled = false;
            });
        }

        function bukaModalEditSiswa(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));
            const wa = decodeURIComponent(btn.getAttribute('data-wa'));
            const kelasId = btn.getAttribute('data-kelas');

            document.getElementById('formEditSiswa').action = `/api/siswa/edit/${id}`;
            document.getElementById('editNamaSiswa').value = nama;
            document.getElementById('editWaSiswa').value = wa;
            document.getElementById('editKelasSiswa').value = kelasId;
            document.getElementById('modalEditSiswa').classList.remove('hidden');
        }

        function tutupModalEditSiswa() {
            document.getElementById('modalEditSiswa').classList.add('hidden');
        }

        function hapusSiswa(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));

            if (confirm(`Hapus data siswa "${nama}"?`)) {
                const formHapus = document.getElementById('formHapusUmum');
                formHapus.action = `/api/siswa/hapus/${id}`;
                formHapus.submit();
            }
        }

        function bukaSidebar() {
            document.getElementById('sidebarMenu').classList.remove('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.remove('hidden');
        }

        function tutupSidebar() {
            document.getElementById('sidebarMenu').classList.add('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.add('hidden');
        }

        function muatPreview() {
            const bulan = document.getElementById('selectBulan').value;
            const tahun = document.getElementById('selectTahun').value;
            const kelasId = document.getElementById('kelasId').value;
            const previewArea = document.getElementById('previewArea');
            const tbody = document.getElementById('previewTableBody');
            const countTag = document.getElementById('previewCount');

            tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-500 italic"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Memuat data rekapitulasi...</td></tr>`;
            previewArea.classList.remove('hidden');

            fetch(`/api/absensi/preview?bulan=${bulan}&tahun=${tahun}&kelas_id=${kelasId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.data.length > 0) {
                        countTag.innerText = `${data.data.length} Siswa`;
                        tbody.innerHTML = data.data.map((item, index) => `
                            <tr class="hover:bg-slate-50 border-b border-slate-100">
                                <td class="p-2.5 text-center font-mono">${index + 1}</td>
                                <td class="p-2.5 font-semibold text-slate-900">${item.nama_siswa}</td>
                                <td class="p-2.5 text-slate-600">${item.nama_kelas}</td>
                                <td class="p-2.5 text-center font-bold text-emerald-700 bg-emerald-50/50">${item.total_hadir} Hari</td>
                            </tr>
                        `).join('');
                    } else {
                        countTag.innerText = '0 Siswa';
                        tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400 italic">Tidak ada data kehadiran pada bulan dan tahun yang dipilih.</td></tr>`;
                    }
                })
                .catch(err => {
                    console.error("Preview error:", err);
                    tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-rose-500 font-medium">Gagal memuat pratinjau data.</td></tr>`;
                });
        }

        document.getElementById('formSettings')?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const nama_sekolah = document.getElementById('namaSekolahInput').value;
            
            try {
                const res = await fetch('/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ nama_sekolah })
                });
                const data = await res.json();
                if(data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            } catch(err) {
                alert('Terjadi kesalahan koneksi!');
            }
        });

        // Jalankan pengecekan otomatis per 3 detik
        setInterval(cekStatusWA, 3000);
        document.addEventListener("DOMContentLoaded", cekStatusWA);
    </script>

