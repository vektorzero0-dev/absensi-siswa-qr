<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Petugas Absen - SISTEM ABSENSI DIGITAL</title>
    
    <!-- CSS Bootstrap 5 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <!-- CSS Pendukung -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        body { font-family: 'Plus Jakarta Sans', sans-serif; }

        .offcanvas { z-index: 1055 !important; }
        .offcanvas-backdrop { z-index: 1050 !important; }

        .bg-light-animated {
            background: linear-gradient(-45deg, #e0f2fe, #f0fdf4, #fef3c7, #f1f5f9);
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
            background-image: 
                radial-gradient(rgba(15, 23, 42, 0.05) 1.2px, transparent 1.2px),
                linear-gradient(-45deg, #e0f2fe, #f0fdf4, #fef3c7, #e2e8f0);
            background-size: 20px 20px, 400% 400%;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

        @keyframes pulseGlow {
            0%, 100% { opacity: 0.3; transform: scale(1); }
            50% { opacity: 0.7; transform: scale(1.2); }
        }
        .animate-glow { animation: pulseGlow 5s infinite ease-in-out; }

        .card-pro {
            position: relative;
            overflow: hidden;
            border-radius: 1.25rem;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .card-pro::before {
            content: "";
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background-image: radial-gradient(rgba(15, 23, 42, 0.04) 1px, transparent 1px);
            background-size: 14px 14px;
            pointer-events: none;
        }

        .card-pro:hover {
            transform: translateY(-4px) scale(1.005);
            box-shadow: 0 20px 30px -10px rgba(0, 0, 0, 0.12);
        }

        .card-amber-theme {
            background: linear-gradient(135deg, #ffffff 0%, #fffbeb 100%);
            border: 1px solid #fde68a;
        }
        .card-emerald-theme {
            background: linear-gradient(135deg, #ffffff 0%, #ecfdf5 100%);
            border: 1px solid #a7f3d0;
        }
        .card-blue-theme {
            background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%);
            border: 1px solid #bfdbfe;
        }
        .card-purple-theme {
            background: linear-gradient(135deg, #ffffff 0%, #faf5ff 100%);
            border: 1px solid #e9d5ff;
        }

        @keyframes fadeInSoft {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in { animation: fadeInSoft 0.4s ease-out forwards; }

        button, .btn-interactive { transition: all 0.2s ease-in-out; }
        button:active, .btn-interactive:active { transform: scale(0.96); }
    </style>
</head>
<body class="bg-light-animated text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

<!-- NAVBAR HEADER ATAS -->
<nav class="bg-slate-900/90 backdrop-blur-md text-white sticky top-0 z-30 shadow-md px-4 py-3 flex items-center justify-between border-b border-amber-500/50">
  <div class="flex items-center gap-3">
    <button type="button" onclick="bukaSidebar()" class="btn-interactive bg-blue-800 hover:bg-blue-700 text-white px-3 py-1.5 rounded-xl border border-blue-600 font-bold text-xs flex items-center gap-2 transition shadow-sm">
      <i class="fa-solid fa-bars text-sm"></i> <span>Menu</span>
    </button>
    
    <span class="font-bold text-xs sm:text-sm tracking-wide text-amber-400 uppercase truncate">
      <%= typeof namaSekolah !== 'undefined' ? namaSekolah : 'NAMA SEKOLAH BELUM DIATUR' %>
    </span>
  </div>

  <div class="text-xs text-slate-300 hidden sm:block">
    <i class="fa-solid fa-user-shield text-amber-400 mr-1"></i> Panel Petugas Absen
  </div>
</nav>

<!-- SIDEBAR SLIDE PETUGAS -->
<div id="sidebarMenu" class="fixed top-0 left-0 h-full w-[260px] bg-white text-slate-800 shadow-2xl z-50 transition-all duration-300 -translate-x-full flex flex-col justify-between border-r border-slate-200">
  <div>
    <div class="bg-slate-900 text-white p-4 flex justify-between items-center border-b border-slate-800">
      <h5 class="font-bold text-xs uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid fa-shield-halved text-amber-400"></i> Menu Navigasi
      </h5>
      <button type="button" onclick="tutupSidebar()" class="text-slate-400 hover:text-white text-lg font-bold px-2">
        &times;
      </button>
    </div>
    
    <div class="p-2 space-y-1 text-xs">
      <a href="/petugas?userId=<%= userId %>" class="flex items-center gap-3 p-3 font-semibold bg-blue-50 text-blue-900 rounded-xl">
        <i class="fa-solid fa-house text-blue-700"></i> Dashboard Utama
      </a>
      <a href="#section-backup" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-database text-emerald-600"></i> Backup & Restore Data
      </a>
      <a href="/scan?userId=<%= userId %>" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-qrcode text-emerald-600"></i> Pemindai QR Presensi
      </a>
      <a href="/admin/cetak-kartu?userId=<%= userId %>" target="_blank" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-address-card text-purple-600"></i> Cetak Kartu Siswa
      </a>
      <a href="#section-settings" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-school text-amber-600"></i> Pengaturan Sekolah
      </a>
      <a href="#section-wa-gateway" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-brands fa-whatsapp text-emerald-600"></i> Integrasi WhatsApp
      </a>
      <a href="#section-rekap-bulanan" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-file-invoice text-purple-600"></i> Rekap Presensi Bulanan
      </a>
      <a href="#section-dapodik" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-file-excel text-emerald-600"></i> Impor Excel Dapodik
      </a>
      <a href="#section-rombel" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-school text-purple-600"></i> Kelola Rombel
      </a>
      <a href="#section-siswa" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-users text-blue-600"></i> Direktori Siswa
      </a>
      <a href="#section-presensi" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-clipboard-check text-amber-600"></i> Presensi Hari Ini
      </a>
    </div>
  </div>

  <div class="p-4 border-t border-slate-100">
    <a href="/" class="flex items-center justify-center gap-2 w-full bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs py-2.5 rounded-xl transition">
      <i class="fa-solid fa-right-from-bracket"></i> Keluar (Logout)
    </a>
  </div>
</div>

<div id="sidebarOverlay" onclick="tutupSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden transition-opacity backdrop-blur-xs"></div>

    <header class="bg-gradient-to-r from-blue-900 via-slate-900 to-indigo-900 text-white shadow-lg border-b-4 border-amber-500 relative overflow-hidden">
        <div class="absolute -top-12 left-1/4 w-48 h-48 bg-blue-500/20 rounded-full blur-3xl animate-glow pointer-events-none"></div>
        <div class="absolute -bottom-10 right-10 w-36 h-36 bg-amber-400/20 rounded-full blur-3xl animate-glow pointer-events-none" style="animation-delay: 2.5s;"></div>

        <div class="max-w-6xl mx-auto px-4 py-3.5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 relative z-10">
            <div class="flex items-center gap-3">
                <div class="bg-gradient-to-tr from-amber-500 to-amber-300 p-2 rounded-xl text-slate-950 shadow-md">
                    <i class="fa-solid fa-user-shield text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-sm md:text-base font-extrabold tracking-wide uppercase text-slate-100">SISTEM ABSENSI DIGITAL</h1>
                    <p class="text-[11px] text-blue-200">Panel Petugas Absen Presensi Sekolah</p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="btn-interactive flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-3.5 py-2 rounded-xl shadow transition flex items-center gap-1.5">
                    <i class="fa-solid fa-qrcode text-sm"></i> Pemindai Presensi (Scanner)
                </a>
                <a href="/" class="btn-interactive bg-slate-800/80 hover:bg-slate-700 text-slate-200 text-xs px-3 py-2 rounded-xl border border-slate-700 transition flex items-center gap-1">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto w-full p-4 md:p-6 flex-1 animate-fade-in">

        <div class="card-pro card-amber-theme p-4 mb-6 flex items-center justify-between">
            <div class="flex items-center gap-3 relative z-10">
                <div class="bg-amber-600 text-white p-3 rounded-xl shadow-md">
                    <i class="fa-solid fa-user-check text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold bg-amber-100 text-amber-900 border border-amber-300 px-2 py-0.5 rounded uppercase tracking-wider">Hak Akses: Petugas Absen</span>
                    <h2 class="text-base font-bold text-slate-900 mt-0.5">Dashboard Operasional Presensi Siswa</h2>
                </div>
            </div>
        </div>

        <!-- MODUL BACKUP & RESTORE DATA -->
        <div id="section-backup" class="card-pro card-emerald-theme p-5 mb-6">
            <div class="flex items-center gap-3 mb-4 border-b border-emerald-200/60 pb-2 relative z-10">
                <div class="bg-emerald-600 text-white p-2.5 rounded-xl shadow-md">
                    <i class="fa-solid fa-database text-lg"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Cadangan & Pemulihan Data Sekolah</h3>
                    <p class="text-[11px] text-slate-600">Unduh berkas cadangan JSON atau pulihkan data operasional presensi sekolah.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 relative z-10">
                <div class="bg-white/80 p-4 rounded-xl border border-emerald-200 flex flex-col justify-between">
                    <div>
                        <h4 class="text-xs font-bold text-slate-900 flex items-center gap-2 mb-1">
                            <i class="fa-solid fa-file-arrow-down text-emerald-600"></i> 1. Unduh File Backup (.JSON)
                        </h4>
                        <p class="text-[11px] text-slate-600 mb-3">
                            Unduh salinan data siswa, rombel, dan absensi sekolah untuk cadangan internal.
                        </p>
                    </div>
                    <a href="/api/backup/export?userId=<%= userId %>" class="btn-interactive w-full bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs py-2.5 px-4 rounded-xl transition flex items-center justify-center gap-2 shadow-md">
                        <i class="fa-solid fa-download"></i> Unduh Cadangan Data
                    </a>
                </div>

                <div class="bg-white/80 p-4 rounded-xl border border-emerald-200 flex flex-col justify-between">
                    <div>
                        <h4 class="text-xs font-bold text-slate-900 flex items-center gap-2 mb-1">
                            <i class="fa-solid fa-file-arrow-up text-amber-600"></i> 2. Pulihkan Data Dari File JSON
                        </h4>
                        <p class="text-[11px] text-slate-600 mb-3">
                            Pilih berkas format .json untuk memulihkan data yang tersimpan sebelumnya.
                        </p>
                    </div>
                    <form id="formRestorePetugas" onsubmit="prosesRestorePetugas(event)" class="flex gap-2">
                        <input type="file" id="inputBackupJsonPetugas" accept=".json" required class="flex-1 text-xs text-slate-700 file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-amber-100 file:text-amber-800 hover:file:bg-amber-200 border border-slate-300 rounded-xl p-1 bg-white">
                        <button type="submit" id="btnSubmitRestorePetugas" class="btn-interactive bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs px-4 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5 border border-amber-700 whitespace-nowrap shadow-md">
                            <i class="fa-solid fa-rotate-left"></i> Restore
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <div class="card-pro card-emerald-theme p-4 flex items-center justify-between">
                <div class="relative z-10">
                    <p class="text-xs text-slate-600 font-medium">Total Peserta Didik</p>
                    <h3 class="text-xl font-bold text-emerald-800 mt-1"><%= siswaList ? siswaList.length : 0 %> <span class="text-xs font-normal text-slate-500">Siswa</span></h3>
                </div>
                <div class="bg-emerald-600 text-white p-3 rounded-xl relative z-10 shadow-md">
                    <i class="fa-solid fa-user-graduate text-lg"></i>
                </div>
            </div>

            <div class="card-pro card-purple-theme p-4 flex items-center justify-between">
                <div class="relative z-10">
                    <p class="text-xs text-slate-600 font-medium">Rombongan Belajar (Rombel)</p>
                    <h3 class="text-xl font-bold text-purple-900 mt-1"><%= kelasList ? kelasList.length : 0 %> <span class="text-xs font-normal text-slate-500">Kelas</span></h3>
                </div>
                <div class="bg-purple-600 text-white p-3 rounded-xl relative z-10 shadow-md">
                    <i class="fa-solid fa-school text-lg"></i>
                </div>
            </div>
        </div>

        <!-- SEKSI REKAP BULANAN -->
        <div id="section-rekap-bulanan" class="card-pro card-purple-theme p-5 mb-6">
            <div class="flex items-center gap-3 mb-4 border-b border-purple-200/60 pb-2 relative z-10">
                <div class="bg-purple-600 text-white p-2.5 rounded-xl shadow-md">
                    <i class="fa-solid fa-file-invoice text-lg"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Pratinjau & Unduh Rekap Presensi Bulanan</h3>
                    <p class="text-[11px] text-slate-600">Pilih periode dan kelas untuk menampilkan pratinjau data rekap sebelum mengunduh berkas laporan</p>
                </div>
            </div>

            <form id="filterForm" action="/api/absensi/export" method="GET" target="_blank" class="grid grid-cols-1 sm:grid-cols-6 gap-3 mb-4 relative z-10">
                
                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Pilih Kelas</label>
                    <select name="kelas_id" id="kelasId" class="w-full text-xs p-2 bg-white border border-purple-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-600">
                        <option value="all">-- Semua Kelas --</option>
                        <% if (kelasList && kelasList.length > 0) { %>
                            <% kelasList.forEach(k => { %>
                                <option value="<%= k.id %>"><%= k.nama_kelas %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Pilih Bulan</label>
                    <select name="bulan" id="selectBulan" required class="w-full text-xs p-2 bg-white border border-purple-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-600">
                        <option value="1">Januari</option>
                        <option value="2">Februari</option>
                        <option value="3">Maret</option>
                        <option value="4">April</option>
                        <option value="5">Mei</option>
                        <option value="6">Juni</option>
                        <option value="7">Juli</option>
                        <option value="8">Agustus</option>
                        <option value="9" selected>September</option>
                        <option value="10">Oktober</option>
                        <option value="11">November</option>
                        <option value="12">Desember</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Pilih Tahun</label>
                    <select name="tahun" id="selectTahun" required class="w-full text-xs p-2 bg-white border border-purple-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-600">
                        <option value="2026" selected>2026</option>
                        <option value="2025">2025</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Format Berkas</label>
                    <select name="format" required class="w-full text-xs p-2 bg-white border border-purple-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-purple-600">
                        <option value="excel">📊 Excel (.xlsx)</option>
                        <option value="word">📝 Word (.docx)</option>
                        <option value="pdf">📄 PDF (.pdf)</option>
                    </select>
                </div>

                <div class="flex items-end">
                    <button type="button" onclick="muatPreview()" class="btn-interactive w-full bg-blue-800 hover:bg-blue-900 text-white font-semibold text-xs py-2 px-3 rounded-xl transition flex items-center justify-center gap-1.5 shadow-md">
                        <i class="fa-solid fa-eye"></i> Lihat Rekapan
                    </button>
                </div>

                <div class="flex items-end">
                    <button type="submit" class="btn-interactive w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-2 px-3 rounded-xl transition flex items-center justify-center gap-1.5 shadow-md">
                        <i class="fa-solid fa-download"></i> Unduh Berkas
                    </button>
                </div>
            </form>

            <div id="previewArea" class="hidden border border-purple-200 rounded-xl p-4 bg-white/80 relative z-10">
                <div class="flex justify-between items-center mb-3">
                    <h4 id="previewTitle" class="text-xs font-bold text-slate-800 uppercase tracking-wide">
                        Hasil Pratinjau Rekapitulasi
                    </h4>
                    <span id="previewCount" class="text-[10px] bg-purple-100 text-purple-800 border border-purple-200 px-2 py-0.5 rounded font-bold">
                        0 Siswa
                    </span>
                </div>
                <div class="overflow-x-auto bg-white rounded-lg border border-slate-200">
                    <table class="w-full text-xs text-left text-slate-700 border-collapse">
                        <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] font-semibold border-b border-slate-200">
                            <tr>
                                <th class="p-2.5">No</th>
                                <th class="p-2.5">Nama Siswa</th>
                                <th class="p-2.5">Rombel</th>
                                <th class="p-2.5 text-center">Total Kehadiran</th>
                            </tr>
                        </thead>
                        <tbody id="previewTableBody" class="divide-y divide-slate-100">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="section-settings" class="card-pro card-amber-theme p-5 mb-6">
            <div class="flex items-center gap-3 mb-3 border-b border-amber-200/60 pb-2 relative z-10">
                <div class="bg-amber-600 text-white p-2.5 rounded-xl shadow-md">
                    <i class="fa-solid fa-school text-lg"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-xs uppercase tracking-wider">Pengaturan Identitas Sekolah</h3>
                    <p class="text-[11px] text-slate-600">Ubah nama instansi/sekolah yang akan ditampilkan pada header dan laporan.</p>
                </div>
            </div>

            <form id="formSettings" class="flex flex-col sm:flex-row items-center gap-3 relative z-10">
                <input type="text" id="namaSekolahInput" name="nama_sekolah" placeholder="Contoh: SD NEGERI 2 KARYA MULYA" value="<%= typeof namaSekolah !== 'undefined' ? namaSekolah : '' %>" required class="flex-1 text-xs text-slate-800 border border-amber-300 rounded-xl p-2.5 w-full bg-white focus:outline-none focus:ring-2 focus:ring-amber-600">
                
                <button type="submit" class="btn-interactive w-full sm:w-auto bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5 border border-amber-700 whitespace-nowrap shadow-md">
                    <i class="fa-solid fa-floppy-disk"></i> Simpan Nama Sekolah
                </button>
            </form>
        </div>

        <div id="section-wa-gateway" class="card-pro card-emerald-theme p-5 mb-6 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3 relative z-10">
                <div class="p-3 rounded-xl bg-emerald-600 text-white shadow-md">
                    <i class="fa-brands fa-whatsapp text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Status WhatsApp Gateway Petugas</h3>
                    <p class="text-xs text-slate-600 mt-0.5" id="waStatusText">
                        <% if (typeof waMode !== 'undefined' && waMode === 'TANPA_WA') { %>
                            Koneksi Layanan: <span class="text-slate-500 font-bold">Fitur Notifikasi WA Nonaktif (TANPA_WA) 🚫</span>
                        <% } else { %>
                            Koneksi Layanan: <span class="text-slate-500 font-bold">Memeriksa status...</span>
                        <% } %>
                    </p>
                </div>
