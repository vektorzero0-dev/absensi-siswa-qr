<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Wali Kelas - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    
    <!-- CSS Tailwind & FontAwesome -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- EFEK ANIMASI & DOKUMEN PRO (TINGGAL PASANG) -->
<style>
  /* Scrollbar lebih rapi */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #f1f5f9; }
  ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

  /* Efek elemen muncul perlahan (smooth) */
  @keyframes fadeInSoft {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeInSoft 0.3s ease-out forwards;
  }

  /* Kartu berinteraksi saat kursor di atasnya */
  .card-pro {
    transition: all 0.2s ease-in-out;
  }
  .card-pro:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.06);
  }

  /* Tombol terasa membal halus saat diklik */
  button, .btn-interactive {
    transition: all 0.15s ease-in-out;
  }
  button:active, .btn-interactive:active {
    transform: scale(0.97);
  }
</style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

<!-- NAVBAR HEADER ATAS -->
<nav class="bg-emerald-800 text-white sticky top-0 z-30 shadow-md px-4 py-3 flex items-center justify-between border-b-2 border-emerald-500">
  <div class="flex items-center gap-3">
    <!-- Tombol Pembuka Slide Menu -->
    <button type="button" onclick="bukaSidebar()" class="bg-emerald-700 hover:bg-emerald-600 text-white px-3 py-1.5 rounded-lg border border-emerald-500 font-bold text-xs flex items-center gap-2 transition shadow-sm">
      <i class="fa-solid fa-bars text-sm"></i> <span>Menu</span>
    </button>
    
    <span class="font-bold text-xs sm:text-sm tracking-wide text-emerald-100 uppercase truncate">
      UPTD SD NEGERI 1 KARYA MULYA SARI
    </span>
  </div>

  <!-- SUDAH DIPERBAIKI: Menampilkan Portal Wali Kelas (bukan Panel Admin) -->
  <div class="text-xs text-emerald-100 hidden sm:block">
    <i class="fa-solid fa-user-chalkboard text-emerald-300"></i> Portal Wali Kelas
  </div>
</nav>

<!-- SIDEBAR SLIDE WALI KELAS -->
<div id="sidebarMenu" class="fixed top-0 left-0 h-full w-[260px] bg-white text-slate-800 shadow-2xl z-50 transition-all duration-300 -translate-x-full flex flex-col justify-between border-r border-slate-200">
  <div>
    <!-- Header Sidebar -->
    <div class="bg-emerald-800 text-white p-4 flex justify-between items-center border-b border-emerald-700">
      <h5 class="font-bold text-xs uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid fa-graduation-cap text-amber-400"></i> Menu Navigasi
      </h5>
      <button type="button" onclick="tutupSidebar()" class="text-emerald-200 hover:text-white text-lg font-bold px-2">
        &times;
      </button>
    </div>
    
    <!-- Link Navigasi Khusus Wali Kelas -->
    <div class="p-2 space-y-1 text-xs">
      <a href="/wali?userId=<%= userId %>" class="flex items-center gap-3 p-3 font-semibold bg-emerald-50 text-emerald-900 rounded-xl">
        <i class="fa-solid fa-house text-emerald-700"></i> Dashboard Utama
      </a>
      <a href="/scan?userId=<%= userId %>" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-qrcode text-emerald-600"></i> Pemindai QR Presensi
      </a>
      <a href="#section-wa-gateway" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-brands fa-whatsapp text-emerald-600"></i> Status Bot WA
      </a>
      <a href="#section-rekap-bulanan" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-file-invoice text-blue-600"></i> Rekap Presensi Bulanan
      </a>
      <a href="#section-siswa-kelas" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-users text-blue-600"></i> Daftar Siswa Kelas
      </a>
      <a href="#section-absensi-today" onclick="tutupSidebar()" class="flex items-center gap-3 p-3 font-semibold text-slate-700 hover:bg-slate-100 rounded-xl transition">
        <i class="fa-solid fa-clipboard-user text-amber-600"></i> Presensi Hari Ini
      </a>
    </div>
  </div>

  <!-- Tombol Keluar / Logout -->
  <div class="p-4 border-t border-slate-100">
    <a href="/" class="flex items-center justify-center gap-2 w-full bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 font-bold text-xs py-2.5 rounded-xl transition">
      <i class="fa-solid fa-right-from-bracket"></i> Keluar (Logout)
    </a>
  </div>
</div>

<!-- Latar Belakang Gelap (Backdrop Overlay) -->
<div id="sidebarOverlay" onclick="tutupSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden transition-opacity"></div>

    <header class="bg-blue-900 text-white shadow-md border-b-4 border-emerald-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-white/10 p-2 rounded-lg border border-white/20">
                    <i class="fa-solid fa-graduation-cap text-2xl text-amber-400"></i>
                </div>
                <div>
                    <h1 class="text-sm md:text-base font-bold tracking-wide uppercase">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                    <p class="text-[11px] text-blue-200">Portal Kehadiran Siswa & Pemindai WhatsApp Gateway</p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-3.5 py-2 rounded-xl shadow transition flex items-center gap-1.5">
                    <i class="fa-solid fa-qrcode text-sm"></i> Pemindai Presensi (Scanner)
                </a>
                <a href="/" class="bg-blue-950 hover:bg-blue-800 text-blue-100 text-xs px-3 py-2 rounded-xl border border-blue-700 transition flex items-center gap-1">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto w-full p-4 md:p-6 flex-1">

        <div class="bg-white border border-slate-200 rounded-2xl p-4 mb-6 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-blue-100 text-blue-800 p-3 rounded-xl">
                    <i class="fa-solid fa-user-chalkboard text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold bg-blue-50 text-blue-800 border border-blue-200 px-2.5 py-0.5 rounded uppercase tracking-wider">
                        Penugasan Rombel: <%= user.nama_kelas %>
                    </span>
                    <h2 class="text-base font-bold text-slate-900 mt-0.5">Selamat Datang, <%= user.nama %></h2>
                </div>
            </div>
        </div>

        <!-- WA Gateway Panel Dynamic -->
        <div id="section-wa-gateway" class="bg-white border border-slate-200 rounded-2xl p-5 mb-6 shadow-sm flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-3 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100">
                    <i class="fa-brands fa-whatsapp text-2xl"></i>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Status WhatsApp Gateway Notifikasi</h3>
                    <p class="text-xs text-slate-600 mt-0.5" id="waStatusText">
                        Koneksi Layanan: <span class="text-slate-500 font-bold">Memeriksa status...</span>
                    </p>
                </div>
            </div>

            <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                <div id="qrContainer" class="hidden bg-white p-1.5 rounded-xl shadow border border-slate-300 flex flex-col items-center">
                    <img id="qrImageWA" src="" alt="Scan QR WA" class="w-28 h-28">
                    <span class="text-[9px] text-slate-500 mt-1 font-mono">Pindai dengan WA</span>
                </div>

                <div id="pairingContainer" class="hidden bg-blue-50 p-3 rounded-xl border border-blue-200 text-center min-w-[200px]">
                    <span class="text-[10px] text-blue-800 font-medium block">Kode Tautan WhatsApp Anda:</span>
                    <strong id="pairingCodeText" class="text-xl font-mono text-blue-900 tracking-widest my-1 block">-</strong>
                    <span class="text-[9px] text-blue-700 block">Masukkan di WA HP (Tautkan dg nomor)</span>
                </div>

                <div class="flex flex-wrap gap-2 w-full sm:w-auto justify-end">
                    <button type="button" onclick="mintaQRWA()" id="btnGenerateWA" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3.5 py-2.5 rounded-xl border border-emerald-700 font-semibold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-qrcode"></i> Scan QR
                    </button>

                    <button type="button" onclick="mintaPairingWA()" id="btnPairingWA" class="bg-blue-800 hover:bg-blue-900 text-white text-xs px-3.5 py-2.5 rounded-xl border border-blue-900 font-semibold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-mobile-screen-button"></i> Pakai Nomor WA
                    </button>

                    <button type="button" onclick="resetWA()" id="btnResetWA" class="bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs px-3 py-2.5 rounded-xl border border-rose-200 font-semibold transition flex items-center gap-1.5">
                        <i class="fa-solid fa-trash"></i> Reset
                    </button>
                </div>
            </div>
        </div>

        <!-- Panel Filter, Pratinjau & Unduh Rekap Presensi Bulanan -->
        <div id="section-rekap-bulanan" class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex items-center gap-3 mb-4 border-b border-slate-100 pb-2">
                <div class="bg-blue-50 text-blue-800 p-2.5 rounded-xl border border-blue-200">
                    <i class="fa-solid fa-file-invoice text-lg"></i>
                </div>
                <div>
                    <h3 class="font-bold text-slate-800 text-xs uppercase tracking-wider">Pratinjau & Unduh Rekap Presensi Bulanan</h3>
                    <p class="text-[11px] text-slate-500">Pilih periode untuk menampilkan pratinjau data rekap sebelum mengunduh berkas laporan</p>
                </div>
            </div>

            <form id="filterForm" action="/api/absensi/export" method="GET" target="_blank" class="grid grid-cols-1 sm:grid-cols-5 gap-3 mb-4">
                <input type="hidden" name="kelas_id" id="kelasId" value="<%= user.kelas_id %>">
                
                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Pilih Bulan</label>
                    <select name="bulan" id="selectBulan" required class="w-full text-xs p-2 bg-slate-50 border border-slate-300 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-600">
                        <option value="1">Januari</option>
                        <option value="2">Februari</option>
                        <option value="3">Maret</option>
                        <option value="4">April</option>
                        <option value="5">Mei</option>
                        <option value="6">Juni</option>
                        <option value="7">Juli</option>
                        <option value="8">Agustus</option>
                        <option value="9" selected>September</option>
                        <option value="10">Oktober</option>
                        <option value="11">November</option>
                        <option value="12">Desember</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Pilih Tahun</label>
                    <select name="tahun" id="selectTahun" required class="w-full text-xs p-2 bg-slate-50 border border-slate-300 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-600">
                        <option value="2026" selected>2026</option>
                        <option value="2025">2025</option>
                    </select>
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Format Berkas</label>
                    <select name="format" required class="w-full text-xs p-2 bg-slate-50 border border-slate-300 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-600">
                        <option value="excel">📊 Excel (.xlsx)</option>
                        <option value="word">📝 Word (.docx)</option>
                        <option value="pdf">📄 PDF (.pdf)</option>
                    </select>
                </div>

                <div class="flex items-end">
                    <button type="button" onclick="muatPreview()" class="w-full bg-blue-800 hover:bg-blue-900 text-white font-semibold text-xs py-2 px-3 rounded-xl transition flex items-center justify-center gap-1.5 border border-blue-900">
                        <i class="fa-solid fa-eye"></i> Lihat Rekapan
                    </button>
                </div>

                <div class="flex items-end">
                    <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-2 px-3 rounded-xl transition flex items-center justify-center gap-1.5 border border-emerald-700">
                        <i class="fa-solid fa-download"></i> Unduh Berkas
                    </button>
                </div>
            </form>

            <div id="previewArea" class="hidden border border-slate-200 rounded-xl p-4 bg-slate-50">
                <div class="flex justify-between items-center mb-3">
                    <h4 id="previewTitle" class="text-xs font-bold text-slate-800 uppercase tracking-wide">
                        Hasil Pratinjau Rekapitulasi
                    </h4>
                    <span id="previewCount" class="text-[10px] bg-blue-100 text-blue-800 border border-blue-200 px-2 py-0.5 rounded font-bold">
                        0 Siswa
                    </span>
                </div>
                <div class="overflow-x-auto bg-white rounded-lg border border-slate-200">
                    <table class="w-full text-xs text-left text-slate-700 border-collapse">
                        <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] font-semibold border-b border-slate-200">
                            <tr>
                                <th class="p-2.5">No</th>
                                <th class="p-2.5">Nama Siswa</th>
                                <th class="p-2.5">Rombel</th>
                                <th class="p-2.5 text-center">Total Kehadiran</th>
                            </tr>
                        </thead>
                        <tbody id="previewTableBody" class="divide-y divide-slate-100">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Form Tambah Siswa Rombel -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-slate-100 pb-2">
                <i class="fa-solid fa-user-plus text-emerald-600"></i> Registrasi Siswa Rombel (<%= user.nama_kelas %>)
            </h3>
            
            <% if (!user.kelas_id) { %>
                <div class="bg-amber-50 border border-amber-200 text-amber-800 text-xs p-3 rounded-xl">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i> Akun Anda belum terhubung ke Rombongan Belajar tertentu. Silakan hubungi Administrator Sekolah.
                </div>
            <% } else { %>
                <form action="/api/siswa/tambah" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <input type="hidden" name="kelas_id" value="<%= user.kelas_id %>">
                    
                    <div>
                        <label class="block text-[11px] text-slate-600 mb-1 font-medium">Nama Lengkap Siswa</label>
                        <input type="text" name="nama" required placeholder="Contoh: Ahmad Rizky" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                    </div>

                    <div>
                        <label class="block text-[11px] text-slate-600 mb-1 font-medium">No. WhatsApp Orang Tua / Wali</label>
                        <input type="text" name="nomor_wa_ortu" placeholder="Contoh: 082371729760" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                    </div>

                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs py-2 rounded-xl transition flex items-center justify-center gap-1.5">
                            <i class="fa-solid fa-plus"></i> Simpan Data Siswa
                        </button>
                    </div>
                </form>
            <% } %>
        </div>

        <!-- Tabel Siswa Rombel (ID DILENGKAPI: section-siswa-kelas) -->
        <div id="section-siswa-kelas" class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-users text-blue-600"></i> Daftar Peserta Didik (<%= user.nama_kelas %>)
                </h3>
                <button type="button" onclick="window.print()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3.5 py-2 rounded-xl border border-slate-300 font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-print"></i> Cetak Kartu Identitas
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-700 border-collapse min-w-[600px]">
                    <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] font-semibold border-b border-slate-200">
                        <tr>
                            <th class="p-3">ID Siswa</th>
                            <th class="p-3">Kode QR</th>
                            <th class="p-3">Nama Lengkap Siswa</th>
                            <th class="p-3">Rombel Kelas</th>
                            <th class="p-3">No. WA Orang Tua / Wali</th>
                            <th class="p-3 text-center">Tindakan</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (siswaList && siswaList.length > 0) { %>
                            <% siswaList.forEach(s => { %>
                                <tr class="hover:bg-slate-50">
                                    <td class="p-3 font-mono font-bold text-emerald-700">#<%= s.id %></td>
                                    <td class="p-3">
                                        <div class="bg-white p-1 rounded-lg inline-block border border-slate-300 shadow-sm">
                                            <img src="<%= s.qrImage %>" alt="QR <%= s.nama %>" class="w-10 h-10">
                                        </div>
                                    </td>
                                    <td class="p-3 font-semibold text-slate-900"><%= s.nama %></td>
                                    <td class="p-3">
                                        <span class="bg-blue-50 text-blue-800 border border-blue-200 text-[10px] font-bold px-2 py-0.5 rounded">
                                            <%= s.nama_kelas || '-' %>
                                        </span>
                                    </td>
                                    <td class="p-3 font-mono text-slate-700">
                                        <i class="fa-brands fa-whatsapp text-emerald-600 mr-1"></i><%= s.nomor_wa_ortu || '-' %>
                                    </td>
                                    <td class="p-3 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            <button type="button" 
                                                    data-id="<%= s.id %>" 
                                                    data-nama="<%= encodeURIComponent(s.nama) %>" 
                                                    data-wa="<%= encodeURIComponent(s.nomor_wa_ortu || '') %>" 
                                                    onclick="bukaModalEditSiswa(this)" 
                                                    class="text-emerald-700 hover:text-emerald-900 text-xs font-medium bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-lg transition flex items-center gap-1">
                                                <i class="fa-solid fa-pen-to-square"></i> Edit
                                            </button>

                                            <button type="button" 
                                                    data-id="<%= s.id %>" 
                                                    data-nama="<%= encodeURIComponent(s.nama) %>" 
                                                    onclick="hapusSiswa(this)" 
                                                    class="text-rose-600 hover:text-rose-800 text-xs font-medium bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-lg transition flex items-center gap-1">
                                                <i class="fa-solid fa-trash"></i> Hapus
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" class="p-6 text-center text-slate-400 italic">Belum ada peserta didik terdaftar pada rombel ini.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <form id="formHapusSiswa" action="" method="POST" class="hidden"></form>

        <!-- Tabel Log Absensi Hari Ini (ID DILENGKAPI: section-absensi-today) -->
        <div id="section-absensi-today" class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4 border-b border-slate-100 pb-2">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-clipboard-user text-emerald-600"></i> Rekapitulasi Presensi Kehadiran Hari Ini
                </h3>

                <form action="/api/absensi/reset-riwayat" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus SELURUH riwayat absensi uji coba?\n\nCatatan: Data siswa & rombel kelas TIDAK akan terhapus.');">
                    <button type="submit" class="bg-amber-50 hover:bg-amber-100 text-amber-700 text-[11px] font-semibold px-3 py-1.5 rounded-xl border border-amber-200 transition flex items-center gap-1.5">
                        <i class="fa-solid fa-broom text-amber-600"></i> Bersihkan Riwayat Uji Coba
                    </button>
                </form>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-700 border-collapse min-w-[400px]">
                    <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] font-semibold border-b border-slate-200">
                        <tr>
                            <th class="p-3">Nama Siswa</th>
                            <th class="p-3">Waktu Presensi</th>
                            <th class="p-3">Status Kehadiran</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (absensiHariIni && absensiHariIni.length > 0) { %>
                            <% absensiHariIni.forEach(a => { %>
                                <tr class="hover:bg-slate-50">
                                    <td class="p-3 font-semibold text-slate-900"><%= a.nama_siswa %></td>
                                    <td class="p-3 font-mono text-slate-600"><%= a.waktu_formatted %></td>
                                    <td class="p-3">
                                        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-bold px-2.5 py-0.5 rounded">
                                            HADIR
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="p-6 text-center text-slate-400 italic">Belum ada data rekaman presensi masuk untuk hari ini.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- MODAL POP-UP EDIT DATA SISWA -->
    <div id="modalEditSiswa" class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200">
            <div class="flex justify-between items-center border-b border-slate-100 pb-3 mb-4">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-user-pen text-emerald-600"></i> Edit Data Siswa / WhatsApp
                </h3>
                <button type="button" onclick="tutupModalEditSiswa()" class="text-slate-400 hover:text-slate-600">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="formEditSiswa" action="" method="POST" class="space-y-3">
                <input type="hidden" name="kelas_id" value="<%= user.kelas_id %>">

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">Nama Lengkap Siswa</label>
                    <input type="text" id="editNamaSiswa" name="nama" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                </div>

                <div>
                    <label class="block text-[11px] font-medium text-slate-600 mb-1">No. WhatsApp Ortu/Wali</label>
                    <input type="text" id="editWaSiswa" name="nomor_wa_ortu" placeholder="Contoh: 082371729760" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-xs text-slate-900 focus:outline-none focus:ring-2 focus:ring-emerald-600">
                </div>

                <div class="flex gap-2 pt-3">
                    <button type="button" onclick="tutupModalEditSiswa()" class="flex-1 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs py-2.5 rounded-xl border border-slate-300 transition">
                        Batal
                    </button>
                    <button type="submit" class="flex-1 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs py-2.5 rounded-xl border border-emerald-800 transition">
                        Simpan Perubahan
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- SCRIPT CONTROL SIDEBAR PURE JAVASCRIPT -->
    <script>
        function bukaSidebar() {
            document.getElementById('sidebarMenu').classList.remove('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.remove('hidden');
        }

        function tutupSidebar() {
            document.getElementById('sidebarMenu').classList.add('-translate-x-full');
            document.getElementById('sidebarOverlay').classList.add('hidden');
        }

        const currentUserId = "<%= userId %>";

        function cekStatusWA() {
            fetch(`/api/wa-status?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    const statusText = document.getElementById('waStatusText');
                    const qrContainer = document.getElementById('qrContainer');
                    const qrImage = document.getElementById('qrImageWA');
                    const pairingContainer = document.getElementById('pairingContainer');
                    const pairingCodeText = document.getElementById('pairingCodeText');

                    if (data.statusWA === 'TERHUBUNG') {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-emerald-700 font-bold">Terhubung & Siap Terkirim ✅</span>`;
                        qrContainer.classList.add('hidden');
                        pairingContainer.classList.add('hidden');
                    } else if (data.pairingCode) {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-blue-700 font-bold">Masukkan Kode di WA HP 📲</span>`;
                        pairingCodeText.innerText = data.pairingCode;
                        pairingContainer.classList.remove('hidden');
                        qrContainer.classList.add('hidden');
                    } else if (data.qrCodeWA) {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Pindai Kode QR Di Bawah 📲</span>`;
                        qrImage.src = data.qrCodeWA;
                        qrContainer.classList.remove('hidden');
                        pairingContainer.classList.add('hidden');
                    } else if (data.statusWA === 'MENUNGGU_PAIRING_CODE' || data.statusWA === 'MENUNGGU_SCAN') {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-amber-600 font-bold">Menyiapkan Tautan... ⏳</span>`;
                    } else {
                        statusText.innerHTML = `Koneksi Layanan: <span class="text-rose-600 font-bold">Belum Terhubung ❌</span>`;
                        qrContainer.classList.add('hidden');
                        pairingContainer.classList.add('hidden');
                    }
                })
                .catch(err => console.error("Gagal cek WA status:", err));
        }

        function mintaQRWA() {
            const btn = document.getElementById('btnGenerateWA');
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
            btn.disabled = true;

            fetch(`/api/start-wa?userId=${currentUserId}`)
                .then(() => {
                    setTimeout(() => {
                        btn.innerHTML = `<i class="fa-solid fa-qrcode"></i> Scan QR`;
                        btn.disabled = false;
                        cekStatusWA();
                    }, 2000);
                });
        }

        function mintaPairingWA() {
            const noHp = prompt("Masukkan Nomor WhatsApp Anda (Contoh: 082371729760):");
            if (!noHp) return;

            const btn = document.getElementById('btnPairingWA');
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memproses...`;
            btn.disabled = true;

            fetch(`/api/request-pairing?userId=${currentUserId}&phone=${encodeURIComponent(noHp)}`)
                .then(res => res.json())
                .then(data => {
                    alert("Mempersiapkan kode tautan. Silakan tunggu 3-5 detik...");
                    setTimeout(() => {
                        btn.innerHTML = `<i class="fa-solid fa-mobile-screen-button"></i> Pakai Nomor WA`;
                        btn.disabled = false;
                        cekStatusWA();
                    }, 3000);
                });
        }

        function resetWA() {
            if (!confirm('Apakah Anda yakin ingin mereset sesi WhatsApp?')) return;
            fetch(`/api/reset-wa?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    alert(data.message);
                    cekStatusWA();
                });
        }

        setInterval(cekStatusWA, 2000);
        cekStatusWA();

        function bukaModalEditSiswa(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));
            const wa = decodeURIComponent(btn.getAttribute('data-wa'));

            document.getElementById('formEditSiswa').action = `/api/siswa/edit/${id}`;
            document.getElementById('editNamaSiswa').value = nama;
            document.getElementById('editWaSiswa').value = wa;
            document.getElementById('modalEditSiswa').classList.remove('hidden');
        }

        function tutupModalEditSiswa() {
            document.getElementById('modalEditSiswa').classList.add('hidden');
        }

        function hapusSiswa(btn) {
            const id = btn.getAttribute('data-id');
            const nama = decodeURIComponent(btn.getAttribute('data-nama'));

            if (confirm(`Apakah Anda yakin ingin menghapus data siswa "${nama}"?`)) {
                const formHapus = document.getElementById('formHapusSiswa');
                formHapus.action = `/api/siswa/hapus/${id}`;
                formHapus.submit();
            }
        }

        function muatPreview() {
            const bulan = document.getElementById('selectBulan').value;
            const tahun = document.getElementById('selectTahun').value;
            const kelasId = document.getElementById('kelasId').value;
            const previewArea = document.getElementById('previewArea');
            const tbody = document.getElementById('previewTableBody');
            const countTag = document.getElementById('previewCount');

            tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-500 italic"><i class="fa-solid fa-spinner fa-spin mr-1"></i> Memuat data rekapitulasi...</td></tr>`;
            previewArea.classList.remove('hidden');

            fetch(`/api/absensi/preview?bulan=${bulan}&tahun=${tahun}&kelas_id=${kelasId}`)
                .then(res => res.json())
                .then(data => {
                    if (data.success && data.data.length > 0) {
                        countTag.innerText = `${data.data.length} Siswa`;
                        tbody.innerHTML = data.data.map((item, index) => `
                            <tr class="hover:bg-slate-50 border-b border-slate-100">
                                <td class="p-2.5 text-center font-mono">${index + 1}</td>
                                <td class="p-2.5 font-semibold text-slate-900">${item.nama_siswa}</td>
                                <td class="p-2.5 text-slate-600">${item.nama_kelas}</td>
                                <td class="p-2.5 text-center font-bold text-emerald-700 bg-emerald-50/50">${item.total_hadir} Hari</td>
                            </tr>
                        `).join('');
                    } else {
                        countTag.innerText = '0 Siswa';
                        tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-slate-400 italic">Tidak ada data kehadiran pada bulan dan tahun yang dipilih.</td></tr>`;
                    }
                })
                .catch(err => {
                    console.error("Preview error:", err);
                    tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-rose-500 font-medium">Gagal memuat pratinjau data.</td></tr>`;
                });
        }
    </script>

