<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Guru - Presensi Sekolah</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen p-4 md:p-8 flex flex-col justify-between">

    <div>
        <!-- Header Container -->
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 bg-slate-900/80 p-6 rounded-3xl border border-slate-800 backdrop-blur-md shadow-2xl">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 rounded-2xl flex items-center justify-center text-2xl font-bold">
                    <i class="fa-solid fa-chalkboard-user"></i>
                </div>
                <div>
                    <h1 class="text-xl md:text-2xl font-bold text-white"><%= user.nama %></h1>
                    <p class="text-xs text-emerald-400 font-semibold mt-0.5"><%= user.nama_kelas %></p>
                </div>
            </div>
            <div class="flex items-center gap-3 w-full md:w-auto">
                <a href="/scan?userId=<%= userId %>" class="flex-1 md:flex-none justify-center px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-xl text-xs flex items-center gap-2 transition shadow-lg shadow-emerald-600/30">
                    <i class="fa-solid fa-qrcode"></i> Scan QR Presensi
                </a>
                <a href="/" class="px-4 py-2.5 bg-slate-800 hover:bg-rose-600/20 hover:text-rose-400 text-slate-300 rounded-xl text-xs font-semibold transition border border-slate-700/50">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </a>
            </div>
        </div>

        <!-- Main Content Grid -->
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- WhatsApp & Absensi Log -->
            <div class="space-y-6">
                
                <!-- Status WA -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 shadow-xl">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-brands fa-whatsapp text-emerald-400 text-base"></i> Status WhatsApp
                        </h2>
                        <span id="wa-badge" class="text-[10px] font-mono px-2.5 py-1 rounded-full border border-slate-700 bg-slate-800 text-slate-400">
                            <%= statusWA %>
                        </span>
                    </div>

                    <div class="flex flex-col items-center justify-center py-4 bg-slate-950/60 rounded-2xl border border-slate-800/80">
                        <% if (qrCodeWA) { %>
                            <img src="<%= qrCodeWA %>" alt="QR WhatsApp" class="w-44 h-44 rounded-xl shadow-md">
                            <p class="text-[11px] text-amber-400 mt-3 font-semibold text-center px-2">Scan QR Code dengan WhatsApp HP Anda</p>
                        <% } else if (statusWA === 'TERHUBUNG') { %>
                            <div class="w-12 h-12 rounded-full bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-xl mb-2">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                            <p class="text-xs text-emerald-400 font-semibold">WhatsApp Siap Mengirim Notifikasi</p>
                        <% } else { %>
                            <p class="text-xs text-slate-500 mb-4 text-center">Koneksi WhatsApp Belum Aktif</p>
                            <button onclick="startWA()" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-semibold transition shadow-md">
                                Hubungkan WhatsApp
                            </button>
                        <% } %>
                    </div>
                </div>

                <!-- Absensi Log Hari Ini -->
                <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6 shadow-xl">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-sm font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-clock-rotate-left text-sky-400"></i> Hadir Hari Ini
                        </h2>
                        <span class="text-xs text-sky-400 bg-sky-500/10 border border-sky-500/20 px-2.5 py-0.5 rounded-full font-mono">
                            <%= absensiHariIni.length %> Siswa
                        </span>
                    </div>

                    <div class="space-y-2 max-h-[260px] overflow-y-auto pr-1">
                        <% if (absensiHariIni && absensiHariIni.length > 0) { %>
                            <% absensiHariIni.forEach(a => { %>
                                <div class="p-3 bg-slate-950/60 border border-slate-800/80 rounded-2xl flex justify-between items-center">
                                    <span class="font-semibold text-xs text-white"><%= a.nama %></span>
                                    <span class="text-[10px] text-slate-400 font-mono"><%= new Date(a.waktu).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</span>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <p class="text-xs text-slate-500 text-center py-6">Belum ada presensi masuk hari ini.</p>
                        <% } %>
                    </div>
                </div>

            </div>

            <!-- Daftar Siswa Kelolaan -->
            <div class="lg:col-span-2 bg-slate-900/60 border border-slate-800 rounded-3xl p-6 shadow-xl flex flex-col justify-between">
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <div class="flex items-center gap-3">
                            <i class="fa-solid fa-users text-emerald-400 text-lg"></i>
                            <h2 class="text-base font-bold text-white">Daftar Siswa (<%= user.nama_kelas %>)</h2>
                        </div>
                        <span class="text-xs bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 px-3 py-1 rounded-full font-mono">
                            Total: <%= siswaList.length %> Siswa
                        </span>
                    </div>

                    <div class="overflow-x-auto max-h-[440px] overflow-y-auto">
                        <table class="w-full text-left text-xs text-slate-300">
                            <thead class="bg-slate-950/80 text-slate-400 uppercase text-[10px] tracking-wider sticky top-0">
                                <tr>
                                    <th class="p-3.5">ID QR</th>
                                    <th class="p-3.5">Nama Siswa</th>
                                    <th class="p-3.5">Kelas</th>
                                    <th class="p-3.5">No. WA Orang Tua (Tes)</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60">
                                <% if (siswaList && siswaList.length > 0) { %>
                                    <% siswaList.forEach(s => { %>
                                        <tr class="hover:bg-slate-800/40 transition">
                                            <td class="p-3.5 font-mono text-emerald-400 font-bold">#<%= s.id %></td>
                                            <td class="p-3.5 font-semibold text-white"><%= s.nama %></td>
                                            <td class="p-3.5 text-slate-400"><%= s.nama_kelas %></td>
                                            <td class="p-3.5 font-mono text-emerald-400 font-semibold"><%= s.nomor_wa_ortu %></td>
                                        </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="p-6 text-center text-slate-500">Belum ada data siswa di kelas ini.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Developer Footer -->
    <footer class="mt-12 max-w-6xl mx-auto w-full pt-6 border-t border-slate-800/80 text-center text-xs text-slate-400 flex flex-col sm:flex-row justify-between items-center gap-3">
        <div>
            © Presensi SD Negeri 1 Karya Mulya Sari
        </div>
        <div class="flex items-center gap-4 text-[11px]">
            <span>Developer: <strong class="text-slate-200">Zeeo</strong></span>
            <span>•</span>
            <a href="mailto:vektorzero0@gmail.com" class="hover:text-indigo-400 transition"><i class="fa-solid fa-envelope"></i> vektorzero0@gmail.com</a>
            <span>•</span>
            <a href="https://wa.me/6282371729760" target="_blank" class="hover:text-emerald-400 transition"><i class="fa-brands fa-whatsapp"></i> 082371729760</a>
        </div>
    </footer>

    <script>
        async function startWA() {
            await fetch('/api/start-wa?userId=<%= userId %>');
            location.reload();
        }
    </script>
</body>
</html>
