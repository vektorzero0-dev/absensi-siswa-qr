<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Wali Kelas - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans antialiased">

    <!-- Header Resmi -->
    <header class="bg-blue-900 text-white shadow-md border-b-4 border-emerald-500">
        <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-white/10 p-2 rounded-lg border border-white/20">
                    <i class="fa-solid fa-graduation-cap text-2xl text-emerald-400"></i>
                </div>
                <div>
                    <h1 class="text-sm md:text-base font-bold tracking-wide uppercase">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                    <p class="text-[11px] text-blue-200">Panel Tenaga Pendidik / Wali Kelas</p>
                </div>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-3.5 py-2 rounded-xl shadow transition flex items-center gap-1.5">
                    <i class="fa-solid fa-qrcode text-sm"></i> Pemindai Presensi (Scanner)
                </a>
                <a href="/" class="bg-blue-950 hover:bg-blue-800 text-blue-100 text-xs px-3 py-2 rounded-xl border border-blue-700 transition flex items-center gap-1">
                    <i class="fa-solid fa-right-from-bracket"></i> Keluar
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto w-full p-4 md:p-6 flex-1">

        <!-- Banner Profil Guru -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 mb-6 shadow-sm flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-blue-100 text-blue-800 p-3 rounded-xl">
                    <i class="fa-solid fa-user-tie text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200 px-2 py-0.5 rounded uppercase tracking-wider">
                        Rombel: <%= user.nama_kelas %>
                    </span>
                    <h2 class="text-base font-bold text-slate-900 mt-0.5"><%= user.nama %></h2>
                </div>
            </div>
        </div>

        <!-- 🟢 PANEL INTEGRASI WHATSAPP GATEWAY (KODE PAIRING & SCAN QR) -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-100 pb-3 mb-4">
                <div>
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-brands fa-whatsapp text-emerald-600 text-base"></i> Pengaturan Notifikasi WhatsApp Gateway
                    </h3>
                    <p class="text-[11px] text-slate-500 mt-0.5">Hubungkan akun WhatsApp pribadi/sekolah Anda untuk mengirim pesan kehadiran otomatis ke orang tua.</p>
                </div>

                <!-- Badge Status WA -->
                <div id="waBadgeStatus">
                    <% if (statusWA === 'TERHUBUNG') { %>
                        <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs px-3 py-1 rounded-xl font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-check text-emerald-600"></i> Terhubung & Aktif
                        </span>
                    <% } else { %>
                        <span class="bg-amber-50 text-amber-700 border border-amber-200 text-xs px-3 py-1 rounded-xl font-bold flex items-center gap-1.5">
                            <i class="fa-solid fa-circle-exclamation text-amber-600"></i> Belum Terhubung
                        </span>
                    <% } %>
                </div>
            </div>

            <!-- Konten Tautan WA -->
            <div id="waControlPanel">
                <% if (statusWA === 'TERHUBUNG') { %>
                    <div class="bg-emerald-50/50 border border-emerald-200 rounded-xl p-4 flex flex-col sm:flex-row items-center justify-between gap-3">
                        <div class="text-xs text-slate-700">
                            <p class="font-bold text-emerald-900">Layanan Notifikasi Berhasil Terhubung!</p>
                            <p class="text-[11px] text-slate-500 mt-0.5">Setiap presensi siswa di kelas ini akan otomatis mengirim pesan WA ke orang tua.</p>
                        </div>
                        <button onclick="resetWA()" class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold px-4 py-2 rounded-xl transition flex items-center gap-1.5 whitespace-nowrap">
                            <i class="fa-solid fa-power-off"></i> Putuskan Tautan WA
                        </button>
                    </div>
                <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        
                        <!-- Opsi 1: Tautkan Menggunakan Kode Pairing Nomor HP -->
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4">
                            <h4 class="text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <i class="fa-solid fa-mobile-screen-button text-blue-600"></i> Tautkan via Kode Tautan (Nomor HP)
                            </h4>
                            <p class="text-[11px] text-slate-500 mb-3">Masukkan nomor WA Anda untuk menerima 8 digit kode tautan langsung di HP.</p>

                            <div class="flex gap-2 mb-3">
                                <input type="text" id="phoneWaInput" placeholder="Contoh: 082371729760" class="flex-1 bg-white border border-slate-300 rounded-xl px-3 py-2 text-xs font-mono text-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-600">
                                <button onclick="mintaKodePairing()" id="btnPairing" class="bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs px-4 py-2 rounded-xl transition flex items-center gap-1">
                                    <i class="fa-solid fa-key"></i> Minta Kode
                                </button>
                            </div>

                            <!-- Tampilan Kode Tautan 8 Digit -->
                            <div id="boxPairingCode" class="hidden bg-blue-900 text-white rounded-xl p-3 text-center border-2 border-blue-700">
                                <p class="text-[10px] text-blue-200 uppercase tracking-wider font-semibold">Kode Tautan WhatsApp Anda:</p>
                                <div id="displayPairingCode" class="text-xl font-mono font-bold tracking-widest text-amber-400 my-1">
                                    ---- ----
                                </div>
                                <p class="text-[10px] text-blue-200">Buka WA di HP > Perangkat Tertaut > Tautkan dengan nomor telepon saja.</p>
                            </div>
                        </div>

                        <!-- Opsi 2: Pindai Kode QR -->
                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 flex flex-col items-center justify-center text-center">
                            <h4 class="text-xs font-bold text-slate-800 mb-1 flex items-center gap-1.5">
                                <i class="fa-solid fa-qrcode text-emerald-600"></i> Atau Tautkan via QR Code
                            </h4>
                            <p class="text-[11px] text-slate-500 mb-3">Klik tombol di bawah untuk menampilkan Kode QR tautan.</p>

                            <button onclick="mulaiWA()" id="btnStartWA" class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs px-4 py-2 rounded-xl transition flex items-center gap-1.5 mb-3">
                                <i class="fa-solid fa-arrows-rotate"></i> Tampilkan QR Code WA
                            </button>

                            <div id="boxQRCode" class="hidden">
                                <img id="imgQRCodeWA" src="" alt="QR WA" class="w-36 h-36 border border-slate-300 rounded-lg p-1 bg-white shadow-sm mx-auto">
                            </div>
                        </div>

                    </div>
                <% } %>
            </div>
        </div>

        <!-- Tabel Siswa & QR Presensi -->
        <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm mb-6">
            <div class="flex justify-between items-center border-b border-slate-100 pb-3 mb-4">
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-2">
                    <i class="fa-solid fa-users text-blue-600"></i> Daftar Peserta Didik (<%= user.nama_kelas %>)
                </h3>
                <button onclick="window.print()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs px-3.5 py-2 rounded-xl border border-slate-300 font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-print"></i> Cetak Kartu QR Siswa
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-700 border-collapse min-w-[500px]">
                    <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] font-semibold border-b border-slate-200">
                        <tr>
                            <th class="p-3">ID</th>
                            <th class="p-3">Kartu QR</th>
                            <th class="p-3">Nama Lengkap Siswa</th>
                            <th class="p-3">No. WhatsApp Orang Tua</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <% if (siswaList && siswaList.length > 0) { %>
                            <% siswaList.forEach(s => { %>
                                <tr class="hover:bg-slate-50">
                                    <td class="p-3 font-mono font-bold text-emerald-700">#<%= s.id %></td>
                                    <td class="p-3">
                                        <div class="bg-white p-1 rounded-lg inline-block border border-slate-300 shadow-sm">
                                            <img src="<%= s.qrImage %>" alt="QR <%= s.nama %>" class="w-10 h-10">
                                        </div>
                                    </td>
                                    <td class="p-3 font-semibold text-slate-900"><%= s.nama %></td>
                                    <td class="p-3 font-mono text-slate-700">
                                        <i class="fa-brands fa-whatsapp text-emerald-600 mr-1"></i><%= s.nomor_wa_ortu || '-' %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="4" class="p-6 text-center text-slate-400 italic">Belum ada data siswa di rombel ini.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Script Pemanggil Tautan WA -->
    <script>
        const currentUserId = <%= userId %>;
        let timerCekStatus = null;

        function mintaKodePairing() {
            const phone = document.getElementById('phoneWaInput').value.trim();
            if (!phone) return alert("Masukkan nomor WhatsApp terlebih dahulu!");

            const btn = document.getElementById('btnPairing');
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Meminta...`;
            btn.disabled = true;

            fetch(`/api/request-pairing?userId=${currentUserId}&phone=${encodeURIComponent(phone)}`)
                .then(res => res.json())
                .then(data => {
                    btn.innerHTML = `<i class="fa-solid fa-key"></i> Minta Kode`;
                    btn.disabled = false;
                    mulaiCekStatus();
                })
                .catch(err => {
                    alert("Gagal meminta kode tautan.");
                    btn.innerHTML = `<i class="fa-solid fa-key"></i> Minta Kode`;
                    btn.disabled = false;
                });
        }

        function mulaiWA() {
            const btn = document.getElementById('btnStartWA');
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> Memuat QR...`;
            btn.disabled = true;

            fetch(`/api/start-wa?userId=${currentUserId}`)
                .then(res => res.json())
                .then(() => {
                    btn.innerHTML = `<i class="fa-solid fa-arrows-rotate"></i> Tampilkan QR Code WA`;
                    btn.disabled = false;
                    mulaiCekStatus();
                });
        }

        function mulaiCekStatus() {
            if (timerCekStatus) clearInterval(timerCekStatus);

            timerCekStatus = setInterval(() => {
                fetch(`/api/wa-status?userId=${currentUserId}`)
                    .then(res => res.json())
                    .then(data => {
                        if (data.statusWA === 'TERHUBUNG') {
                            clearInterval(timerCekStatus);
                            location.reload();
                        } else if (data.pairingCode) {
                            document.getElementById('boxPairingCode').classList.remove('hidden');
                            document.getElementById('displayPairingCode').innerText = data.pairingCode;
                        } else if (data.qrCodeWA) {
                            document.getElementById('boxQRCode').classList.remove('hidden');
                            document.getElementById('imgQRCodeWA').src = data.qrCodeWA;
                        }
                    });
            }, 3000);
        }

        function resetWA() {
            if (!confirm('Apakah Anda yakin ingin memutuskan tautan WhatsApp?')) return;

            fetch(`/api/reset-wa?userId=${currentUserId}`)
                .then(res => res.json())
                .then(data => {
                    alert(data.message);
                    location.reload();
                });
        }
    </script>

    <footer class="bg-white border-t border-slate-200 py-3 text-center text-[11px] text-slate-600">
        <p>© UPTD SD Negeri 1 Karya Mulya Sari. Seluruh Hak Cipta Dilindungi.</p>
        <p class="mt-0.5 text-slate-400">Pengembang Sistem: <strong class="text-slate-600">Zeeo</strong> | Bantuan Teknis (WhatsApp): <a href="https://wa.me/6282371729760" target="_blank" class="text-blue-700 font-medium hover:underline">0823-7172-9760</a></p>
    </footer>

</body>
</html>
