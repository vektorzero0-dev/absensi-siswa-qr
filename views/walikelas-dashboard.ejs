<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Wali Kelas - SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between p-3 md:p-6 font-sans">

    <div class="max-w-4xl mx-auto w-full">
        <!-- Header TopBar -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-4 shadow-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div>
                <span class="text-[10px] text-emerald-400 font-bold bg-emerald-950/80 border border-emerald-800/80 px-2.5 py-0.5 rounded-md uppercase">
                    <%= user.role %>
                </span>
                <h2 class="text-lg font-bold text-white mt-1">Selamat Datang, <%= user.nama %></h2>
                <p class="text-xs text-slate-400">Wali Kelas: <strong class="text-slate-200"><%= user.nama_kelas %></strong></p>
            </div>
            <div class="flex gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2 border border-emerald-500/30 transition">
                    <i class="fa-solid fa-qrcode text-sm"></i> Buka Scanner Kartu
                </a>
                <a href="/" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3 py-2.5 rounded-xl border border-slate-700 flex items-center">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>

        <!-- Panel Status WhatsApp Gateway -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-4 shadow-xl">
            <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-3">
                <div>
                    <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider flex items-center gap-2">
                        <i class="fa-brands fa-whatsapp text-emerald-400 text-base"></i> Status WA Notification Gateway
                    </h3>
                    <p class="text-[11px] text-slate-400 mt-0.5">WhatsApp otomatis mengirim notifikasi ke ortu saat kartu siswa di-scan.</p>
                </div>
                <button onclick="mulaiKoneksiWA()" class="bg-slate-800 hover:bg-slate-700 text-emerald-400 text-xs px-3.5 py-2 rounded-xl border border-slate-700 font-semibold flex items-center gap-2 self-start sm:self-auto">
                    <i class="fa-solid fa-rotate"></i> Hubungkan / Refresh WA
                </button>
            </div>

            <div class="mt-3 pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-center gap-4">
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-400">Status Koneksi:</span>
                    <% if (statusWA === 'TERHUBUNG') { %>
                        <span class="bg-emerald-950 text-emerald-300 text-xs font-bold px-3 py-1 rounded-full border border-emerald-800/80 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> TERHUBUNG ✅
                        </span>
                    <% } else if (statusWA === 'MENUNGGU_SCAN') { %>
                        <span class="bg-amber-950 text-amber-300 text-xs font-bold px-3 py-1 rounded-full border border-amber-800/80 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span> Menunggu Scan QR WA
                        </span>
                    <% } else { %>
                        <span class="bg-rose-950 text-rose-300 text-xs font-bold px-3 py-1 rounded-full border border-rose-800/80">
                            Belum Terhubung
                        </span>
                    <% } %>
                </div>

                <% if (qrCodeWA) { %>
                    <div class="bg-white p-2 rounded-xl border border-slate-700 text-center">
                        <img src="<%= qrCodeWA %>" alt="QR WhatsApp" class="w-36 h-36 mx-auto">
                        <p class="text-[10px] text-slate-900 font-bold mt-1">Scan QR ini dengan WA HP Anda</p>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Tabel Rekap Presensi Siswa Hari Ini -->
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-clipboard-user text-emerald-400"></i> Presensi Siswa Hari Ini
                </h3>
                <span class="text-xs text-slate-400">Total Hadir: <strong class="text-emerald-400"><%= absensiHariIni.length %></strong> Siswa</span>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-300 min-w-[500px]">
                    <thead class="bg-slate-800 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-3 rounded-l-xl">No</th>
                            <th class="p-3">Nama Siswa</th>
                            <th class="p-3">Kelas</th>
                            <th class="p-3">Waktu Scan</th>
                            <th class="p-3 rounded-r-xl">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        <% if (absensiHariIni && absensiHariIni.length > 0) { %>
                            <% absensiHariIni.forEach((item, index) => { %>
                                <tr class="hover:bg-slate-800/40 transition">
                                    <td class="p-3 font-mono text-slate-500"><%= index + 1 %></td>
                                    <td class="p-3 font-bold text-white"><%= item.nama_siswa %></td>
                                    <td class="p-3"><%= item.nama_kelas %></td>
                                    <td class="p-3 font-mono text-emerald-400 font-semibold"><%= item.waktu_formatted %></td>
                                    <td class="p-3">
                                        <span class="bg-emerald-950 text-emerald-300 text-[10px] font-bold px-2.5 py-1 rounded-lg border border-emerald-800/60 inline-flex items-center gap-1">
                                            <i class="fa-solid fa-check text-[9px]"></i> Hadir
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="p-6 text-center text-slate-500 italic">Belum ada presensi siswa yang terdeteksi hari ini.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Developer Footer -->
    <footer class="text-center py-4 text-[11px] text-slate-500 border-t border-slate-900 mt-6">
        <p>Developer: <strong class="text-slate-300">Zeeo</strong> | <a href="mailto:vektorzero0@gmail.com" class="underline hover:text-slate-300">vektorzero0@gmail.com</a></p>
        <p class="mt-0.5">WhatsApp CS: <a href="https://wa.me/6282371729760" target="_blank" class="text-emerald-400 hover:underline"><i class="fa-brands fa-whatsapp"></i> 082371729760</a></p>
    </footer>

    <script>
        function mulaiKoneksiWA() {
            fetch('/api/start-wa?userId=<%= userId %>')
                .then(res => res.json())
                .then(() => window.location.reload());
        }
    </script>
</body>
</html>
