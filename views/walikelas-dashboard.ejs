<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Wali Kelas - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between p-3 md:p-6 font-sans">

    <div class="max-w-6xl mx-auto w-full">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-4 shadow-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="bg-blue-500/10 border border-blue-500/20 p-2.5 rounded-xl text-blue-400">
                    <i class="fa-solid fa-user-graduate text-xl"></i>
                </div>
                <div>
                    <span class="text-[10px] text-blue-400 font-bold bg-blue-950/80 border border-blue-800/80 px-2.5 py-0.5 rounded-md uppercase tracking-wider">
                        WALI KELAS: <%= user.nama_kelas %>
                    </span>
                    <h1 class="text-base font-bold text-white mt-1">SELAMAT DATANG, <%= user.nama %></h1>
                    <p class="text-xs text-slate-400">UPTD SD NEGERI 1 KARYA MULYA SARI</p>
                </div>
            </div>
            <div class="flex gap-2 w-full sm:w-auto">
                <a href="/scan?userId=<%= userId %>" class="flex-1 sm:flex-none justify-center bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs px-4 py-2.5 rounded-xl shadow-lg flex items-center gap-2 border border-emerald-500/30 transition">
                    <i class="fa-solid fa-qrcode text-sm"></i> Scanner Kartu
                </a>
                <a href="/" class="bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs px-3.5 py-2.5 rounded-xl border border-slate-700 flex items-center justify-center transition">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 mb-6 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="p-3 rounded-xl bg-slate-800 text-slate-300">
                    <i class="fa-brands fa-whatsapp text-2xl <%= statusWA === 'TERHUBUNG' ? 'text-emerald-400' : 'text-amber-400' %>"></i>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-white uppercase tracking-wider">Status WhatsApp Gateway</h2>
                    <p class="text-xs text-slate-400 mt-0.5">
                        Status: 
                        <% if (statusWA === 'TERHUBUNG') { %>
                            <span class="text-emerald-400 font-bold">Terhubung ✅</span>
                        <% } else if (statusWA === 'MENUNGGU_SCAN') { %>
                            <span class="text-amber-400 font-bold">Silakan Scan QR WA di bawah 📲</span>
                        <% } else { %>
                            <span class="text-rose-400 font-bold">Belum Aktif ❌</span>
                        <% } %>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <% if (qrCodeWA && statusWA === 'MENUNGGU_SCAN') { %>
                    <div class="bg-white p-1 rounded-xl shadow-md">
                        <img src="<%= qrCodeWA %>" alt="Scan QR WA" class="w-20 h-20">
                    </div>
                <% } %>
                <button onclick="fetch('/api/start-wa?userId=<%= userId %>').then(() => location.reload())" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-4 py-2.5 rounded-xl border border-slate-700 font-medium transition flex items-center gap-2">
                    <i class="fa-solid fa-arrows-rotate"></i> Hubungkan WA
                </button>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl mb-6">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider mb-3 flex items-center gap-2">
                <i class="fa-solid fa-user-plus text-emerald-400"></i> Input Data Siswa Baru (<%= user.nama_kelas %>)
            </h3>
            
            <% if (!user.kelas_id) { %>
                <div class="bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs p-3 rounded-xl">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i> Akun Anda belum terhubung ke Rombel Kelas. Hubungi Administrator untuk mengatur kelas Anda.
                </div>
            <% } else { %>
                <form action="/api/siswa/tambah" method="POST" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <input type="hidden" name="kelas_id" value="<%= user.kelas_id %>">
                    
                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">Nama Lengkap Siswa</label>
                        <input type="text" name="nama" required placeholder="Contoh: Ahmad Rizky" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500">
                    </div>

                    <div>
                        <label class="block text-[11px] text-slate-400 mb-1">No. WhatsApp Orang Tua</label>
                        <input type="text" name="nomor_wa_ortu" placeholder="Contoh: 082371729760" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-emerald-500">
                    </div>

                    <div class="flex items-end">
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs py-2 rounded-xl transition flex items-center justify-center gap-2">
                            <i class="fa-solid fa-plus"></i> Simpan Siswa
                        </button>
                    </div>
                </form>
            <% } %>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl mb-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-sm font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-users text-blue-400"></i> Daftar Siswa <%= user.nama_kelas %>
                </h2>
                <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs px-3 py-2 rounded-xl border border-slate-700 font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-print"></i> Cetak Kartu QR
                </button>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-300 min-w-[500px]">
                    <thead class="bg-slate-800 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-3 rounded-l-xl">ID Kartu</th>
                            <th class="p-3">QR Code</th>
                            <th class="p-3">Nama Siswa</th>
                            <th class="p-3">No. WA Orang Tua</th>
                            <th class="p-3 rounded-r-xl text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        <% if (siswaList && siswaList.length > 0) { %>
                            <% siswaList.forEach(s => { %>
                                <tr class="hover:bg-slate-800/40">
                                    <td class="p-3 font-mono font-bold text-emerald-400">#<%= s.id %></td>
                                    <td class="p-3">
                                        <div class="bg-white p-1 rounded-lg inline-block border border-slate-700">
                                            <img src="<%= s.qrImage %>" alt="QR <%= s.nama %>" class="w-10 h-10">
                                        </div>
                                    </td>
                                    <td class="p-3 font-bold text-white"><%= s.nama %></td>
                                    <td class="p-3 font-mono text-slate-300">
                                        <i class="fa-brands fa-whatsapp text-emerald-400 mr-1"></i><%= s.nomor_wa_ortu || '-' %>
                                    </td>
                                    <td class="p-3 text-center">
                                        <form action="/api/siswa/hapus/<%= s.id %>" method="POST" onsubmit="return confirm('Hapus data siswa ini?');" class="inline">
                                            <button type="submit" class="text-rose-400 hover:text-rose-300 text-xs">
                                                <i class="fa-solid fa-trash"></i> Hapus
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="p-6 text-center text-slate-500 italic">Belum ada siswa di kelas ini. Silakan tambahkan siswa di atas.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 shadow-xl mb-6">
            <h2 class="text-sm font-bold text-white mb-3 flex items-center gap-2">
                <i class="fa-solid fa-clock-rotate-left text-emerald-400"></i> Absensi Masuk Hari Ini
            </h2>
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-left text-slate-300 min-w-[400px]">
                    <thead class="bg-slate-800 text-slate-400 uppercase text-[10px]">
                        <tr>
                            <th class="p-3 rounded-l-xl">Nama Siswa</th>
                            <th class="p-3">Waktu Scan</th>
                            <th class="p-3 rounded-r-xl">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800">
                        <% if (absensiHariIni && absensiHariIni.length > 0) { %>
                            <% absensiHariIni.forEach(a => { %>
                                <tr class="hover:bg-slate-800/40">
                                    <td class="p-3 font-bold text-white"><%= a.nama_siswa %></td>
                                    <td class="p-3 font-mono text-slate-300"><%= a.waktu_formatted %></td>
                                    <td class="p-3">
                                        <span class="bg-emerald-950 text-emerald-400 border border-emerald-800 text-[10px] font-bold px-2.5 py-0.5 rounded-md">
                                            HADIR
                                        </span>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="p-6 text-center text-slate-500 italic">Belum ada presensi masuk untuk hari ini.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <footer class="text-center py-4 text-[11px] text-slate-500 border-t border-slate-900 mt-6">
        <p>Developer: <strong class="text-slate-300">Zeeo</strong> | <a href="mailto:vektorzero0@gmail.com" class="underline hover:text-slate-300">vektorzero0@gmail.com</a></p>
        <p class="mt-0.5">WhatsApp CS: <a href="https://wa.me/6282371729760" target="_blank" class="text-emerald-400 hover:underline"><i class="fa-brands fa-whatsapp"></i> 082371729760</a></p>
    </footer>

</body>
</html>
