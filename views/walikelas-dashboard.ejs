<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Guru - UPTD SD NEGERI 1 KARYA MULYA SARI</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col justify-between font-sans">

    <div>
        <!-- Navbar Resmi Sekolah -->
        <nav class="bg-blue-900 text-white border-b-4 border-amber-400 sticky top-0 z-50 shadow-md">
            <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-white text-blue-900 rounded-lg flex items-center justify-center font-black text-lg">
                        <i class="fa-solid fa-school"></i>
                    </div>
                    <div>
                        <h1 class="font-bold text-sm tracking-wide leading-tight">UPTD SD NEGERI 1 KARYA MULYA SARI</h1>
                        <p class="text-[11px] text-blue-200">Wali Kelas: <span class="font-semibold text-white"><%= user.nama %></span> (<%= user.nama_kelas %>)</p>
                    </div>
                </div>
                <a href="/" class="text-xs bg-rose-600 hover:bg-rose-700 text-white font-semibold px-3 py-1.5 rounded-lg transition">
                    <i class="fa-solid fa-power-off mr-1"></i> Keluar
                </a>
            </div>
        </nav>

        <div class="max-w-6xl mx-auto px-4 mt-6 space-y-6">

            <!-- Card Utama Scanner Absensi & WA Status -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                
                <!-- Card Buka Scanner -->
                <div class="lg:col-span-2 bg-gradient-to-br from-blue-800 to-blue-950 rounded-2xl p-6 text-white shadow-lg flex flex-col sm:flex-row justify-between items-center gap-4 border border-blue-700">
                    <div>
                        <span class="bg-amber-400 text-blue-950 text-[10px] font-bold px-2.5 py-0.5 rounded-md uppercase tracking-wider">Modul Absensi</span>
                        <h2 class="text-xl font-bold mt-2">Pindai Kartu Presensi Siswa</h2>
                        <p class="text-xs text-blue-200 mt-1">Gunakan kamera HP untuk scan QR Code siswa kelas <%= user.nama_kelas %></p>
                    </div>
                    <a href="/scan?userId=<%= userId %>" class="w-full sm:w-auto text-center bg-amber-400 hover:bg-amber-300 text-blue-950 font-extrabold px-6 py-3 rounded-xl shadow-md transition flex items-center justify-center gap-2">
                        <i class="fa-solid fa-camera text-base"></i>
                        <span>BUKA SCANNER QR</span>
                    </a>
                </div>

                <!-- Card Status WA Engine -->
                <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                                <i class="fa-brands fa-whatsapp text-emerald-600 text-base"></i> Status WA Ortu
                            </span>
                            <span id="wa-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                                Belum Terhubung
                            </span>
                        </div>
                        <p class="text-xs text-slate-500">Hubungkan WA HP Anda untuk mengirim notifikasi absensi ke ortu siswa secara otomatis.</p>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-100 text-center">
                        <button id="btn-qr" onclick="generateQR()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs py-2.5 rounded-xl transition">
                            <i class="fa-solid fa-qrcode mr-1"></i> Tampilkan QR WhatsApp
                        </button>

                        <div id="qr-container" class="mt-3 hidden">
                            <div id="qr-loading" class="py-4 text-slate-500 text-xs">
                                <i class="fa-solid fa-spinner fa-spin text-blue-900 text-lg mb-1"></i>
                                <p>Menyiapkan Socket WA...</p>
                            </div>
                            <img id="qr-img" src="" alt="QR WA" class="w-48 h-48 mx-auto hidden rounded-lg border border-slate-300">
                        </div>
                    </div>
                </div>

            </div>

            <!-- Bagian Rincian Siswa & Log Absensi Hari Ini -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                <!-- Daftar Siswa di Kelas Ini -->
                <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
                    <h3 class="font-bold text-sm text-blue-900 mb-3 flex items-center gap-2 border-b pb-2">
                        <i class="fa-solid fa-graduation-cap text-amber-500"></i> Daftar Siswa Kelas <%= user.nama_kelas %> (<%= siswaList.length %>)
                    </h3>
                    <div class="overflow-y-auto max-h-64 text-xs">
                        <table class="w-full text-left">
                            <thead class="bg-slate-100 text-slate-600 sticky top-0">
                                <tr>
                                    <th class="p-2">ID</th>
                                    <th class="p-2">Nama Siswa</th>
                                    <th class="p-2">No. WA Ortu</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (siswaList.length === 0) { %>
                                    <tr><td colspan="3" class="p-3 text-center text-slate-400">Belum ada data siswa di kelas ini.</td></tr>
                                <% } else { %>
                                    <% siswaList.forEach(s => { %>
                                        <tr class="hover:bg-slate-50">
                                            <td class="p-2 font-mono text-slate-400">#<%= s.id %></td>
                                            <td class="p-2 font-semibold text-slate-800"><%= s.nama %></td>
                                            <td class="p-2 text-emerald-700 font-mono"><%= s.nomor_wa_ortu %></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Log Absensi Masuk Hari Ini -->
                <div class="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm">
                    <h3 class="font-bold text-sm text-blue-900 mb-3 flex items-center gap-2 border-b pb-2">
                        <i class="fa-solid fa-clock-rotate-left text-amber-500"></i> Presensi Masuk Hari Ini (<%= absensiHariIni.length %>)
                    </h3>
                    <div class="overflow-y-auto max-h-64 text-xs">
                        <table class="w-full text-left">
                            <thead class="bg-slate-100 text-slate-600 sticky top-0">
                                <tr>
                                    <th class="p-2">Waktu Masuk</th>
                                    <th class="p-2">Nama Siswa</th>
                                    <th class="p-2">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <% if (absensiHariIni.length === 0) { %>
                                    <tr><td colspan="3" class="p-3 text-center text-slate-400">Belum ada siswa absen masuk hari ini.</td></tr>
                                <% } else { %>
                                    <% absensiHariIni.forEach(a => { %>
                                        <tr class="hover:bg-slate-50">
                                            <td class="p-2 font-mono text-slate-600"><%= new Date(a.waktu).toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }) %> WIB</td>
                                            <td class="p-2 font-semibold text-slate-800"><%= a.nama %></td>
                                            <td class="p-2"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded text-[10px] font-bold">HADIR</span></td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Footer Developer -->
    <footer class="bg-white border-t border-slate-200 py-3 text-slate-600 text-xs mt-8">
        <div class="max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
            <p class="font-medium">Dikembangkan oleh <span class="font-bold text-blue-900">Zeeo</span></p>
            <div class="flex items-center gap-4 text-slate-500">
                <a href="mailto:vektorzero0@gmail.com" class="hover:text-blue-700"><i class="fa-regular fa-envelope text-blue-800 mr-1"></i>vektorzero0@gmail.com</a>
                <span>|</span>
                <a href="https://wa.me/6282371729760" target="_blank" class="hover:text-emerald-600"><i class="fa-brands fa-whatsapp text-emerald-600 mr-1"></i>082371729760</a>
            </div>
        </div>
    </footer>

    <script>
        const userId = "<%= userId %>";
        let pollInterval = null;

        function generateQR() {
            document.getElementById('btn-qr').classList.add('hidden');
            document.getElementById('qr-container').classList.remove('hidden');

            fetch(`/api/start-wa?userId=${userId}`)
                .then(res => res.json())
                .then(() => {
                    checkStatus();
                    pollInterval = setInterval(checkStatus, 2000);
                });
        }

        function checkStatus() {
            fetch(`/api/status-wa?userId=${userId}`)
                .then(res => res.json())
                .then(data => {
                    const badge = document.getElementById('wa-badge');
                    const qrImg = document.getElementById('qr-img');
                    const qrLoading = document.getElementById('qr-loading');

                    if (data.status === 'TERHUBUNG') {
                        badge.className = "px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800";
                        badge.innerText = "Terhubung";
                        document.getElementById('qr-container').innerHTML = `<p class="text-emerald-700 font-bold text-xs py-2"><i class="fa-solid fa-circle-check mr-1"></i> WhatsApp Terhubung!</p>`;
                        clearInterval(pollInterval);
                    } else if (data.qr) {
                        qrLoading.classList.add('hidden');
                        qrImg.classList.remove('hidden');
                        qrImg.src = data.qr;
                    }
                });
        }
    </script>
</body>
</html>
